script"},timeout:2e3,delayNext:!0}]},{id:"RLb1e0e6618020477fbd07d9d55732959a",name:"[CA EN] /destinations/hollywood-studios/star-wars-galaxys-edge/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/en_CA/destinations/hollywood-studios/star-wars-galaxys-edge/",valueIsRegex:!1}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC0503898e492449e0be303f317cad2874-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCb49969105db149bba4bd8e01df18b8f4-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RLb2a7bbfcaddc432d962cfb8da7422f3d",name:"[CA] /tickets/*",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/(en_CA|fr-ca)/tickets/[^?].*",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%consent-allowed-Flashtalking%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC18b76ad1fee845a88a2538d84a39f363-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RLb2acc93b0a6b448a8ddda6c978d31d9d",name:"0-SM-Consent Event Trigger-Library Loaded (Page Top)",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"if (_satellite.getVar
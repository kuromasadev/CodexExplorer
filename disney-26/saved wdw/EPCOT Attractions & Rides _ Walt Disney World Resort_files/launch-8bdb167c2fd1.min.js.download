-2665 .shield:before {\n    content: '\\E0E1';\n    font-family: pepmdx;\n    font-size: 25px;\n    display: inline-block;\n    line-height: 25px;\n    vertical-align: top;\n    margin: 0 12px 0 0;\n}\n.testopt-2665 .shield + b {\n    display: inline-block;\n    vertical-align: top;\n}\n#checkoutExpressPage .testopt-2665 .shield + b {\n    width: 390px;\n}\n.checkoutInsurancePage .stepBody .innerInsuranceBody .checkOpt {\n    margin-left: 20px;\n    margin-top: -14px;\n}\n#insurance .checkOpt {\n    margin-left: 60px;\n}\n.testopt-2665 .checkOpt li {\n    list-style: none;\n}\n.testopt-2665 .checkOpt li .checkmark {\n    float: left;\n    margin: 0 10px 0 0;\n    vertical-align: top;\n    width: 24px;\n}\n#insurance .checkOpt li .checkmark {\n    height: 40px;\n}\n.testopt-2665 .checkOpt li:nth-last-child(2) .checkmark {\n    height: 40px;\n}\n#insurance .checkOpt li:first-child .checkmark,\n#insurance .checkOpt li:nth-last-child(2) .checkmark {\n    height: 75px;\n}\n.testopt-2665 .checkOpt li .checkmark:before {\n    content: '\\e241';\n    font-size: 18px;\n    font-family: 'pepmdx';\n}\n.checkoutInsurancePage #labelDeclined-alt, #labelAdded-alt {\n    display: block;\n    width: 330px;\n}\n.checkoutInsurancePage #labelAdded-alt {\n    margin: 10px 0 0;\n}\n.checkoutInsurancePage .largeRadioGroup .largeRadioOption #labelDeclined-alt {\n    padding-top: 11px;\n}\n.checkoutInsurance #labelAdded,\n.checkoutInsurance #labelDeclined {\n    font-size: 14px;\n}\n.checkoutInsurance .hideDecline #labelAdded div,\n.checkoutInsurancePage .hideDecline #labelAdded div,\n.checkoutInsurancePage .hideDecline #labelAdded-alt div {\n    display: inline;\n}\n#checkoutExpressPage .checkoutInsurance .hideDecline #labelAdded #subLabelAdded,\n#checkoutExpressPage .checkoutInsurance .hideDecline #labelAdded #subLabelAddedPrice {\n    display: inline-block;\n}\n.checkoutInsurance .hideDecline #subLabelAddedPrice { display: block; }\n.checkoutInsurance .hideDecline #labelDeclinedPrice,\n.
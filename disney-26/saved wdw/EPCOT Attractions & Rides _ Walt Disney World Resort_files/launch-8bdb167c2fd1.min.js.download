4f46df",name:"[CA EN] /experience-updates/ & subpages",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/en_CA/experience-updates/?.*",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%consent-allowed-Doubleclick%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC3b0aaaccd28d4989a96c7c00af37680d-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RLa82cc8cd723b470e8738c905a6dfdc58",name:"0-SM-GO4-5683 | ModEx | WDW | Lodging | Trade Exp Checkout | Add Additional Offer Code to Trigger Display of T&C Copy for Specific Special Offer Purchase",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^\\/(en_CA\\/)?reservations\\/dta-packages-std(-ca)?\\/checkout",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"(function (waitFor) {\n    const offerName = 'Disney+ Perks Members: Summer Room Offer';\n\n    const trackingPixels = {\n        entry: { pixel: 'entry', sendOnce: true },\n        impression: { pixel: 'impression' }\n    };\n\n    waitFor({\n        location: [\n            'WDPRO.Analytics.Framework',\n            () => document.querySelector('#termsAndConditions .destinationTerms'),\n            () => document.querySelector('.productHeadingTitle')\n        ],\n        callback: (Framework, terms, productHeadingTitle) => {\n            const containsOfferName = productHeadingTitle.textContent.includes(offerName);\n\n            if (!containsOfferName) return;\n\n            const campaignId = 'MX-5683';\n            const specialProcedureURL = 'https://www.disneytravelagents.com/public-alt/public++offer-terms-for-travel-agencies++offer-terms-for-travel-agencies';\n\n            const sendTracking = ({ pixel: linkID, sendOnce = false, flag = false }) => {\n                const fireTracking = (linkID) => Framework.trackElement('ABTest', { trackingType: 'customLink', linkId: campaignId + '-' + linkID } );\n                const trackingId = campaignId + '_' + (flag || linkID) + '_tracking-sent';\n\n                if (sendOnce) {\n                    if (!sessionStorage.getItem(trackingId)) {\n                        fireTracking(linkID);\n                        sessionStorage.setItem(trackingId, true);\n                    }\n                } else {\n                    fireTracking(linkID);\n                }\n            };\n\n            const inViewObserver = (element, trackObj) => {\n                const intersectionObserver = new IntersectionObserver((entries) => {\n                    if (entries[0].isIntersecting) sendTracking(trackObj);\n                });\n                intersectionObserver.observe(element);\n            };\n\n            const specialProcedureCopy = `\n                <div id=\"${campaignId}-special-procedure-container\" class=\"destinationTerms\" data-campaign-id=\"${campaignId}\">\n                    <style>\n                        #${campaignId}-special-procedure-container.destinationTerms {\n                            font-size: 15px;\n                            font-weight: 700;\n                            margin-top: 20px;\n                            margin-bottom: 0 !important;\n                        }\n                    </style>\n                    Important: You must follow <a class=\"${campaignId}-special-procedure-link\" href=\"${specialProcedureURL}\" target=\"_blank\">special procedures</a> for the Disney+ offer. Reservations in violation may be cancelled.\n                </div>\n            `;\n\n            terms.insertAdjacentHTML('beforebegin', specialProcedureCopy);\n\n            sendTracking(trackingPixels.entry);\n            inViewObserver(document.querySelector(`#${campaignId}-special-procedure-container`), trackingPixels.impression);\n        }\n    });\n})(_satellite.getVar('waitFor'));\n",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLa85fd8565ba14c079155d5b4a650eac7",name:"[CA EN] /destinations/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/en_CA/destinations/"}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{

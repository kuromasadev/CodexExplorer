landing' || pageId === 'dining' || pageId === 'recreation')) {\n                    var loc = window.location.href;\n                    loc.replace(/amenities\\//i, '').replace(/recreation\\//i, '').replace(/dining\\//i, '');\n                    window.location.href = loc + 'rates-rooms/';\n                }\n              setTimeout(function() {\n                $('[name=findRoomButton]').find('span').attr('analyticsLinkid', 'WDW_MediaPlayer_BookNow_FindARoom');\n                $('[name=findRoomButton]').attr('analyticsLinkid', 'WDW_MediaPlayer_BookNow_FindARoom');\n              }, 500);\n            };\n        }\n    });\n}());",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL0237da360cd24bb8803dd4104dc759ef",name:"[CA] /resort-add-ons/*",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/(en_CA|fr-ca)/resort-add-ons/[^?].*",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCc6cd14e8bd564556aa745843d8874745-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCd0e92f1dbbaa440087fb36ca83c12b7f-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL02836d782a97446591deb3a91463c77c",name:"[CA] /resort-add-ons/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/(en_CA|fr-ca)(/resort-add-ons)(\\/?\\?{0}|\\/?\\?{1}.*)$",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney
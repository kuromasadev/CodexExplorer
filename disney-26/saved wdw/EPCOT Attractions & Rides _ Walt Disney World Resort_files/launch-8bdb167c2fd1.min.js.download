source:"/* global _satellite */\n\n_satellite.setVar('getDataLayer', pageKey => Object.assign(getGlobal(), getDL(pageKey) || getDL(reduce(pageKey)) || getDL('default')));\n\nfunction getDL(key) {\n    return {\n        'bab-wdw.site.home'        : {pageId: 'set'      , siteSection: 'tools/mdx/mdv/plan/bands'          },\n        'bab-wdw.site.select-band' : {pageId: 'customize', siteSection: 'tools/mdx/mdv/plan/bands'          },\n        'bab-wdw.site.customize'   : {pageId: 'name'     , siteSection: 'tools/mdx/mdv/plan/bands/customize'},\n        'bab-wdw.site.checkout'    : {pageId: 'review'   , siteSection: 'commerce/merch/bands'              },\n        'bab-wdw.site.confirmation': {pageId: 'confirm'  , siteSection: 'commerce/merch/bands'              },\n        default                    : {pageId: 'notset'   , siteSection: 'notset'                            }\n    }[key];\n}\n\nfunction reduce(str) {\n    return str.includes('.') ? str.substr(0, str.lastIndexOf('.')) : str;\n}\n\nfunction reportSuiteId() {\n    return _satellite.getVar('ENV | Prod') ?\n        'wdgwdprowdw,wdgwdpromerchweb,wdgwdprosec,wdgdsec' :\n        'wdgwdprowdwdev,wdgwdpromerchwebdev,wdgwdprosecdev';\n}\n\nfunction getGlobal() {\n    return {\n        configuration: {\n            SiteCatalyst: {\n                reportSuiteId: reportSuiteId()\n            }\n        },\n        site: 'WDW',\n        store: 'WDWConsumer'\n    };\n}",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL53b401cba2e74294b8269b2e4cd249c0",name:"0-SM-GO4-6973 | Retire legacy Floodlights (advertiser 2789293)",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"['WDPRO','Analytics','Subscriptions'].reduce((o,n,i)=>o[n]||(o[n]=i<2?{}:[]),window).push({\n    topic: 'floodlight.beforefire',\n    handler: (pub) => {\n        // GO4-6973: retire legacy floodlights for advertiser 2789293 only\n        if (String(pub.data.src) === '2789293') pub.data.handled = true;\n    }\n});",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL54659abb8a7141888f6c7e95e341f21e",name:"[CA] /vacation-ideas/*",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/(en_CA|fr-ca)/vacation-ideas/[^?].*",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%consent-allowed-Flashtalking%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC09eec1f8dabe446daaf45e38dbd3719a-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL548f9cc61c564545a098fb6ac2aacf1e",name:"[CA EN] /attractions/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/en_CA/attractions/",valueIsRegex:!1}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCdde5fb3ea1a445f48d3f2e39f34bb081-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL55d6ad038dfc42fabf7850f143270155",name:"[CA EN] /attractions/hollywood-studios/star-wars-rise-of-the-resistance/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/en_CA/attractions/hollywood-studios/star-wars-rise-of-the-resistance/"}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},le
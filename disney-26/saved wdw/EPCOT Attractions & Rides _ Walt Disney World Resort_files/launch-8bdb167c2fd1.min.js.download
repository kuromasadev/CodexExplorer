   modalVisible = false;\n            }\n        });\n        modalObserver.observe(document.body, { childList: true, subtree: true });\n\n        const replaceDinePlanType = (rows) => {\n            if(rows.length > 0) {\n                rows.forEach((row) => {\n                    const header = row.querySelector('td[role=\"rowheader\"]');\n                    header.innerText = mapDinePlanName(header.innerText);\n                });\n            }\n        };\n\n        function mapDinePlanName(name) {\n            if (/quick[\\s-]*service/i.test(name)) {\n                return 'Quick-Service Meals';\n            }\n\n            return 'Table-Service Meal(s)';\n        }\n    }\n});",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL58e3ba6ffcc34c93893b5c5bb1011ffb",name:"0-Studio Metric-GO4-6 - Hybrid Testing",events:[{modulePath:"core/src/lib/events/domReady.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/admission/tickets/",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCb653ddc2c7c94e65a089f7c83e5060e8-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL59e2afa98a0d4ca988534504f9245393",name:"[BR] /checkout/confirmation/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/pt-br/checkout/confirmation/"}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCd114dc24e54e4f93ac8f8156ab11fbdb-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439
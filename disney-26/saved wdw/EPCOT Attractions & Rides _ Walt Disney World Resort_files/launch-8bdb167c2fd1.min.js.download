taLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/es-co/admission/[^?].*",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%consent-allowed-Floodlight%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC6bc92517367a42a99f373f7133100d23-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL17aada71bee9460e929c46fba43b39ee",name:"[CA FR] /attractions/epcot/remys-ratatouille-adventure/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/fr-ca/attractions/epcot/remys-ratatouille-adventure/"}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%consent-allowed-Doubleclick%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCead09b64faed4904aea36cadc23ab980-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL17ed28c0cc5f47368c8aed44bef5bc45",name:"[CA] /destinations/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/(en_CA|fr-ca)(/destinations)(\\/?\\?{0}|\\/?\\?{1}.*)$",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC8d32db5a300440209a1410d176ebd892-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCca813c6fbfdc4ef5b2f27f2193211172-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL19a935d83c6148cca01141db07ee9785",name:"[CA] /plan/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/(en_CA|fr-ca)(/plan)(\\/?\\?{0}|\\/?\\?{1}.*)$",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCd064a070f1054855a8d0b16f1190f4d7-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC5eeaad979a054aa1bc5545673b545073-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL1aec457fb70d401b86947a7ccb9c74aa",name:"Set Hashed Email in Local Storage",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"// Enhanced Conversion | Set Hashed Email in Local Storage\n//\n// REQUIRED Launch rule change: this action MUST run on \"Library Loaded (Page Top)\",\n// NOT \"Consent DOM Ready\". hasCat4Consent() is re-checked at write time, so gating\n// install on Consent DOM Ready buys nothing and misses the profile fetch, which on\n// WDW stage/prod completes 90ms to 1200ms before Consent DOM Ready fires.\n(function() {\n  if (!window.fetch || window.__enhancedConversionWrapped) return;\n\n  var originalFetch = window.fetch;\n\n  // Strict allowlist of profile endpoint suffixes known to return { user: { email } }.\n  // Match is pathname endsWith, not equality, so the entries survive locale-scoped\n  // prefixes the app teams bake in on non-US routes:\n  //   WDW    en_CA -> /en_CA/api/navigation/profile\n  //   DLR    en-ca -> /en-ca/api/navigation/profile\n  //   DLR    es-us -> /es-us/api/navigation/profile\n  //   ...and any future locale segment the app teams add without a heads-up.\n  // Add new entries here rather than loosening isProfileEndpoint, because the\n  // \"no email in response\" branch below clears the stored hash: any sibling\n  // endpoint that ends with these suffixes but does not carry user.email would\n  // clobber a good write.\n  const PROFILE_ENDPOINT_SUFFIXES = [\n\t'/api/navigation/profile', // WDW / DLR / DCL (same-origin; locale-prefixed on non-US)\n\t'/pep/profile'             // WDW UK, WDW EU (cross-origin, api.wdprapps.disney.com)\n  ];\n\n  function hashEmail(email) {\n    var normalized = String(email).trim().toLowerCase();\n    var data = new TextEncoder().encode(normalized);\n    return crypto.subtle.digest('SHA-256', data).then(function(hashBuffer) {\n      return Array.from(new Uint8Array(hashBuffer))\n        .map(function(byte) { return byte.toString(16).padStart(2, '0'); })\n        .join('');\n    });\n  }\n\n  function urlFromInput(input) {\n    if (typeof input === 'string') return input;\n    try {\n      if (typeof Request !== 'undefined' && input instanceof Request) return input.url;\n    } catch (e) {}\n    try {\n      if (input && typeof input.url === 'string') return input.url;\n      if (input && typeof input.href === 'string') return input.href;\n    } catch (e) {}\n    try { return String(input); } catch (e) { return ''; }\n  }\n\n  function pathFromUrl(url) {\n    try { return new URL(url, location.href).pathname; }\n    catch (e) { return ''; }\n  }\n\n  function isProfileEndpoint(path) {\n    var normalized = path.replace(/\\/+$/, '');\n    return PROFILE_ENDPOINT_SUFFIXES.some(suffix => normalized.endsWith(suffix));\n  }\n\n  function hasCat4Consent() {\n    // Read via the same data element the rule's \"Cat 4 Consent Given\" condition\n    // uses (\"%consent-OnetrustActiveGroups variable%\"), not window.OnetrustActiveGroups\n    // directly. That data element applies Disney-specific normalization (e.g. EWCS\n    // mode force-includes C0001 and C0003). Today that normalization does not touch\n    // C0004, but going through the data element keeps this write-time check in lock\n    // step with the trigger-time condition if the normalization ever expands.\n    try {\n      var groups = _satellite.getVar('consent-OnetrustActiveGroups variable');\n      return String(groups || '').indexOf(',C0004,') !== -1;\n    } catch (e) {\n      return false;\n    }\n  }\n\n  function safeRemoveHash() {\n    try { localStorage.removeItem('enhancedConversion'); } catch (e) {}\n  }\n\n  // memoryHash holds the most recent SHA-256 email hash derived from a profile\n  // fetch in this page's lifetime. Only profile responses mutate it:\n  //   1. A 2xx profile response with data.user.email    -> overwrite.\n  //   2. A 2xx profile response with no data.user.email -> null.\n  // Consent transitions do not touch memoryHash.\n  //\n  // localStorage.enhancedConversion is mutated in exactly three places:\n  //   (a) a 2xx profile response with an email, when hasCat4Consent() is true at\n  //       write time -> overwrite with the fresh hash.\n  //   (b) a 2xx profile response with no email -> remove.\n  //   (c) a consent-grant transition -> write memoryHash if it is set and differs\n  //       from the currently stored value.\n  var memoryHash = null;\n  var consentListenerRegistered = false;\n\n  function writeStoredHash(hash) {\n    try {\n      // SECURITY-REVIEW: email is normalized (trim + lowercase) and SHA-256\n      // hashed before storage. C0004 consent is verified by every caller of\n      // writeStoredHash immediately before this line.\n      localStorage.setItem('enhancedConversion', hash);\n      return true;\n    } catch (e) {\n      _satellite.logger.error('Enhanced Conversion | localStorage write failed:', e);\n      return false;\n    }\n  }\n\n  function commitOrDefer(hashedEmail) {\n    memoryHash = hashedEmail;\n    if (hasCat4Consent()) {\n      if (writeStoredHash(hashedEmail)) {\n        _satellite.logger.info('Enhanced Conversion | Email successfully hashed and stored');\n      }\n      return;\n    }\n    _satellite.logger.info('Enhanced Conversion | Consent not yet granted; hash held in memory until OneTrustGroupsUpdated');\n  }\n\n  function onConsentChange() {\n    if (!hasCat4Consent()) {\n      return;\n    }\n    if (memoryHash && getStoredHash() !== memoryHash) {\n      if (writeStoredHash(memoryHash)) {\n        _satellite.logger.info('Enhanced Conversion | Consent granted; in-memory hash written to localStorage');\n      }\n    }\n  }\n\n  function getStoredHash() {\n    try { return localStorage.getItem('enhancedConversion'); } catch (e) { return null; }\n  }\n\n  function ensureConsentListener() {\n    if (consentListenerRegistered) return;\n    consentListenerRegistered = true;\n    // OneTrust dispatches OneTrustGroupsUpdated on the top window every time\n    // consent is resolved or changes (initial load from cookies, banner accept,\n    // preference center save). This covers both \"grant later\" and \"revoke later\".\n    window.addEventListener('OneTrustGroupsUpdated', onConsentChange);\n  }\n\n  var wrapped = function() {\n    var fetchPromise = originalFetch.apply(this, arguments);\n    try {\n      var raw = urlFromInput(arguments[0]);\n      if (raw && isProfileEndpoint(pathFromUrl(raw))) {\n        fetchPromise\n          .then(function(response) {\n            // Only trust 2xx bodies. A 401/403/5xx JSON body (e.g. {\"message\":\"Unauthorized\"})\n            // is not proof the user's email was removed; leaving the stored value alone\n            // avoids clobbering a good write on a transient auth or server hiccup.\n            if (!response.ok) {\n              _satellite.logger.info('Enhanced Conversion | Non-OK profile response (' + response.status + '); stored value left unchanged');\n              return null;\n            }\n            return response.clone().json();\n          })\n          .then(function(data) {\n            if (data === null) return;\n            if (data && data.user && data.user.email) {\n              hashEmail(data.user.email).then(function(hashedEmail) {\n                if (!hashedEmail) return;\n                commitOrDefer(hashedEmail);\n              }).catch(function(error) {\n                _satellite.logger.error('Enhanced Conversion | Error hashing email:', error);\n              });\n            } else {\n              // 200 response, but the profile explicitly has no email. This is a real\n              // \"user has no email on file\" state, independent of consent. Clear both\n              // memoryHash and any stored hash. This is the ONLY place memoryHash is\n              // nulled outside of a fresh overwrite in commitOrDefer.\n              memoryHash = null;\n              safeRemoveHash();\n              _satellite.logger.info('Enhanced Conversion | Email not found in profile response; stored value cleared');\n            }\n          }, function(error) {\n            _satellite.logger.info('Enhanced Conversion | Non-JSON or failed profile response:', error);\n          })\n          .catch(function(error) {\n            _satellite.logger.error('Enhanced Conversion | Handler error:', error);\n          });\n      }\n    } catch (e) {\n      _satellite.logger.error('Enhanced Conversion | Instrumentation threw:', e);\n    }\n    return fetchPromise;\n  };\n\n  window.fetch = wrapped;\n  // Register the consent listener at wrap install so a \"grant later\" transition\n  // can commit memoryHash the moment C0004 flips on, without waiting for the\n  // wrap to see another profile fetch (there may not be one this page life).\n  ensureConsentListener();\n  window.__enhancedConversionWrapped = true;\n})();\n",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL1b3fac4670ce42c58003965089ad9f88",name:"0-SM-Consent OneTrustGroupsUpdated Listener",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"if (_satellite.getVar('consent-ActiveConsentCategories')) {\n  triggerGuestConsentEvent();\n} else if (_satellite.getVar('consent-ewcs')) {\n  waitForEwcsConsent();\n}\n\nwindow.addEventListener('OneTrustGroupsUpdated', triggerGuestConsentEvent);\n\nfunction triggerGuestConsentEvent() {\n  _satellite.track('GuestConsentEvent');\n}\n\nfunction waitForEwcsConsent() {\n  const expiration = Date.now() + _satellite.getVar('consent-ewcsTimeout');\n  const loop = () => {\n    if (Date.now() > expiration) {\n      triggerGuestConsentEvent();\n    } else if (window.OnetrustActiveGroups !== undefined && window.OneTrust) {\n      triggerGuestConsentEvent();\n    } else {\n      setTimeout(loop, 250);\n    }\n  };\n  loop();\n}",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL1d163c4d512b450c99e66f5b878df3c2",name:"[CA] /give-holidays-magic/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/(en_CA|fr-ca)(/give-holidays-magic)(\\/?\\?{0}|\\/?\\?{1}.*)$",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC779f242848f74dd183d50bfd11a33b05-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCc6cf7fe4a78142d3b066a04c11ebd50a-source.min.js",language:"javascript",is
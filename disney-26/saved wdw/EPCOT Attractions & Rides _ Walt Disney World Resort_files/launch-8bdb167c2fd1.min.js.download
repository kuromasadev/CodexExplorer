htOperand:"no"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"var prevPageName = '';\nsetInterval(function() {\n  if (prevPageName != _satellite.getVar('s_pageName')) {\n    prevPageName = _satellite.getVar('s_pageName');\n    if (!(/cart\\/consumer\\/checkoutlink$/.test(prevPageName))) {\n      var myCustomEvent = new CustomEvent('dataLayerReady', {detail:{}});\n      document.querySelector('body').dispatchEvent(myCustomEvent);\n  \t}\n  }\n}, 500);\n\ndocument.addEventListener('DOMContentLoaded', function(event) {\n  var domReadyEvent = new CustomEvent('tmsDomReady', {detail:{}});\n  document.querySelector('body').dispatchEvent(domReadyEvent);\n})\n ",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLf1f90c505d374ee9b3980099c59d4f01",name:"0-Studio Metric-Homepage - Page Bottom",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){return"/"===window.location.pathname}},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"<style>\n#stories-container .story .section-header.center, #stories-container .story .section-header {\n  text-align: left; \n}\n.desktop #CrossPromo .section-header, .desktop #CrossPromo .section-header.center {\n\tpadding-left: 15px;\n}\n.section-header.fadeHide {\n  opacity: 0;\n  transition: opacity 1.25s;\n  -webkit-transition: opacity 1.25s; \n}\n.section-header.headerShow {\n\topacity: 1;\n}\n</style>",language:"html"},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"_satellite.getVar('waitFor')({\n    location: 'WDPRO.Analytics.wdwQuery',\n    callback: function ($) {\n        var $btn = $('button[name=findRoomButton');\n\n        // First we need to unbind any tracking inject by the developers, because ideally we want standard linkid to work\n        $btn.unbind('click');\n        $btn.attr('analyticsLinkId', 'WDW_QQFindPrices_Link');\n\n        //  Now unbind the billboard link tracking from firing once you click on the QQ button, because it breaks link tracking\n        $btn.bind('click', function () {\n            $('body').unbind('showSlide0')\n                .unbind('showSlide1')\n                .unbind('showSlide2')\n                .unbind('showSlide3')\n                .unbind('showSlide4')\n                .unbind('showSlide5')\n                .unbind('showSlide6');\n        });\n    }\n});\n",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLf33776848e5044ac88936a4a4086c68a",name:"/reservations/[AFFILIATE]/checkout/confirmation/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/reservations/.*/checkout/confirmation/$",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC83483b710b8445baa7c72c998cd53fcf-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC7c867d38fdaa4f0590bfe7b8fbf4fcc1-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RLf3bcf64eadc04ac18da40e744455ae8a",name:"0-Studio Metric-Room Rates Tracking - Dumbo Modal - Temporary",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){return!!document.querySelector('meta[name="pageKey"][content*="wdw.site.resorts.resorts.rates-rooms.facility"]')}},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"(function($) {\n  if (!$) return;\n  \n  var pollForElement = function (selector, callback, maxTries, tryNum) {\n    maxTries = maxTries || 0;\n    tryNum = tryNum || 1;\n    var intervalMs = 200,\n      elm = $(selector);\n    if (elm.length > 0) {\n      callback(elm);\n    } else if (tryNum <= maxTries || maxTries === 0) {\n      setTimeout(function () {\n        pollForElement(selector, callback, maxTries, ++tryNum);\n      }, intervalMs);\n    }\n  }\n\n  pollForElement('.fppModalContent:visible', function($el) {\n    var parentModel = WDPRO.Analytics.Framework.getParentModel(),\n      model = {\n        trackingType: 'customPage',\n        store: parentModel.store,\n        storeType: parentModel.storeType,\n        siteSection: 'commerce/addons/{{storeType}}',\n        pageId: 'ticketsmodal'\n      };\n    WDPRO.Analytics.Framework.trackElement('ticketsmodel', model);\n    $('.decline:visible').on('click', function() {\n      s_wdpro.trackClick({},'WDW_TicketAddonModal_NoTickets');\n    });\n    $('.accept:visible').on('click', function() {\n      s_wdpro.trackClick({},'WDW_TicketAddonModal_SelectYourTickets');\n    });\n  });\n}(WDPRO.Analytics.wdwQuery));",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLf661cf576d554760a9fe88a4573f0d9b",name:"0-SM-GO4-7238 | WDW | Discovery Agent | Launch Darkly to Adobe Analytics | Link Calls",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{
source:"(function(waitFor) {\n    const selectorTicketsPasses = 'WDW_Header_Tickets&Passes_DA';\n    const selectorPlacesToStay = 'WDW_Header_PlacesToStay_DA';\n\n    const linkID = {\n        TicketsPasses : {\n            entry: 'WDW_Header_Tickets_Passes_DA_ENTRY',\n            impression: 'WDW_Header_Tickets_Passes_DA_IMPRESSION'\n        },\n        PlacesToStay : {\n            entry: 'WDW_Header_PlacesToStay_DA_ENTRY',\n            impression: 'WDW_Header_PlacesToStay_DA_IMPRESSION'\n        }\n    };\n\n    waitFor({\n        location: () => document.querySelector('[name=\"&lid=' + selectorTicketsPasses + '\"]') || document.querySelector('[name=\"&lid=' + selectorPlacesToStay + '\"]'),\n        callback: () => {\n            const alreadySent = (key) => {\n                try { return !!sessionStorage.getItem(key); } catch (e) { return false; }\n            };\n            const markSent = (key) => {\n                try { sessionStorage.setItem(key, true); } catch (e) { /* storage unavailable */ }\n            };\n            const fireTracking = (trackingLinkId) => {\n                try {\n                    WDPRO.Analytics.Framework.trackElement('ABTest', { trackingType: 'customLink', linkId: trackingLinkId });\n                    return true;\n                } catch (e) {\n                    // Framework not ready. Leave the sendOnce flag unset so a later attach retries.\n                    return false;\n                }\n            };\n            const sendTracking = ({ linkID: trackingLinkId, sendOnce = false }) => {\n                const trackingID = trackingLinkId + '_tracking-sent';\n\n                if (sendOnce) {\n                    if (!alreadySent(trackingID) && fireTracking(trackingLinkId)) markSent(trackingID);\n                } else {\n                    fireTracking(trackingLinkId);\n                }\n            };\n\n            // The Disney tracking anchors are `display: contents` in both the desktop nav and the mobile\n            // overlay (confirmed at runtime), so they generate no box of their own and can never be measured\n            // or seen directly. Walk up to the nearest ancestor that actually occupies space - the list item\n            // that holds the visible link.\n            const findObservableAncestor = (el) => {\n                let cur = el;\n                while (cur && cur !== document.documentElement) {\n                    const rect = cur.getBoundingClientRect();\n                    if (getComputedStyle(cur).display !== 'contents' && (rect.width > 0 || rect.height > 0)) return cur;\n                    cur = cur.parentElement;\n                }\n                // Nothing is laid out yet (a closed flyout is `display: none`). The caller re-resolves on\n                // each check, so returning the anchor just means \"not visible\" until the nav opens.\n                return el;\n            };\n\n            // `visibility: hidden` elements still \"intersect\" per IO spec, so gate on real visibility.\n            const isTrulyVisible = (el) => {\n                if (!el) return false;\n                if (typeof el.checkVisibility === 'function') {\n                    return el.checkVisibility({ checkVisibilityCSS: true, checkOpacity: true, visibilityProperty: true, opacityProperty: true, contentVisibilityAuto: true });\n                }\n                const rect = el.getBoundingClientRect();\n                if (rect.width === 0 || rect.height === 0) return false;\n                let cur = el;\n                while (cur) {\n                    const cs = getComputedStyle(cur);\n                    if (cs.display === 'none' || cs.visibility === 'hidden' || cs.opacity === '0') return false;\n                    cur = cur.parentElement;\n                }\n                return true;\n            };\n\n            const isInViewport = (el) => {\n                const r = el.getBoundingClientRect();\n                return r.width > 0 && r.height > 0 && r.bottom > 0 && r.right > 0 && r.top < innerHeight && r.left < innerWidth;\n            };\n\n            const inViewObserver = (element, trackObj) => {\n                let wasVisible = false;\n                let observed = null;\n\n                // Covers the Guest scrolling the link into view while the nav is already open, which no\n                // interaction would announce. Re-pointed whenever the measured element changes, since at\n                // attach time it is still the unmeasurable anchor.\n                const intersectionObserver = new IntersectionObserver(() => evaluate());\n                const observe = (el) => {\n                    if (el === observed) return;\n                    if (observed) intersectionObserver.unobserve(observed);\n                    intersectionObserver.observe(el);\n                    observed = el;\n                };\n\n                const evaluate = () => {\n                    // Re-resolve each time: at attach the nav is still closed, so nothing has a box yet\n                    // and the walk above has no laid-out ancestor to find.\n                    const measured = findObservableAncestor(element);\n                    observe(measured);\n                    const nowVisible = isTrulyVisible(measured) && isInViewport(measured);\n                    // Edge-triggered: fire only on the hidden -> visible transition so we get one\n                    // impression each time the flyout opens, not once per mutation while it stays open.\n                    if (nowVisible && !wasVisible) sendTracking(trackObj);\n                    wasVisible = nowVisible;\n                    return nowVisible;\n                };\n\n                // Nothing the browser emits marks the moment the nav reveals the link. The\n                // IntersectionObserver stays quiet (the item is hidden, not scrolled away), no ancestor\n                // attribute changes, and the item's own fade finishes while it is still hidden. What we\n                // can rely on is that a reveal only ever follows a Guest interacting with the nav - a tap\n                // on mobile, a hover on desktop - and lands within about a second of it. So re-check\n                // every frame for a second after each interaction, then go quiet again.\n                const hoverRoot = element.closest('.syndicated-navigation') || document.body;\n                let watchUntil = 0;\n                let lastEval = 0;\n                const startWatch = () => {\n                    const alreadyWatching = watchUntil > Date.now();\n                    watchUntil = Date.now() + 1500;\n                    if (alreadyWatching) return;\n                    const tick = (now) => {\n                        // Throttle to ~10x/sec: the reveal lands within a few hundred ms, so a\n                        // per-frame walk is wasted work, especially for unrelated page clicks.\n                        if (now - lastEval >= 100) {\n                            lastEval = now;\n                            // Stop polling once visible, but clear the window so the next interaction\n                            // starts a fresh loop. Leaving it set makes `alreadyWatching` block every\n                            // restart, and a later reopen would never be evaluated.\n                            if (evaluate()) { watchUntil = 0; return; }\n                        }\n                        if (Date.now() < watchUntil) requestAnimationFrame(tick);\n                    };\n                    requestAnimationFrame(tick);\n                };\n                // Capture phase, since the nav's own handlers stop propagation on some taps. Clicks are\n                // watched document-wide because the control that opens the mobile menu is not necessarily\n                // inside the nav; hover stays scoped to the nav so ordinary mouse movement is ignored.\n                document.addEventListener('click', startWatch, true);\n                hoverRoot.addEventListener('mouseover', startWatch, true);\n                hoverRoot.addEventListener('mouseout', startWatch, true);\n\n                // The mobile copy is created by the very tap that should reveal it, so that tap is\n                // already dispatched by the time the listeners above exist. Being attached at all means\n                // the nav just changed, so start watching immediately.\n                startWatch();\n\n                return () => {\n                    intersectionObserver.disconnect();\n                    document.removeEventListener('click', startWatch, true);\n                    hoverRoot.removeEventListener('mouseover', startWatch, true);\n                    hoverRoot.removeEventListener('mouseout', startWatch, true);\n                };\n            };\n\n            const trackedLinks = [\n                { selector: '[name=\"&lid=' + selectorTicketsPasses + '\"]', entry: linkID.TicketsPasses.entry, impression: linkID.TicketsPasses.impression },\n                { selector: '[name=\"&lid=' + selectorPlacesToStay + '\"]', entry: linkID.PlacesToStay.entry, impression: linkID.PlacesToStay.impression }\n            ];\n\n            // Doubles as the \"already observed\" set, keyed by element so re-created nodes are distinct.\n            const teardowns = new WeakMap();\n            // Iterable companion to `teardowns` so we can sweep orphaned nodes; entries are removed\n            // as soon as a node disconnects, so it never pins detached elements in memory.\n            const active = new Set();\n\n            const matchesIn = (root, selector) => {\n                if (!root || root.nodeType !== 1) return [];\n                const self = root.matches(selector) ? [root] : [];\n                return self.concat(Array.from(root.querySelectorAll(selector)));\n            };\n\n            const observeTracked = (root) => {\n                trackedLinks.forEach((link) => {\n                    matchesIn(root, link.selector).forEach((el) => {\n                        if (teardowns.has(el)) return;\n                        sendTracking({ linkID: link.entry, sendOnce: true });\n                        teardowns.set(el, inViewObserver(el, { linkID: link.impression }));\n                        active.add(el);\n                    });\n                });\n            };\n\n            const sweep = () => {\n                active.forEach((el) => {\n                    if (el.isConnected) return;\n                    const teardown = teardowns.get(el);\n                    if (teardown) {\n                        teardown();\n                        teardowns.delete(el);\n                    }\n                    active.delete(el);\n                });\n            };\n\n            observeTracked(document.body);\n\n            // Desktop and mobile each render their own copy of these links. The desktop flyout copy\n            // exists at load but stays hidden on mobile, while the mobile nav builds its copy only\n            // when the Guest opens a section and destroys it on close - a new node identity every\n            // time. The links live in an Angular subtree whose ancestors are `ng-star-inserted`, so the\n            // header can be destroyed and recreated wholesale. Observing the nav itself would leave this\n            // bound to a detached node, so watch `document.body` - the only reliably stable root - and\n            // let `observeTracked` pick up new copies while `sweep` releases the detached ones.\n            new MutationObserver((mutations) => {\n                mutations.forEach((mutation) => {\n                    mutation.addedNodes.forEach((node) => observeTracked(node));\n                });\n                // Sweep every batch so orphaned copies are released even if their removal never\n                // surfaced as a removedNodes record (e.g. a wholesale header re-render).\n                sweep();\n            }).observe(
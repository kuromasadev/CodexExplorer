Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/es-cl/special-offers/[^?].*",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%consent-allowed-Floodlight%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC859c94e25c154dda88e64eb6893075b1-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RLe6926744f8e64b728590aa11e6574c20",name:"0-SM-GO4-5498 | HOTFIX | Dine Remy | WDW | Victoria & Albert's | Update Modal Language",events:[{modulePath:"core/src/lib/events/domReady.js",settings:{},ruleOrder:50},{modulePath:"core/src/lib/events/historyChange.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^(/es-us|/en(-|_)ca|/fr-ca)?/dine-res/((restaurant/(90002336|victoria-and-alberts))|(dining-event/(17736032|victoria-and-alberts-queen-victoria-room)))/?",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC29cfcfdb9733407cb31bc11ed70d9fd5-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RLe6a275d8fcf64e5f90f3dda9ed61be46",name:"0-Studio Metric-Resorts Map Inline Mbox",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"/resorts/map/",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){var e,t=_satellite.readCookie("localeCookie_jar_aka");try{e=JSON.parse(decodeURIComponent(t))}catch(t){e=null}return e&&"string"==typeof e.contentLocale&&/en_us/.test(e.contentLocale.toLowerCase())}},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'_satellite.getVar(\'waitFor\')( {\n    location: \'adobe.target\',\n    callback: function(target) {\n        target.getOffer({\n            "mbox": "WDW_ResortsMap_Inline",\n            "params": {\n                "contentLocale": "us",\n                "contentLanguage": "en"\n            },\n            "success": function(offer) {\n                target.applyOffer({\n                    "mbox": "WDW_ResortsMap_Inline",\n                    "offer": offer\n                });\n            },\n            "error": function(err) { \n                // console.log(err);\n            }\n        });\n    }\n})\n',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLe6d6a5b1c47d4d2b83730c1d03363c25",name:"0-Studio Metric-Cart Inline Mbox",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/customCode.js",settings:{source:function(){return"/cart/"===location.pathname&&"en_us"===PEP.Config.Region.toLowerCase()}},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'_satellite.getVar(\'waitFor\')( {\n    location: \'adobe.target\',\n    callback: function(target) {\n        target.getOffer({\n            "mbox": "WDW_Cart_Inline",\n            "params": {\n                "contentLocale": "us",\n                "contentLanguage": "en"\n            },\n            "success": function(offer) {\n                target.applyOffer({\n                    "mbox": "WDW_Cart_Inline",\n                    "offer": offer\n                });\n            },\n            "error": function(err) { \n                // console.log(err);\n            }\n        });\n    }\n})\n',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLe8c6acc5d41b42208e7473def155cab7",name:"[CA FR] /special-offers/early-2022-room-offer/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/fr-ca/special-offers/early-2022-room-offer/",valueIsRegex:!1}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%consent-allowed-Doubleclick%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RC5f302691fab24569b91f8afae008cfb6-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RLeadaa8e814504fe0bac77752a77d0cb6",name:"0-Studio Metric-Inline Mbox LACD 4 Park Magic Offer Tickets ",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"\\/(?:(es-ar|pt-br|es-cl|es-co|es-mx|es-pe|))\\/admission\\/tickets\\/4-park-magic-offer\\/",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'_satellite.getVar(\'waitFor\')( {\n    location: \'adobe.target\',\n    callback: function(target) {\n\t\t\t\tvar contentParams = window.location.pathname.split(\'/\')[1].split(\'-\'),\n            deviceInfo = WDPRO.isResponsive ? \'mobile:mobile\': \'desktop:desktop\';\n        target.getOffer({\n            "mbox": "WDW_LACD_Inline",\n            "params": {\n                "contentLocale": contentParams[0],\n                "contentLanguage": contentParams[0],\n                "deviceInfo": deviceInfo\n            },\n            "success": function(offer) {\n                target.applyOffer({\n                    "mbox": "WDW_LACD_Inline",\n                    "offer": offer\n                });\n            },\n            "error": function(err) {\n                throw \'target inline offer not applied\';\n            }\n        });\n    }\n});',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLeb29804cc3e34653bf653cbd997d83b2",name:"0-SM-GO4-7395 HOTFIX | Dine Remy | DHLTO - Hide Time Period",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50},{modulePath:"core/src/lib/events/historyChange.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^(/es-us|/en[_-]ca|/fr-ca)?/dine-res/dining-event/(412798290|diamond-horseshoe-lounge)$",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"/*\nSITE: WDW\nPATH: ^(/es-us|/en[_-]ca|/fr-ca)?/dine-res/dining-event/(412798290|diamond-horseshoe-lounge)$\nSITE: WDW UK\nPATH: ^/dine-res/dining-event/(412798290|diamond-horseshoe-lounge)$\nSITE: WDW EU\nPATH: ^/dine-res/dining-event/(412798290|diamond-horseshoe-lounge)$\nEXECUTE: DOM Ready, History Change\n*/\n\nconst { waitFor, pick, evaluated, fixed, observe, onCleanup } =\n\t_satellite.getVar('hotfix')('GO4-7395');\n\nconst novAllowedDates = new Set([8, 9, 12, 13, 15, 17, 19, 20, 24, 25, 27, 29]);\nconst decAllowedDates = new Set([1, 3, 4, 6, 8, 10, 11, 13, 15, 17, 18, 20, 22]);\nconst replacementClass = 'go4-7395-meal-periods';\nconst hiddenClass = 'go4-7395-hidden';\nconst styleId = 'go4-7395-special-style';\n\nconst matchTerms = {\n\tenus: { nov: ['nov', 'november'], dec: ['dec', 'december'], special: ['special'] },\n\tesus: { nov: ['nov', 'noviembre'], dec: ['dic', 'diciembre'], special: ['especial'] },\n\tfrca: { nov: ['nov', 'novembre'], dec: ['dec', 'decembre'], special: ['special'] }\n};\n\n/*\nNo translations yet, default to English for now\n*/\nconst englishCopy = {\n\tallDay: 'All-Day',\n\tspecial: 'Special',\n\tallDayTimes: '(10:30 AM - 6:55 PM)',\n\tspecialTimes: '(7:00 PM - 11:55 PM)'\n};\nconst copyByLocale = {\n\tenus: englishCopy\n\t// esus: { allDay: '', special: '', allDayTimes: '', specialTimes: '' },\n\t// frca: { allDay: '', special: '', allDayTimes: '', specialTimes: '' }\n};\n\nconst termsFor = key => Array.from(\n\tnew Set(Object.values(matchTerms).flatMap(terms => terms[key]))\n).sort((first, second) => second.length - first.length);\nconst novTerms = termsFor('nov');\nconst decTerms = termsFor('dec');\nconst monthTerms = [...novTerms, ...decTerms].join('|');\n// \"nov 8\" / \"dic 3\", and day-first \"8 nov\" / \"8 de nov\"\nconst monthFirstPattern = new RegExp(`\\\\b(${monthTerms})\\\\s+(\\\\d{1,2})\\\\b`);\nconst dayFirstPattern = new RegExp(`\\\\b(\\\\d{1,2})\\\\s+(?:de\\\\s+)?(${monthTerms})\\\\b`);\nconst specialStartPattern = new RegExp(`^(?:${termsFor('special').join('|')})(?:\\\\s|$)`);\n\n\nfunction normalizeText(value) {\n\treturn value.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n\t\t.replace(/[^a-z0-9]+/gi, ' ').trim().toLowerCase();\n}\n\nfunction isSpecialLabel(text) {\n\treturn specialStartPattern.test(normalizeText(text));\n}\n\n// Swap the leading (localized) \"Special\" word for `replacement`, keeping the rest.\nfunction replaceSpecialWord(text, replacement) {\n\treturn isSpecialLabel(text) ? text.replace(/^(\\s*)\\p{L}+/u, `$1${replacement}`) : text;\n}\n\n// Reads { month, day } out of a rendered date string, or null if it has no Nov/Dec date.\nfunction parseDate(rawText) {\n\tconst text = normalizeText(rawText || '');\n\tconst monthFirst = text.match(monthFirstPattern);\n\tconst dayFirst = !monthFirst && text.match(dayFirstPattern);\n\tif (!monthFirst && !dayFirst) return null;\n\n\treturn {\n\t\tmonth: monthFirst ? monthFirst[1] : dayFirst[2],\n\t\tday: Number(monthFirst ? monthFirst[2] : dayFirst[1])\n\t};\n}\n\nfunction isAcceptedDate(rawText) {\n\tconst date = parseDate(rawText);\n\tif (!date) return false;\n\treturn (novTerms.includes(date.month) ? novAllowedDates : decAllowedDates).has(date.day);\n}\n\n/*\nText of the date the guest is looking at, or '' if there isn't one yet.\n\nThe page renders in one of two shapes, and both need the same rules:\n- Date range: a tablist; the selected tab (aria-selected=\"true\") holds the date.\n  Its aria-label matches the visible text, e.g. \"Fri, Nov 7\".\n- Single day: no tabs. The date only appears in the header criteria block, next\n  to the calendar icon, e.g. \"Sat, November 08, 2026\". A range whose start and\n  end are the same day also renders this way. A real range in that header\n  (.calendar-day-range) is ignored, since the selected tab decides in that case.\n*/\nfunction readSelectedDateText(page) {\n\tconst selectedTab = page.querySelector(\n\t\t'.date-range-container [role=\"tab\"][aria-selected=\"true\"]'\n\t);\n\tif (selectedTab) {\n\t\treturn selectedTab.getAttribute('aria-label') || selectedTab.innerText ||\n\t\t\tselectedTab.textContent || '';\n\t}\n\n\tconst icon = page.querySelector('.page-header .criteria .di-calendar-day-view');\n\tconst line = icon?.parentElement;\n\tif (!line || line.querySelector('.calendar-day-range')) return '';\n\t// Only wait for the header to load (it has no digits until a date renders).\n\t// Any date counts, like the tab path; isAcceptedDate decides accepted or not.\n\tconst headerText = line.textContent || '';\n\treturn /\\d/.test(headerText) ? headerText : '';\n}\n\nwaitFor({\n\tlocation: [\n\t\t() => document.querySelector('app-event .page-header .facility-info .name'),\n\t\telement => /\\w/.test(element.innerText || element.textContent || '')\n\t],\n\tcallback: facilityNameElement => {\n\t\tconst page = facilityNameElement.closest('app-event');\n\t\tif (!page) return;\n\t\t// replacement element -> { acceptedDate, signature of the original it was built from }\n\t\tconst replacements = new WeakMap();\n\t\t// textContent, not innerText: it reads the same whether the label is hidden or visible\n\t\tconst labelText = label => normalizeText(label.textContent || '');\n\n\t\tlet style = document.getElementById(styleId);\n\t\tif (!style) {\n\t\t\tstyle = document.createElement('style');\n\t\t\tstyle.id = styleId;\n\t\t\tstyle.setAttribute('data-hotfix', 'GO4-7395');\n\t\t\tstyle.textContent = `app-event .${replacementClass} { display: flex; flex-direction: column; }\n\t\t\t\tapp-event .${replacementClass} > .custom-meal-period-times { display: block; }\n\t\t\t\tapp-event .${hiddenClass} { display: none !important; }`;\n\t\t\tdocument.head.appendChild(style);\n\t\t}\n\n\t\tconst updateSelectors = () => {\n\t\t\tconst facilityName = page.querySelector('.page-header .facility-info .name');\n\t\t\tconst normalizedName = normalizeText(\n\t\t\t\tfacilityName?.innerText || facilityName?.textContent || ''\n\t\t\t).replace(/\\s/g, '');\n\t\t\tconst selectedDateText = readSelectedDateText(page);\n\t\t\tconst shouldReplace = normalizedName.includes('diamondhorseshoe') &&\n\t\t\t\t!!selectedDateText;\n\t\t\tconst acceptedDate = isAcceptedDate(selectedDateText);\n\n\t\t\t// Drop any injected block that is no longer anchored to a hidden, unchanged original\n\t\t\tpage.querySelectorAll(`.${replacementClass}`).forEach(replacement => {\n\t\t\t\tconst original = replacement.previousElementSibling;\n\t\t\t\tconst info = replacements.get(replacement);\n\t\t\t\tconst valid = shouldReplace && info && original &&\n\t\t\t\t\toriginal.classList.contains(hiddenClass) &&\n\t\t\t\t\tinfo.acceptedDate === acceptedDate &&\n\t\t\t\t\tinfo.signature === labelText(original);\n\t\t\t\tif (!valid) {\n\t\t\t\t\tevaluated();\n\t\t\t\t\treplacement.remove();\n\t\t\t\t\tfixed();\n\t\t\t\t}\n\t\t\t});\n\t\t\t// Reveal originals that lost their replacement\n\t\t\tpage.querySelectorAll(`.${hiddenClass}`).forEach(original => {\n\t\t\t\tif (!original.nextElementSibling?.classList.contains(replacementClass)) {\n\t\t\t\t\tevaluated();\n\t\t\t\t\toriginal.classList.remove(hiddenClass);\n\t\t\t\t\tfixed();\n\t\t\t\t}\n\t\t\t});\n\t\t\tif (!shouldReplace) return;\n\n\t\t\tpage.querySelectorAll('.restaurant-selection .custom-meal-period-times')\n\t\t\t\t.forEach(label => {\n\t\t\t\t\tif (label.closest(`.${replacementClass}`)) return;\n\t\t\t\t\tif (label.classList.contains(hiddenClass)) return;\n\t\t\t\t\tconst text = labelText(label);\n\t\t\t\t\tif (!specialStartPattern.test(text)) return;\n\t\t\t\t\tif (!label.closest('dpep-time-selector')) return;\n\n\t\t\t\t\tconst copy = { ...englishCopy, ...pick(copyByLocale, { fallbackValue: englishCopy }) };\n\t\t\t\t\tconst replacement = document.createElement('div');\n\t\t\t\t\treplacement.className = replacementClass;\n\t\t\t\t\tconst originalSpans = label.querySelectorAll('span');\n\t\t\t\t\tif (!acceptedDate) {\n\t\t\t\t\t\tconst row = label.cloneNode(true);\n\t\t\t\t\t\trow.removeAttribute('id');\n\t\t\t\t\t\tconst title = row.querySelector('span');\n\t\t\t\t\t\tif (title) {\n\t\t\t\t\t\t\ttitle.textContent = replaceSpecialWord(title.textContent, copy.allDay);\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\trow.textContent = replaceSpecialWord(row.textContent, copy.allDay);\n\t\t\t\t\t\t}\n\t\t\t\t\t\treplacement.appendChild(row);\n\t\t\t\t\t} else {\n\t\t\t\t\t[\n\t\t\t\t\t\t[copy.allDay, copy.allDayTimes],\n\t\t\t\t\t\t[copy.special, copy.specialTimes]\n\t\t\t\t\t].forEach(([name, range]) => {\n\t\t\t\t\t\tconst row = document.createElement('div');\n\t\t\t\t\t\tArray.from(label.attributes).forEach(attribute => {\n\t\t\t\t\t\t\tif (attribute.name !== 'id') {\n\t\t\t\t\t\t\t\trow.setAttribute(attribute.name, attribute.value);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t});\n\t\t\t\t\t\tconst title = originalSpans[0]?.cloneNode(false) || document.createElement('span');\n\t\t\t\t\t\ttitle.removeAttribute('id');\n\t\t\t\t\t\ttitle.textContent = `${name} `;\n\t\t\t\t\t\tconst times = originalSpans[1]?.cloneNode(false) || title.cloneNode(false);\n\t\t\t\t\t\ttimes.removeAttribute('id');\n\t\t\t\t\t\ttimes.textContent = range;\n\t\t\t\t\t\trow.append(title, times);\n\t\t\t\t\t\treplacement.appendChild(row);\n\t\t\t\t\t});\n\t\t\t\t\t}\n\n\t\t\t\t\tevaluated();\n\t\t\t\t\treplacements.set(replacement, { acceptedDate, signature: text });\n\t\t\t\t\tlabel.classList.add(hiddenClass);\n\t\t\t\t\tlabel.after(replacement);\n\t\t\t\t\tfixed();\n\t\t\t\t});\n\t\t};\n\n\t\tobserve(page, {\n\t\t\tchildList: true,\n\t\t\tsubtree: true,\n\t\t\tcharacterData: true,\n\t\t\tattributes: true,\n\t\t\tattributeFilter: ['aria-selected', 'aria-label'],\n\t\t\tname: 'special-meal-period',\n\t\t\timmediate: true\n\t\t}, updateSelectors);\n\n\t\tonCleanup(() => {\n\t\t\tpage.querySelectorAll(`.${replacementClass}`).forEach(replacement => replacement.remove());\n\t\t\tpage.querySelectorAll(`.${hiddenClass}`).forEach(original => original.classList.remove(hiddenClass));\n\t\t\tstyle.remove();\n\t\t});\n\t}\n});\n",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RLed3bd00ce60a4cfd8252f8cb60c236e7",name:"[AR] /admission/*",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/es-ar/admission/[^?].*",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%consent-allowed-Floodlight%"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"//go4.disney.go.com/adbe/lnch/1b439b897261/2b78861cc894/365009b52bbd/RCcdda3e735c9b42debfb49abb45b2a795-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RLee7c564c73fb4a9285491dab7c0f4ffb",name:"[CA EN] /dining/, /entertainment/, /enchanting-extras-collection/, /events-tours/",events:[{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"Consent dataLayerReady"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/(en_CA)(/dining|/entertainment|/enchanting-extras-collection|/events-tours)(\\/?\\?{0}|\\/?\\?{1}.*)$",valueIsRegex:!0}]},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"isTrue"},leftOperand:"%conse
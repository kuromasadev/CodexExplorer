                                const AFFILIATION_SUB_TYPE = AFFILIATION.subType;
                                const IS_AFFILIATION_OWNED_BY_LOGGED_IN_GUEST = GUEST_IDENTITY_CONTROLLER.isAffiliationOwnedByLoggedInGuest(AFFILIATION);
                                if (IS_AFFILIATION_OWNED_BY_LOGGED_IN_GUEST) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation is owned by the logged in guest. ' + 
                                        'Proceeding to attempt to display the affiliation...');
                                    if (UTILS.isStringAndNotEmpty(AFFILIATION_CATEGORY)) {
                                        if (UTILS.isStringAndNotEmpty(AFFILIATION_TYPE) || UTILS.isStringAndNotEmpty(AFFILIATION_SUB_TYPE)) {
                                            if (AFFILIATION_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE.MILITARY) {
                                                const MILITARY_AFFILIATION_HTML_FRAGMENT = VIEW_AFFILIATIONS
                                                    .processAffiliationTypeMilitary(AFFILIATION, AFFILIATION_TYPE, AFFILIATION_SUB_TYPE, 
                                                        AFFILIATION_TEMPLATE, AFFILIATION_TYPES_ALREADY_DISPLAYED_MAP, CONTENT_MODEL);
                                                const MILITARY_AFFILIATION_MAP_KEY = AFFILIATION_TYPE + AFFILIATION_TYPE_AND_SUBTYPE_MAP_KEY_DELIMITER + 
                                                    AFFILIATION_SUB_TYPE;
                                                if (AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.has(MILITARY_AFFILIATION_MAP_KEY)) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Military affiliation HTML fragment is already displayed. ' +
                                                        'Skipping display of military affiliation...');
                                                } else {

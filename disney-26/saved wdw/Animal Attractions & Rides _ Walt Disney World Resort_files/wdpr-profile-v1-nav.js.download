                                                    }
                                                } else {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation ' + AFFILIATION_CATEGORY + ' - ' + 
                                                        AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' status is not active. ' +
                                                        'Skipping display of Golden Oak affiliation...');
                                                }
                                            } else if (AFFILIATION_CATEGORY === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.CAST || 
                                                AFFILIATION_CATEGORY === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.NON_CAST) {
                                                const MAIN_ENTRANCE_PASS = AFFILIATION_CONSTANTS.AFFILIATION_TYPE.MAIN_ENTRANCE_PASS;
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation category is ' + AFFILIATION_CATEGORY + 
                                                    '. Displaying ' + AFFILIATION_TYPE + ' affiliation as ' + MAIN_ENTRANCE_PASS + 
                                                    ' type affiliation...');
                                                const IS_AFFILIATION_STATUS_ACTIVE = VIEW_AFFILIATIONS.isAffiliationStatusActive(
                                                    AFFILIATION, AFFILIATION_CATEGORY, AFFILIATION_TYPE, AFFILIATION_SUB_TYPE);
                                                if (IS_AFFILIATION_STATUS_ACTIVE) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation ' + AFFILIATION_CATEGORY + ' - ' + 
                                                        AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' status is active. ' +
                                                        'Displaying ' + AFFILIATION_TYPE + ' affiliation as ' + MAIN_ENTRANCE_PASS + 
                                                        ' type affiliation...');
                                                    const MAIN_ENTRANCE_PASS_AFFILIATION_HTML = 
                                                        VIEW_AFFILIATIONS.getMainEntrancePassAffiliationHtml(AFFILIATION, AFFILIATION_TEMPLATE, 
                                                            CONTENT_MODEL);
                                                    if (MAIN_ENTRANCE_PASS_AFFILIATION_HTML) {
                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + 
                                                            ' - ' + AFFILIATION_SUB_TYPE + ' affiliation HTML is available. ' +
                                                            'Displaying ' + AFFILIATION_TYPE + ' affiliation as ' + MAIN_ENTRANCE_PASS + 
                                                            ' type affiliation...');
                                                        const MAIN_ENTRANCE_PASS_AFFILIATION_MAP_KEY = AFFILIATION_CATEGORY;
                                                        AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.set(MAIN_ENTRANCE_PASS_AFFILIATION_MAP_KEY, 
                                                            MAIN_ENTRANCE_PASS_AFFILIATION_HTML);
                                                    } else {
                                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ' + AFFILIATION_TYPE + ' affiliation HTML is not available. ' +
                                                            'Unable to display ' + AFFILIATION_TYPE + ' affiliation as ' + MAIN_ENTRANCE_PASS + 
                                                            ' type affiliation.');
                                                    }
                                                } else {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation ' + AFFILIATION_CATEGORY + ' - ' + 
                                                        AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' status is not active. ' +
                                                        'Skipping display of ' + AFFILIATION_TYPE + ' affiliation as ' + MAIN_ENTRANCE_PASS + 
                                                        ' type affiliation...');
                                                }
                                            }  else if (AFFILIATION_CATEGORY === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.PREMIERE) {
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type is a Club 33. Displaying Club 33 affiliation...');
                                                const WDW_CLUB_33_AFFILIATION_HTML = VIEW_AFFILIATIONS.getWdwClub33AffiliationHtml(
                                                    AFFILIATION, AFFILIATION_TEMPLATE, CONTENT_MODEL);
                                                if (WDW_CLUB_33_AFFILIATION_HTML) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> WDW Club 33 affiliation HTML is available. ' +
                                                        'Displaying WDW Club 33 affiliation...');
                                                    const WDW_CLUB_33_AFFILIATION_MAP_KEY = AFFILIATION_CATEGORY;
                                                    AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.set(WDW_CLUB_33_AFFILIATION_MAP_KEY, WDW_CLUB_33_AFFILIATION_HTML);
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> WDW Club 33 affiliation HTML is not available. ' +
                                                        'Unable to display WDW Club 33 affiliation.');
                                                }
                                            } else if (AFFILIATION_CATEGORY === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.DISNEY_CARD_MEMBER) {
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type is a Disney card member. ' + 
                                                    'Displaying Disney card member affiliation...');
                                                const CONTENT_MODEL_KEY = AFFILIATION_CATEGORY;
                                                const DISNEY_CARD_MEMBER_AFFILIATION_HTML = VIEW_AFFILIATIONS.getAffiliationHtml(
                                                    AFFILIATION, AFFILIATION_TEMPLATE, CONTENT_MODEL, CONTENT_MODEL_KEY);
                                                if (DISNEY_CARD_MEMBER_AFFILIATION_HTML) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Disney card member affiliation HTML is available. ' +
                                                        'Displaying Disney card member affiliation...');
                                                    const DISNEY_CARD_MEMBER_AFFILIATION_MAP_KEY = AFFILIATION_CATEGORY;
                                                    AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.set(DISNEY_CARD_MEMBER_AFFILIATION_MAP_KEY, DISNEY_CARD_MEMBER_AFFILIATION_HTML);
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Disney card member affiliation HTML is not available. ' +
                                                        'Unable to display Disney card member affiliation.');
                                                }
                                            } else if (AFFILIATION_CATEGORY === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.DVC) {
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type is a DVC. Displaying Disney Vacation Club affiliation...');
                                                const DVC_AFFILIATION_HTML = VIEW_AFFILIATIONS.getDisneyVacationClubAffiliationHtml(
                                                    AFFILIATION, AFFILIATION_TEMPLATE, CONTENT_MODEL);
                                                if (DVC_AFFILIATION_HTML) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> DVC affiliation HTML is available. Displaying DVC affiliation...');
                                                    const DVC_AFFILIATION_MAP_KEY = AFFILIATION_CATEGORY;
                                                    AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.set(DVC_AFFILIATION_MAP_KEY, DVC_AFFILIATION_HTML);
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> DVC affiliation HTML is not available. ' +
                                                        'Unable to display DVC affiliation.');
                                                }
                                            } else if (AFFILIATION_CATEGORY === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.ANNUAL_PASS || 
                                                AFFILIATION_CATEGORY === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.ANNUAL) {
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation category is ' + AFFILIATION_CATEGORY + 
                                                    '. Displaying Annual Pass affiliation...');
                                                const IS_AFFILIATION_STATUS_ACTIVE = VIEW_AFFILIATIONS.isAffiliationStatusActive(
                                                    AFFILIATION, AFFILIATION_CATEGORY, AFFILIATION_TYPE, AFFILIATION_SUB_TYPE);
                                                if (IS_AFFILIATION_STATUS_ACTIVE) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation ' + AFFILIATION_CATEGORY + ' - ' + 
                                                        AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' status is active. ' +
                                                        'Displaying Annual Pass affiliation...');
                                                    const ANNUAL_PASS_AFFILIATION_TEMPLATE = VIEW_TEMPLATES.affiliations.AFFILIATION_TEMPLATE;
                                                    const ANNUAL_PASS_AFFILIATION_HTML = VIEW_AFFILIATIONS.getAnnualPassAffiliationHtml(
                                                        AFFILIATION, ANNUAL_PASS_AFFILIATION_TEMPLATE, CONTENT_MODEL);
                                                    if (ANNUAL_PASS_AFFILIATION_HTML) {
                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Annual Pass affiliation HTML is available. ' +
                                                            'Displaying Annual Pass affiliation...');
                                                        const ANNUAL_PASS_AFFILIATION_MAP_KEY = AFFILIATION_CATEGORY + AFFILIATION_TYPE_AND_SUBTYPE_MAP_KEY_DELIMITER + AFFILIATION_TYPE;
                                                        AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.set(ANNUAL_PASS_AFFILIATION_MAP_KEY, ANNUAL_PASS_AFFILIATION_HTML);
                                                        AFFILIATION_CATEGORY_ANNUAL_PASS_MAP.set(ANNUAL_PASS_AFFILIATION_MAP_KEY, ANNUAL_PASS_AFFILIATION_HTML);
                                                    } else {
                                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Annual Pass affiliation HTML is not available. ' +
                                                            'Unable to display Annual Pass affiliation.');
                                                    }
                                                } else {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation ' + AFFILIATION_CATEGORY + ' - ' + 
                                                        AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' status is not active. ' +
                                                        'Skipping display of Annual Pass affiliation...');
                                                }
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type with value -> ' + 
                                                    AFFILIATION_TYPE + ' is not recognized. Unable to display affiliation.');
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not valid. Unable to display affiliation.');
                                        }
                                    } else {
                                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Affiliation category is not available. Unable to display affiliation.');
                                    }
                                } else {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation is NOT owned by the logged in guest. ' + 
                                        'Skipping display of affiliation...');
                                }
                            }
                            if (AFFILIATION_TYPES_HTML_FRAGMENTS_MAP && GUEST_AFFILIATIONS_SORT_ORDER_MAP_KEYS_ARRAY) {
                                if (AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.size > 0 && GUEST_AFFILIATIONS_SORT_ORDER_MAP_KEYS_ARRAY.length > 0) {
                                    GUEST_AFFILIATIONS_SORT_ORDER_MAP_KEYS_ARRAY.forEach((mapKey) => {
                                        if (mapKey === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.ANNUAL_PASS) {
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation category is annual pass. Displaying annual pass affiliation(s)...');
                                            const ANNUAL_PASS_AFFILIATION_MAP_KEYS_ARRAY = AFFILIATION_CATEGORY_ANNUAL_PASS_MAP.keys();
                                            ANNUAL_PASS_AFFILIATION_MAP_KEYS_ARRAY.forEach((annualPassMapKey) => {
                                                if (AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.has(annualPassMapKey)) {
                                                    affiliationsInnerHtml += AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.get(annualPassMapKey);
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Annual pass affiliation with value -> ' + annualPassMapKey + 
                                                        ' is available. Displaying annual pass affiliation...');
                                                }
                                            });
                                        } else if (AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.has(mapKey)) {
                                            affiliationsInnerHtml += AFFILIATION_TYPES_HTML_FRAGMENTS_MAP.get(mapKey);
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type with value -> ' + mapKey + 
                                                ' is available. Displaying affiliation...');
                                        }
                                    });
                                }
                            }
                            const AFFILIATIONS_CONTAINER_HTML = AFFILIATIONS_CONTAINER_TEMPLATE.replace('{affiliationsInnerHtml}', affiliationsInnerHtml);
                            TARGET_DOM_ELEMENT.innerHTML = AFFILIATIONS_CONTAINER_HTML;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliations are processed and displayed successfully! :-)');
                        } catch (error) {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliations display failed.', error);
                        }
                    },
                    processAffiliationTypeMilitary(AFFILIATION, AFFILIATION_TYPE, AFFILIATION_SUB_TYPE, 
                        AFFILIATION_TEMPLATE, AFFILIATION_TYPES_ALREADY_DISPLAYED_MAP, CONTENT_MODEL) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_PROCESS_AFFILIATION_TYPE_MILITARY_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing affiliation type military...');
                        let militaryAffiliationHtml = '';
                        const UTILS = wdprProfileNav.main.utils;
                        const AFFILIATION_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.affiliations;
                        const VIEW_AFFILIATIONS = wdprProfileNav.features.guestIdentity.view.affiliations;
                        if (UTILS.isStringAndNotEmpty(AFFILIATION_SUB_TYPE)) {
                            const AFFILIATION_TYPE_AND_SUB_TYPE_KEY = AFFILIATION_TYPE + '_' + AFFILIATION_SUB_TYPE;
                            if (AFFILIATION_TYPES_ALREADY_DISPLAYED_MAP.has(AFFILIATION_TYPE_AND_SUB_TYPE_KEY)) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Military affiliation type and sub type with value -> ' + 
                                    AFFILIATION_SUB_TYPE + ' is already displayed. Skipping display...');
                            } else {
                                if (AFFILIATION_SUB_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.SERVICE_MEMBER || 
                                    AFFILIATION_SUB_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.RETIREE || 
                                    AFFILIATION_SUB_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.SPOUSE) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation sub type is a valid military sub type ' + 
                                        'with value -> ' + AFFILIATION_SUB_TYPE + '. Displaying military affiliation...');
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type is military. Displaying ' + 
                                        'military affiliation with sub type -> ' + AFFILIATION_SUB_TYPE + '...');
                                    const MILITARY_AFFILIATION_HTML = VIEW_AFFILIATIONS.getMilitaryAffiliationHtml(
                                            AFFILIATION, AFFILIATION_TEMPLATE, CONTENT_MODEL);
                                    if (MILITARY_AFFILIATION_HTML) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Military affiliation HTML is available. ' +
                                            'Displaying military affiliation with sub type -> ' + AFFILIATION_SUB_TYPE + '...');
                                        militaryAffiliationHtml = MILITARY_AFFILIATION_HTML;
                                        AFFILIATION_TYPES_ALREADY_DISPLAYED_MAP.set(AFFILIATION_TYPE_AND_SUB_TYPE_KEY, true);
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Military affiliation HTML is not available. ' + 
                                            'Unable to display military affiliation with sub type -> ' + AFFILIATION_SUB_TYPE + '...');
                                    }
                                } else {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Affiliation sub type with value -> ' + AFFILIATION_SUB_TYPE + 
                                        ' is not a supported military sub type. Unable to display military affiliation.');
                                }
                            }
                        }
                        return militaryAffiliationHtml;
                    },
                    isAffiliationStatusActive(AFFILIATION, AFFILIATION_CATEGORY, AFFILIATION_TYPE, AFFILIATION_SUB_TYPE) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_IS_AFFILIATION_STATUS_ACTIVE_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if affiliation ' + AFFILIATION_CATEGORY + ' - ' + 
                            AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' status is active...');
                        const UTILS = wdprProfileNav.main.utils;
                        const AFFILIATION_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.affiliations;
                        let isAffiliationStatusActive = false;
                        if (UTILS.isStringAndNotEmpty(AFFILIATION.status)) {
                            if (AFFILIATION.status === AFFILIATION_CONSTANTS.AFFILIATION_STATUS_ACTIVE) {
                                isAffiliationStatusActive = true;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation ' + AFFILIATION_CATEGORY + ' - ' + 
                                    AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' status is active. Returning true...');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Affiliation ' + AFFILIATION_CATEGORY + ' - ' + 
                                AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' status is not available. ' +
                                'Assuming affiliation status is not active so returning false...');
                        }
                        return isAffiliationStatusActive;
                    },
                    displayAffiliations: async function(targetDomElementId) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_DISPLAY_AFFILIATIONS_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Displaying affiliations for targetDomElementId -> ' + 
                            targetDomElementId + '...');
                        const UTILS = wdprProfileNav.main.utils;
                        const AFFILIATION_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.affiliations;
                        const VIEW_AFFILIATIONS = wdprProfileNav.features.guestIdentity.view.affiliations;
                        const IS_GUEST_LOGGED_IN = await wdprProfileNav.api.guest.isLoggedIn();
                        if (IS_GUEST_LOGGED_IN === true) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is logged in. Displaying affiliations...');
                            const CONTENT_MODEL = wdprProfileNav.main.model.content;
                            await wdprProfileNav.main.detectProfileContentReady();
                            if (CONTENT_MODEL.isProfileContentReady) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Profile content is ready. Displaying ' +
                                    'affiliations for targetDomElementId -> ' + targetDomElementId + '...');
                                // Display affiliations for targetDomElementId -> targetDomElementId  
                                // 1) Attempt to retrieve the target element.
                                // 2) If the target element is found, append the affiliations to the target element. 
                                // 3) If the target element is not found, gracefully handle the error.
                                // 4) Iterate through the affiliations and append the affiliation template to the target element.
                                // 5) Create a handler method for each affiliation type in order to handle affiliation specific 
                                // logical variations in a graceful and extensible manner.
                                if (UTILS.isStringAndNotEmpty(targetDomElementId)) {
                                    const TARGET_DOM_ELEMENT = document.getElementById(targetDomElementId);
                                    if (TARGET_DOM_ELEMENT) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Target DOM element is detected. Displaying affiliations...');
                                        const AFFILIATIONS_CONTAINER_TEMPLATE = 
                                            wdprProfileNav.features.guestIdentity.constants.viewTemplates.affiliations.AFFILIATIONS_CONTAINER_TEMPLATE;
                                        const AFFILIATION_TEMPLATE = 
                                            wdprProfileNav.features.guestIdentity.constants.viewTemplates.affiliations.AFFILIATION_TEMPLATE;
                                        if (AFFILIATIONS_CONTAINER_TEMPLATE && AFFILIATION_TEMPLATE) {
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliations container template and affiliation template are ' + 
                                                'detected. Proceeding to display affiliations...');
                                            const GUEST_PROFILE = await wdprProfileNav.api.guest.getGuestProfile();
                                            if (GUEST_PROFILE) {
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest profile is detected. Displaying affiliations...');
                                                const AFFILIATIONS = GUEST_PROFILE.affiliationInfo.affiliations;
                                                if (AFFILIATIONS) {
                                                    VIEW_AFFILIATIONS.processAffiliationCategoriesAndTypes(targetDomElementId, TARGET_DOM_ELEMENT,
                                                        AFFILIATIONS, AFFILIATION_TEMPLATE, AFFILIATIONS_CONTAINER_TEMPLATE, CONTENT_MODEL);
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliations are not detected. Unable to display affiliations.');
                                                }
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliations container template or affiliation template is not detected. ' +
                                                'Unable to display affiliations.');
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Target DOM element is not detected. Unable to display affiliations.');
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Target DOM element ID parameter is not valid. Unable to display affiliations.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Profile content is not ready. :-(');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest is not logged in. Unable to display ' +
                                'affiliations for targetDomElementId -> ' + targetDomElementId + '...');
                        }
                    },
                    getAffiliationId: function(affiliation, AFFILIATION_ID_TYPE) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_GET_AFFILIATION_CASTAWAY_CLUB_ID_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting affiliation ' + AFFILIATION_ID_TYPE + ' ID...');
                        const UTILS = wdprProfileNav.main.utils;
                        let affiliationId = null;
                        if (affiliation.affiliationIds) {
                            if (Array.isArray(affiliation.affiliationIds)) {
                                for (const AFFILIATION_ID of affiliation.affiliationIds) {
                                    if (UTILS.isStringAndNotEmpty(AFFILIATION_ID.type)) {
                                        if (AFFILIATION_ID.type === AFFILIATION_ID_TYPE) {
                                            if (UTILS.isStringAndNotEmpty(AFFILIATION_ID.id)) {
                                                affiliationId = AFFILIATION_ID.id;
                                                break;
                                            }
                                        }
                                    } else {
                                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Affiliation ID type is not available. ' +
                                            'Unable to get affiliation ' + AFFILIATION_ID_TYPE + ' ID.');
                                    }
                                }
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Affiliation affiliationIds data is not available. ' +
                                'Unable to get affiliation ' + AFFILIATION_ID_TYPE + ' ID.');
                        }
                        if (UTILS.isStringAndNotEmpty(affiliationId)) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation ' + AFFILIATION_ID_TYPE + ' ID is -> ' + 
                                affiliationId);
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Affiliation ' + AFFILIATION_ID_TYPE + 
                                ' ID is not available. Unable to get affiliation ' + AFFILIATION_ID_TYPE + 
                                ' ID so setting to ' + AFFILIATION_ID_TYPE.CASTAWAY_CLUB_ID_NOT_AVAILABLE + '.');
                                affiliationId = AFFILIATION_ID_TYPE.CASTAWAY_CLUB_ID_NOT_AVAILABLE;
                        }
                        return affiliationId;
                    },
                    getAffiliationHtml: function(affiliation, affiliationTemplate, contentModel, CONTENT_MODEL_KEY) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_GET_AFFILIATION_HTML_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting affiliation HTML...');
                        const UTILS = wdprProfileNav.main.utils;
                        let affiliationHtml = null;
                        const AFFILIATION_CATEGORY = affiliation.category;
                        const AFFILIATION_TYPE = affiliation.type;
                        const AFFILIATION_SUBTYPE = affiliation.subType;
                        if (contentModel) {
                            if (UTILS.isStringAndNotEmpty(AFFILIATION_CATEGORY)) {
                                if (UTILS.isStringAndNotEmpty(AFFILIATION_TYPE)) {
                                    if (contentModel.profile) {
                                        if (contentModel.profile.memberships) {
                                            if (contentModel.profile.memberships[CONTENT_MODEL_KEY]) {
                                                const CONTENT_MEMBERSHIP_FOR_AFFILIATION = 
                                                    contentModel.profile.memberships[CONTENT_MODEL_KEY];
                                                if (CONTENT_MEMBERSHIP_FOR_AFFILIATION) {
                                                    let affiliationIconClass = '';
                                                    let affiliationName = '';
                                                    let affiliationDetail = '';
                                                    let affiliationDetail2 = '';
                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION.icon) {
                                                        affiliationIconClass = CONTENT_MEMBERSHIP_FOR_AFFILIATION.icon;
                                                    }
                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION.label) {
                                                        affiliationName = CONTENT_MEMBERSHIP_FOR_AFFILIATION.label;
                                                    }
                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION.detail) {
                                                        affiliationDetail = CONTENT_MEMBERSHIP_FOR_AFFILIATION.detail;
                                                    }
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content membership for affiliation type is -> ' + 
                                                        CONTENT_MODEL_KEY + '. Displaying affiliation...');
                                                    const AFFILIATION_HTML = affiliationTemplate
                                                        .replaceAll('{affiliationIconClass}', affiliationIconClass)
                                                        .replaceAll('{affiliationCategory}', AFFILIATION_CATEGORY.toLowerCase())
                                                        .replaceAll('{affiliationType}', AFFILIATION_TYPE.toLowerCase())
                                                        .replaceAll('{affiliationName}', affiliationName)
                                                        .replaceAll('{affiliationDetail}', affiliationDetail)
                                                        .replaceAll('{affiliationDetail2}', affiliationDetail2);
                                                    affiliationHtml = AFFILIATION_HTML;
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content membership for affiliation type is ' +
                                                        'not available. Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                                        AFFILIATION_SUBTYPE + ' affiliation.');
                                                }
                                            } else {

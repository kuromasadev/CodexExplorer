                    idMeLauncherButtonClickedEventEmitter: function(EVENT) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'FEATURE_GUEST_IDENTITY_EVENT_EMITTER_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button clicked event emitter is triggered...');
                        const GUEST_IDENTITY_EVENT_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.events;
                        const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                        const ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT_NAME = 
                            GUEST_IDENTITY_EVENT_CONSTANTS.ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT_NAME;
                        const ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_FLORIDA_RESIDENCY_VERIFICATION_EVENT_NAME = 
                            GUEST_IDENTITY_EVENT_CONSTANTS.ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_FLORIDA_RESIDENCY_VERIFICATION_EVENT_NAME;
                        const ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_MILITARY_VERIFICATION_EVENT_NAME = 
                            GUEST_IDENTITY_EVENT_CONSTANTS.ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_MILITARY_VERIFICATION_EVENT_NAME;
                        const ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT = EVENT.idMeLauncherButtonDomElement;
                        const ID_ME_LAUNCHER_BUTTON_CONFIG = EVENT.idMeLauncherButtonConfig;
                        const FLORIDA_RESIDENT_DATA_SCOPE = wdprProfileNav.api.guest.identityVerification.getDataScopeForFloridaResidentVerification();
                        const MILITARY_DATA_SCOPE = wdprProfileNav.api.guest.identityVerification.getDataScopeForMilitaryVerification();
                        GUEST_IDENTITY_MODEL.idMeLauncherButtonClickedEventDetected = true;
                        const ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT = new Event(ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT_NAME);
                        ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT.idMeLauncherButtonDomElement = ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT;
                        ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT.idMeLauncherButtonConfig = ID_ME_LAUNCHER_BUTTON_CONFIG;
                        wdprProfileNav.main.utils.dispatchEvent(ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT, ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT_NAME);
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button clicked event detected. ' +
                            'The ID.me launcher button dom element id is -> ' + ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT.getAttribute('id'));
                        if (ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Event idMeLauncherButtonDomElement is available. ' +
                                'The ID.me launcher button dom element id is -> ' + ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT.getAttribute('id'));
                            if (ID_ME_LAUNCHER_BUTTON_CONFIG) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button idMeLauncherButtonConfig property is detected. ' +
                                    'Proceeding to get the ID.me launcher button configuration...');
                                if (ID_ME_LAUNCHER_BUTTON_CONFIG.dataScope === FLORIDA_RESIDENT_DATA_SCOPE) {
                                    GUEST_IDENTITY_MODEL.idMeLauncherButtonClickedEventForFloridaResidencyVerificationDetected = true;
                                    const ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_FLORIDA_RESIDENCY_VERIFICATION_EVENT = 
                                        new Event(ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_FLORIDA_RESIDENCY_VERIFICATION_EVENT_NAME);
                                    ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_FLORIDA_RESIDENCY_VERIFICATION_EVENT.idMeLauncherButtonDomElement = ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT;
                                    ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_FLORIDA_RESIDENCY_VERIFICATION_EVENT.idMeLauncherButtonConfig = ID_ME_LAUNCHER_BUTTON_CONFIG;
                                    wdprProfileNav.main.utils.dispatchEvent(ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_FLORIDA_RESIDENCY_VERIFICATION_EVENT, 
                                        ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_FLORIDA_RESIDENCY_VERIFICATION_EVENT_NAME);
                                } else if (ID_ME_LAUNCHER_BUTTON_CONFIG.dataScope === MILITARY_DATA_SCOPE) {
                                    GUEST_IDENTITY_MODEL.idMeLauncherButtonClickedEventForMilitaryVerificationDetected = true;
                                    const ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_MILITARY_VERIFICATION_EVENT = 
                                        new Event(ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_MILITARY_VERIFICATION_EVENT_NAME);
                                    ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_MILITARY_VERIFICATION_EVENT.idMeLauncherButtonDomElement = ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT;
                                    ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_MILITARY_VERIFICATION_EVENT.idMeLauncherButtonConfig = ID_ME_LAUNCHER_BUTTON_CONFIG;
                                    wdprProfileNav.main.utils.dispatchEvent(ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_MILITARY_VERIFICATION_EVENT, 
                                        ID_ME_LAUNCHER_BUTTON_CLICKED_FOR_MILITARY_VERIFICATION_EVENT_NAME);
                                    GUEST_IDENTITY_MODEL.idMeLauncherButtonClickedEventForMilitaryVerificationDetected = true;
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button configuration attribute is not detected in the event target.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Event target is not available.');
                        }
                    },
                    newAffiliationTypeCreatedEventEmitter: async function() {

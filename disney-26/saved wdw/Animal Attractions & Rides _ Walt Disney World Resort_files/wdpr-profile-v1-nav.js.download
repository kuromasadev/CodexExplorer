                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model is not available. Unable to display ' + 
                                AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' affiliation.');
                        }
                        return affiliationHtml;

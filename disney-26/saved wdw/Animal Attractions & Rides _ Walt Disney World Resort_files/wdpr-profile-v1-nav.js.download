                    return isIdMeButtonIdValid;
                },
                isIdMeButtonTypeCodeValid: function(buttonTypeCode) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_IS_ID_ME_BUTTON_TYPE_CODE_VALID_';
                    let isIdMeButtonTypeCodeValid = false;
                    const UTILS = wdprProfileNav.main.utils;
                    const ID_ME_BUTTON_TYPES_ARRAY = wdprProfileNav.features.guestIdentity.constants.idMe.ID_ME_BUTTON_TYPES_ARRAY;
                    if (UTILS.isStringAndNotEmpty(buttonTypeCode)) {
                        for (const ID_ME_BUTTON_TYPE of ID_ME_BUTTON_TYPES_ARRAY) {
                            if (ID_ME_BUTTON_TYPE.buttonTypeCode === buttonTypeCode) {
                                isIdMeButtonTypeCodeValid = true;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Button type code -> \"' + buttonTypeCode + 
                                    '\" is a valid value.');
                                break;
                            }
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Button type code is not a valid string.');
                    }
                    return isIdMeButtonTypeCodeValid;
                },
                isCreateIdMeLauncherButtonParametersValid: function(buttonId, dataScope, buttonTypeCode) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'API_IS_CREATE_ID_ME_LAUNCHER_BUTTON_PARAMETERS_VALID_';
                    let isParametersValid = false;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the create ID.me launcher button parameters are valid...');
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    if (GUEST_IDENTITY_CONTROLLER.isIdMeDataScopeValid(dataScope)) {
                        if (GUEST_IDENTITY_CONTROLLER.isIdMeButtonIdValid(buttonId)) {
                            if (GUEST_IDENTITY_CONTROLLER.isIdMeButtonTypeCodeValid(buttonTypeCode)) {
                                isParametersValid = true;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> All parameters are valid with buttonId -> ' + buttonId + ' and dataScope -> ' +
                                    dataScope + ' and buttonTypeCode -> ' + buttonTypeCode + '...');
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> buttonTypeCode is not valid.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> buttonId is not valid.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> dataScope is not valid.');
                    }
                    return isParametersValid;
                },
                attachIdMeLauncherButtonClickedEventListener: function(launcherButtonDomElement) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_ATTACH_ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT_LISTENER_';
                    if (launcherButtonDomElement) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button element is detected.' + 
                            'Proceeding to attach the click event listener...');
                        const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                        const idMeLauncherButtonClickedEventListener = 
                            GUEST_IDENTITY_CONTROLLER.eventListeners.idMeLauncherButtonClickedEventListener;
                        launcherButtonDomElement.addEventListener('click', idMeLauncherButtonClickedEventListener);
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully attached click event listener to ID.me ' +
                            'launcher button element with id -> ' + launcherButtonDomElement.getAttribute('id'));
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button element is not detected. ' +
                            'Cannot attach the click event listener.');
                    }
                },
                detachIdMeLauncherButtonClickedEventListener: function(launcherButtonDomElement) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_DETACH_ID_ME_LAUNCHER_BUTTON_CLICKED_EVENT_LISTENER_';
                    if (launcherButtonDomElement) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button element is detected. ' +
                            'Proceeding to detach the click event listener...');
                        const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                        const idMeLauncherButtonClickedEventListener = 
                            GUEST_IDENTITY_CONTROLLER.eventListeners.idMeLauncherButtonClickedEventListener;
                        launcherButtonDomElement.removeEventListener('click', idMeLauncherButtonClickedEventListener);
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully detached click event listener from ID.me ' +
                            'launcher button element with buttonId -> ' + buttonId);
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button element is not detected. ' +
                            'Cannot detach the click event listener.');
                    }
                },
                getButtonTypeByButtonTypeCode: function(buttonTypeCode) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_GET_BUTTON_TYPE_BY_BUTTON_TYPE_CODE_';
                    const UTILS = wdprProfileNav.main.utils;
                    const ID_ME_BUTTON_TYPES_ARRAY = wdprProfileNav.features.guestIdentity.constants.idMe.ID_ME_BUTTON_TYPES_ARRAY;
                    let buttonType = null;
                    if (UTILS.isStringAndNotEmpty(buttonTypeCode)) {
                        for (const ID_ME_BUTTON_TYPE of ID_ME_BUTTON_TYPES_ARRAY) {
                            if (ID_ME_BUTTON_TYPE.buttonTypeCode === buttonTypeCode) {
                                buttonType = structuredClone(ID_ME_BUTTON_TYPE);
                                break;
                            }
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Button type code is not a valid value.');
                    }
                    return buttonType;
                },
                getVerifiedBadgeByVerifiedBadgeCode: function(verifiedBadgeCode) {

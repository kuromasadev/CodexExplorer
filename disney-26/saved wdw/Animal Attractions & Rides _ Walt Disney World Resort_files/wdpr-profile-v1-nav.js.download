                openIdMePopupWindow: async function(ID_ME_LAUNCHER_BUTTON_CONFIG) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_OPEN_ID_ME_POPUP_WINDOW_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Opening ID.me popup window...');
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    const UTILS = wdprProfileNav.main.utils;
                    const ID_ME_POPUP_WINDOW_CONFIG = 
                        wdprProfileNav.features.guestIdentity.constants.idMe.ID_ME_POPUP_WINDOW_CONFIG;
                    const ID_ME_POPUP_WINDOW_NAME = 
                        ID_ME_POPUP_WINDOW_CONFIG.ID_ME_POPUP_WINDOW_NAME;
                    const ID_ME_POPUP_FEATURES = 
                        ID_ME_POPUP_WINDOW_CONFIG.ID_ME_POPUP_FEATURES;
                    const ID_ME_POPUP_WINDOW_URL = 
                        await GUEST_IDENTITY_CONTROLLER.getIdMePopupWindowUrl(ID_ME_LAUNCHER_BUTTON_CONFIG);
                    if (UTILS.isStringAndNotEmpty(ID_ME_POPUP_WINDOW_URL)) {
                        const ID_ME_POPUP_WINDOW = window.open(ID_ME_POPUP_WINDOW_URL, ID_ME_POPUP_WINDOW_NAME, ID_ME_POPUP_FEATURES);
                        if (ID_ME_POPUP_WINDOW) {
                            wdprProfileNav.features.guestIdentity.model.idMePopupWindow = ID_ME_POPUP_WINDOW;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me popup window opened successfully.');
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me popup window was blocked or could not be opened.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me popup window URL is not valid. Cannot proceed ' +
                            'to open the ID.me popup window.');
                    }
                },
                processIdentityVerificationCallback: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_PROCESS_IDENTITY_VERIFICATION_CALLBACK_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing identity verification callback...');
                    const UTILS = wdprProfileNav.main.utils;
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    const GUEST_IDENTITY_CONSTANTS = wdprProfileNav.features.guestIdentity.constants;
                    const CODE_PARAM = UTILS.getQueryParamValueByName('code');
                    if (!UTILS.isStringAndNotEmpty(CODE_PARAM)) {
                        throw new Error('Code parameter is not available. Cannot proceed to process the identity verification callback.');
                    }
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Code parameter is available. Proceeding to process the identity verification callback...');
                    const PKCE_CODE_PAIR = await GUEST_IDENTITY_CONTROLLER.retrievePkceCodePair();
                    if (!PKCE_CODE_PAIR) {
                        throw new Error('PKCE code pair is not available. Cannot proceed to process the identity verification callback.');
                    }
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> PKCE code pair is available. Proceeding to process the identity verification callback...');
                    const CODE_VERIFIER = PKCE_CODE_PAIR.codeVerifier;
                    const GUEST_PROFILE = await wdprProfileNav.api.guest.getGuestProfile();
                    if (!GUEST_PROFILE) {
                        throw new Error('Guest profile is not available. Cannot proceed to process the identity verification callback.');
                    }
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest profile is available. Proceeding to process the identity verification callback...');
                    const GUEST_SWID = GUEST_PROFILE.swid;
                    if (!UTILS.isStringAndNotEmpty(GUEST_SWID)) {
                        throw new Error('Guest SWID is not available. Cannot proceed to process the identity verification callback.');
                    }
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest SWID is available. Proceeding to process the identity verification callback...');
                    const GUEST_AUTHORIZATION_TOKEN = GUEST_PROFILE.accessToken;
                    if (!UTILS.isStringAndNotEmpty(GUEST_AUTHORIZATION_TOKEN)) {
                        throw new Error('Guest access token is not available. Cannot proceed to process the identity verification callback.');
                    }
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest authorization token is available. Proceeding to process the identity ' +
                        'verification callback...');
                    const IDENTITY_VERIFICATION_CALLBACK_ENDPOINT_PATH =
                        GUEST_IDENTITY_CONSTANTS.identityVerificationCallback.IDENTITY_VERIFICATION_CALLBACK_ENDPOINT_PATH;
                    const IDENTITY_VERIFICATION_CALLBACK_ENDPOINT_URL = IDENTITY_VERIFICATION_CALLBACK_ENDPOINT_PATH.replace('{swid}', GUEST_SWID);
                    let response;
                    try {
                        response = await fetch(IDENTITY_VERIFICATION_CALLBACK_ENDPOINT_URL, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': 'Bearer ' + GUEST_AUTHORIZATION_TOKEN,
                            },
                            body: JSON.stringify({
                                code: CODE_PARAM,
                                codeVerifier: CODE_VERIFIER,
                            }),
                        });
                    } catch (error) {
                        throw new Error('Error processing identity verification callback: ' + error);
                    }
                    if (!response.ok) {
                        throw new Error('Identity verification callback response was not successful. HTTP status -> ' + response.status);
                    }
                    const IDENTITY_VERIFICATION_CALLBACK_RESPONSE_DATA = await response.json();
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Identity verification callback response data is available. :-');
                    return IDENTITY_VERIFICATION_CALLBACK_RESPONSE_DATA;
                },
                persistPkceCodePair: function(PKCE_CODE_PAIR) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_PERSIST_PKCE_CODE_PAIR_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Persisting PKCE code pair...');
                    const UTILS = wdprProfileNav.main.utils;
                    const PKCE_CODE_PAIR_JSON = JSON.stringify(PKCE_CODE_PAIR);
                    sessionStorage.setItem('guestIdentityPkceCodePair', PKCE_CODE_PAIR_JSON);
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> PKCE code pair persisted successfully.');
                },
                retrievePkceCodePair: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_RETRIEVE_PKCE_CODE_PAIR_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Retrieving PKCE code pair...');
                    let pkceCodePair = null;
                    const UTILS = wdprProfileNav.main.utils;
                    const PKCE_CODE_PAIR_JSON = sessionStorage.getItem('guestIdentityPkceCodePair');
                    if (UTILS.isStringAndNotEmpty(PKCE_CODE_PAIR_JSON)) {
                        const PKCE_CODE_PAIR = JSON.parse(PKCE_CODE_PAIR_JSON);
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> PKCE code pair retrieved successfully. :-)');
                        pkceCodePair = PKCE_CODE_PAIR;
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> PKCE code pair is not available. Returning null.');
                    }
                    return pkceCodePair;
                },
                getIdMePopupWindowUrl: async function(ID_ME_LAUNCHER_BUTTON_CONFIG) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_GET_ID_ME_POPUP_WINDOW_URL_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting ID.me popup window URL...');
                    const UTILS = wdprProfileNav.main.utils;
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    let idMePopupWindowUrl = null;
                    const ID_ME_AUTHORIZE_URL = ID_ME_LAUNCHER_BUTTON_CONFIG.dataAuthorizeUrl;
                    const ID_ME_CLIENT_ID = ID_ME_LAUNCHER_BUTTON_CONFIG.dataClientId;
                    const ID_ME_REDIRECT_URI = ID_ME_LAUNCHER_BUTTON_CONFIG.dataRedirectUri;
                    const ID_ME_RESPONSE_TYPE = ID_ME_LAUNCHER_BUTTON_CONFIG.dataResponseType;
                    const ID_ME_SCOPE = ID_ME_LAUNCHER_BUTTON_CONFIG.dataScope;
                    const PKCE_CODE_PAIR = await GUEST_IDENTITY_CONTROLLER.generatePkceCodePair();
                    if (UTILS.isStringAndNotEmpty(ID_ME_AUTHORIZE_URL)) {
                        if (UTILS.isStringAndNotEmpty(ID_ME_CLIENT_ID)) {
                            if (UTILS.isStringAndNotEmpty(ID_ME_REDIRECT_URI)) {
                                if (UTILS.isStringAndNotEmpty(ID_ME_RESPONSE_TYPE)) {
                                    if (UTILS.isStringAndNotEmpty(ID_ME_SCOPE)) {
                                        if (PKCE_CODE_PAIR) {
                                            const CODE_VERIFIER = PKCE_CODE_PAIR.codeVerifier;
                                            const CODE_CHALLENGE_ENCODED = PKCE_CODE_PAIR.codeChallengeEncoded;
                                            const ID_ME_SCOPE_ENCODED = encodeURIComponent(ID_ME_SCOPE);
                                            GUEST_IDENTITY_CONTROLLER.persistPkceCodePair(PKCE_CODE_PAIR);
                                            idMePopupWindowUrl = ID_ME_AUTHORIZE_URL + '?scope=' + ID_ME_SCOPE_ENCODED + '&client_id=' + 
                                            ID_ME_CLIENT_ID + '&redirect_uri=' + ID_ME_REDIRECT_URI + '&response_type=' + ID_ME_RESPONSE_TYPE + '&code_challenge=' + CODE_CHALLENGE_ENCODED + '&code_challenge_method=S256';
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me popup window URL is -> ' + idMePopupWindowUrl + ' with code verifier -> ' + CODE_VERIFIER + ' and code challenge -> ' + CODE_CHALLENGE_ENCODED);
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> PKCE code pair is not valid. Cannot proceed to get the ' +
                                                'ID.me popup window URL.');
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me scope is not valid. Cannot proceed to get the ' +
                                            'ID.me popup window URL.');
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me response type is not valid. Cannot proceed to get ' +
                                        'the ID.me popup window URL.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me redirect URI is not valid. Cannot proceed to get the ' + 
                                    'ID.me popup window URL.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me client ID is not valid. Cannot proceed to get the ID.me ' +
                                'popup window URL.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me popup window URL is not valid. Cannot proceed to get the ' +
                            'ID.me popup window URL.');
                    }
                    return idMePopupWindowUrl;
                },
                generatePkceCodePair: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_GENERATE_PKCE_CODE_PAIR_';
                    const UTILS = wdprProfileNav.main.utils;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Generating PKCE code verifier and code challenge...');
                    const codeVerifier = UTILS.generateCodeVerifier(128);
                    const codeChallengeBuffer = await UTILS.sha256(codeVerifier);   // SHA-256 hash bytes
                    const codeChallengeEncoded = UTILS.base64UrlEncodeBytes(codeChallengeBuffer);
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> PKCE code pair generated successfully.');
                    return {
                        codeVerifier: codeVerifier,
                        codeChallenge: codeChallengeBuffer,           // optional; usually you only need encoded form
                        codeChallengeEncoded: codeChallengeEncoded
                    };
                },
                closeIDMePopupWindow: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_CLOSE_ID_ME_POPUP_WINDOW_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Closing ID.me popup window...');
                    const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                    const ID_ME_POPUP_WINDOW_CONFIG =
                        wdprProfileNav.features.guestIdentity.constants.idMe.ID_ME_POPUP_WINDOW_CONFIG;
                    const ID_ME_POPUP_WINDOW_NAME = ID_ME_POPUP_WINDOW_CONFIG.ID_ME_POPUP_WINDOW_NAME;
                    const STORED_ID_ME_POPUP_WINDOW = GUEST_IDENTITY_MODEL.idMePopupWindow;
                    if (STORED_ID_ME_POPUP_WINDOW && !STORED_ID_ME_POPUP_WINDOW.closed) {
                        STORED_ID_ME_POPUP_WINDOW.close();
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me popup window closed via stored reference.');
                    } else {
                        const NAMED_ID_ME_POPUP_WINDOW = window.open('', ID_ME_POPUP_WINDOW_NAME);
                        if (NAMED_ID_ME_POPUP_WINDOW) {
                            NAMED_ID_ME_POPUP_WINDOW.close();
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me popup window closed via named window fallback.');
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to resolve ID.me popup window to close.');
                        }
                    }
                    GUEST_IDENTITY_MODEL.idMePopupWindow = null;
                },
                attachIdMeCallbackCompleteMessageListener: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_ATTACH_ID_ME_CALLBACK_COMPLETE_MESSAGE_LISTENER_';
                    const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                    if (GUEST_IDENTITY_MODEL.isIdMeCallbackCompleteMessageListenerAttached) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me callback complete message listener is already attached.');
                        return;
                    }
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    const idMeCallbackCompleteMessageListener =
                        GUEST_IDENTITY_CONTROLLER.eventListeners.idMeCallbackCompleteMessageListener;
                    window.addEventListener('message', idMeCallbackCompleteMessageListener);
                    GUEST_IDENTITY_MODEL.isIdMeCallbackCompleteMessageListenerAttached = true;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me callback complete message listener attached successfully.');
                },
                detachIdMeCallbackCompleteMessageListener: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_DETACH_ID_ME_CALLBACK_COMPLETE_MESSAGE_LISTENER_';
                    const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                    if (!GUEST_IDENTITY_MODEL.isIdMeCallbackCompleteMessageListenerAttached) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me callback complete message listener is not attached.');
                        return;
                    }
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    const idMeCallbackCompleteMessageListener =
                        GUEST_IDENTITY_CONTROLLER.eventListeners.idMeCallbackCompleteMessageListener;
                    window.removeEventListener('message', idMeCallbackCompleteMessageListener);
                    GUEST_IDENTITY_MODEL.isIdMeCallbackCompleteMessageListenerAttached = false;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me callback complete message listener detached successfully.');
                },
                resetTravelAgentGuestProfile: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_RESET_TRAVEL_AGENT_GUEST_PROFILE_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Resetting travel agent guest profile...');
                    const DEFAULT_GUEST_PROFILE_CLONE = 
                        structuredClone(wdprProfileNav.main.constants.travelAgent.DEFAULT_TRAVEL_AGENT_GUEST_PROFILE);
                    wdprProfileNav.main.model.travelAgent.guestProfile = DEFAULT_GUEST_PROFILE_CLONE;
                    wdprProfileNav.main.model.travelAgent.isTravelAgentGuestProfileDataReady = false;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent guest profile data is reset successfully.');
                },
                getTravelAgentGuestProfile: async function(emailAddress, lastName) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_GET_TRAVEL_AGENT_GUEST_PROFILE_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting travel agent guest profile...');
                    let travelAgentGuestProfile = null;
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    GUEST_IDENTITY_CONTROLLER.resetTravelAgentGuestProfile();
                    let isEmailAddressAndLastNameValid = 
                        GUEST_IDENTITY_CONTROLLER.isEmailAddressAndLastNameValid(emailAddress, lastName);
                    if (isEmailAddressAndLastNameValid) {
                        const TRAVEL_AGENT = await wdprProfileNav.api.travelAgent.getTravelAgent();
                        if (TRAVEL_AGENT) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent is available. Loading guest profile...' +
                                'The travel agent is -> ' + JSON.stringify(TRAVEL_AGENT));
                            const TRAVEL_AGENT_GUEST_PROFILE = 
                                await GUEST_IDENTITY_CONTROLLER.getTravelAgentGuestProfileFromApiEndpoint(
                                    TRAVEL_AGENT, emailAddress, lastName);
                            if (TRAVEL_AGENT_GUEST_PROFILE) {
                                travelAgentGuestProfile = structuredClone(TRAVEL_AGENT_GUEST_PROFILE);
                                TRAVEL_AGENT.travelAgentGuestProfile = travelAgentGuestProfile;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent guest profile is loaded successfully. ' +
                                    'The travel agent guest profile is -> ' + JSON.stringify(travelAgentGuestProfile));
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest profile is not available. Returning null.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Travel agent model is not available. Returning null.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Email address is not valid. Returning null.');
                    }
                    return travelAgentGuestProfile;
                },
                eventEmitters: {
                    guestProfileReadyEventEmitter: function() {

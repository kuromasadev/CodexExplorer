            controller: {
                init: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_INIT_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Initializing Enterprise Wide Consent Sync (EWCS) feature for ' +
                        'WDPR Profile Nav with the following configuration: ' +
                    JSON.stringify(wdprProfileNav.config.features.enterpriseWideConsentSyncConfig));
                    const UTILS = wdprProfileNav.main.utils;
                    const CURRENT_BRAND_CODE = wdprProfileNav.main.model.brandCode;
                    const IS_EWCS_FEATURE_ENABLED = wdprProfileNav.features.ewcs.controller.isEnterpriseWideConsentSyncFeatureEnabled();
                    wdprProfileNav.features.ewcs.model.isEWCSFeatureEnabled = IS_EWCS_FEATURE_ENABLED;
                    if (IS_EWCS_FEATURE_ENABLED) {
                        if (UTILS.isStringAndNotEmpty(CURRENT_BRAND_CODE)) {
                            if (CURRENT_BRAND_CODE.toUpperCase() === 'PD' || CURRENT_BRAND_CODE.toUpperCase() === 'DVC') {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Initializing EWCS feature for PD or DVC brand code \"' + CURRENT_BRAND_CODE +
                                    '\" based on EWCS config detected in wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.');
                                wdprProfileNav.features.ewcs.controller.initEnabledEWCSFeatureForBrandWithOneIdV5Only();
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully initialized EWCS feature for PD or DVC brand code \"' + CURRENT_BRAND_CODE +
                                    '\" based on EWCS config detected in wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.');
                            } else {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Initializing EWCS feature for non-PD or DVC brand code \"' + CURRENT_BRAND_CODE +
                                    '\" based on EWCS config detected in wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.');
                                wdprProfileNav.features.ewcs.controller.initEnabledEWCSFeature();
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully initialized EWCS feature for non-PD brand code \"' + CURRENT_BRAND_CODE +
                                    '\" based on EWCS config detected in wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> CURRENT_BRAND_CODE is null or undefined. ' +
                                'Skipping initialization of EWCS feature for current brand code \"' + CURRENT_BRAND_CODE +
                                '\" as it is not a valid non-empty string.');
                        }
                    } else {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Skipping initialization of EWCS feature as it is not enabled ' +
                            'based on the provided configuration.');
                    }
                },
                isEnterpriseWideConsentSyncFeatureEnabled: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_IS_ENABLED_';
                    let isEWCSFeatureEnabled = false;
                    if (!wdprProfileNav.config.features.enterpriseWideConsentSyncConfig) {
                        console.warn('EWCS config not detected in wdprProfileNav.config.features.enterpriseWideConsentSyncConfig. ' +
                            'Assuming EWCS feature is disabled.');
                    } else {
                        const IS_ENTERPRISE_WIDE_CONSENT_SYNC_ENABLED =
                            wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.isEnterpriseWideConsentSyncEnabled;
                        const ENTERPRISE_WIDE_CONSENT_SYNC_ENABLED_BRANDS =
                            wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.enterpriseWideConsentSyncEnabledBrands;
                        const CURRENT_BRAND_CODE = wdprProfileNav.main.model.brandCode;
                        if (IS_ENTERPRISE_WIDE_CONSENT_SYNC_ENABLED === 'true') {
                            if (ENTERPRISE_WIDE_CONSENT_SYNC_ENABLED_BRANDS.includes(CURRENT_BRAND_CODE)) {
                                isEWCSFeatureEnabled = true;
                                console.log(LOG_MESSAGE_PREFIX + 'EWCS feature is enabled for current brand code \"' + CURRENT_BRAND_CODE +
                                    '\" based on EWCS config detected in wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.');
                            } else {
                                console.warn(LOG_MESSAGE_PREFIX + 'EWCS feature is disabled for current brand code \"' + CURRENT_BRAND_CODE +
                                    '\" based on EWCS config detected in wdprProfileNav.config.features.enterpriseWideConsentSyncConfig. ' +
                                    'Current brand code is not included in the list of EWCS enabled brands.');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'EWCS feature is disabled based on EWCS config detected in ' +
                                'wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.');
                        }
                        console.log(LOG_MESSAGE_PREFIX + 'EWCS config detected in wdprProfileNav.config.features.enterpriseWideConsentSyncConfig ' +
                            'with the following value: ' + JSON.stringify(wdprProfileNav.config.features.enterpriseWideConsentSyncConfig));
                    }
                    return isEWCSFeatureEnabled;
                },
                setOneTrustTokenMaxAge: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_SET_ONETRUST_TOKEN_MAX_AGE_';
                    const ONETRUST_TOKEN_MAX_AGE_MINUTES =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.oneTrustTokenMaxAgeMinutes;
                    const ONETRUST_TOKEN_MAX_AGE_MS = ONETRUST_TOKEN_MAX_AGE_MINUTES * 60 * 1000;
                    wdprProfileNav.features.ewcs.model.oneTrustTokenMaxAgeMs = ONETRUST_TOKEN_MAX_AGE_MS;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Set OneTrust token max age value for EWCS feature with the following value -> ' +
                        ONETRUST_TOKEN_MAX_AGE_MS + 'ms based on the provided configuration.');
                },
                initEnabledEWCSFeature: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_INIT_';
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalFrequencyMs;
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalMaxAttempts;
                    wdprProfileNav.features.ewcs.controller.setOneTrustTokenMaxAge();
                    const INTERVAL_DETECTION_MODULUS_FREQUENCY =
                        wdprProfileNav.main.constants.INTERVAL_DETECTION_MODULUS_FREQUENCY;
                    let pepProfileAuth = null;
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL = setInterval(async function() {
                        wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount =
                        wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount + 1;
                        if (wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount <=
                            PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS) {
                            if (window.PEP && window.PEP.PROFILE_AUTH) {
                                pepProfileAuth = window.PEP.PROFILE_AUTH;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully detected PEP.PROFILE_AUTH JS object on attempt count ' +
                                    wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount + ' of ' +
                                    PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                    ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms.');
                                if (pepProfileAuth.isInitialized) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> PEP.PROFILE_AUTH JS object is initialized. ' +
                                        'Clearing PEP_PROFILE_AUTH_DETECTOR_INTERVAL and resetting ' +
                                        'pepProfileAuthDetectionAttemptCount to 0.');
                                    clearInterval(PEP_PROFILE_AUTH_DETECTOR_INTERVAL);
                                    wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount = 0;
                                    let guestInfo = await wdprProfileNav.features.ewcs.controller.getGuestInfoFromPepProfileAuth(pepProfileAuth);
                                    wdprProfileNav.features.ewcs.controller.processGuestInfoAndInitializeOneTrustSDK(guestInfo);
                                }
                            } else {
                                if (wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount === 1 || 
                                    wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount % INTERVAL_DETECTION_MODULUS_FREQUENCY === 0) {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> PEP.PROFILE_AUTH JS object and initialization status not ' +
                                        'detected on attempt count ' +
                                        wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount + ' of ' +
                                        PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                        ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                        'Retrying detection...');
                                }
                            }
                        } else {
                            wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount =
                                wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount - 1;
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect the PEP.PROFILE_AUTH JS object with attempt count ' +
                                        wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount + ' of ' +
                                        PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                        ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                        'Stopping further detection attempts.');
                            clearInterval(PEP_PROFILE_AUTH_DETECTOR_INTERVAL);
                            wdprProfileNav.features.ewcs.model.pepProfileAuthDetectionAttemptCount = 0;
                        }
                    }, PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS);
                },
                initEnabledEWCSFeatureForBrandWithOneIdV5Only: async function() {

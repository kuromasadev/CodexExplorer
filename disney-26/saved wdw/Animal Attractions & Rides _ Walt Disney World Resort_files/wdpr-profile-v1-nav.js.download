                    getVerifiedResidencyAffiliationHtml: function(affiliation, affiliationTemplate, contentModel) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_GET_AFFILIATION_HTML_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting affiliation HTML...');
                        const UTILS = wdprProfileNav.main.utils;
                        const AFFILIATION_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.affiliations;
                        const ID_ME_VERIFIED_BADGES = wdprProfileNav.features.guestIdentity.constants.idMe.ID_ME_VERIFIED_BADGES;
                        let affiliationHtml = null;
                        const AFFILIATION_TYPE = affiliation.type;
                        const AFFILIATION_SUB_TYPE = affiliation.subType;
                        const AFFILIATION_SUB_TYPE_FL_FLORIDA = AFFILIATION_CONSTANTS.AFFILIATION_TYPE_GEOGRAPHIC_SUBTYPE.FL_RESIDENT;
                        const ID_ME_VERIFIED_LIGHT_WITH_GREEN_TEXT = ID_ME_VERIFIED_BADGES.ID_ME_VERIFIED_LIGHT_WITH_GREEN_TEXT;
                        if (contentModel) {
                            if (UTILS.isStringAndNotEmpty(AFFILIATION_TYPE)) {
                                if (AFFILIATION_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE.RESIDENCY) {
                                    if (AFFILIATION_SUB_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_RESIDENCY_SUBTYPE.FLORIDA) {
                                        if (contentModel.profile) {
                                            if (contentModel.profile.memberships) {
                                                if (contentModel.profile.memberships[AFFILIATION_SUB_TYPE_FL_FLORIDA]) {
                                                    const CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE = contentModel.profile.memberships[AFFILIATION_SUB_TYPE_FL_FLORIDA];
                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE) {
                                                        if (UTILS.isStringAndNotEmpty(affiliation.validityEndDate)) {
                                                            const VALIDITY_END_DATE = affiliation.validityEndDate;
                                                            const FORMATTED_VALIDITY_END_DATE = UTILS.formatIso8601DateToLongOrdinalDate(VALIDITY_END_DATE);
                                                            if (FORMATTED_VALIDITY_END_DATE) {
                                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation sub type is a verified Florida resident and content membership for affiliation type is available. ' +
                                                                    'Displaying verified Florida resident affiliation...');
                                                                let affiliationIconClass = '';
                                                                let affiliationName = '';
                                                                let affiliationDetail = '';
                                                                if (CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.icon) {
                                                                    affiliationIconClass = CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.icon;
                                                                }
                                                                if (CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.label) {
                                                                    affiliationName = CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.label;
                                                                }
                                                                if (UTILS.isStringAndNotEmpty(CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.detail)) {
                                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.detail.includes('<a')) {
                                                                        const DETAIL_ARRAY = CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.detail.split('<a');
                                                                        if (DETAIL_ARRAY.length > 1) {
                                                                            affiliationDetail = '<a' + DETAIL_ARRAY[1];
                                                                        }
                                                                    } else {
                                                                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Content membership for affiliation type detail is not available - no "<a" detected...' +
                                                                            'Displaying ' + AFFILIATION_TYPE + ' affiliation without detail...');
                                                                    }
                                                                } else {
                                                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Content membership for affiliation type detail is not available. ' +
                                                                        'Displaying ' + AFFILIATION_TYPE + ' affiliation without detail...');
                                                                }
                                                                let affiliationDetail2 = '<img class="id-me-verified-badge" src="' + ID_ME_VERIFIED_LIGHT_WITH_GREEN_TEXT.verifiedBadgeImageUrl + 
                                                                                '" alt="' + ID_ME_VERIFIED_LIGHT_WITH_GREEN_TEXT.verifiedBadgeDescription + 
                                                                                '"> | Expires ' + FORMATTED_VALIDITY_END_DATE;
                                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content membership for affiliation type is -> ' + 
                                                                    AFFILIATION_SUB_TYPE_FL_FLORIDA + '. Displaying affiliation...');
                                                                const AFFILIATION_HTML = affiliationTemplate.replace('{affiliationIconClass}', affiliationIconClass)
                                                                    .replace('{affiliationName}', affiliationName)
                                                                    .replace('{affiliationDetail}', affiliationDetail)
                                                                    .replace('{affiliationDetail2}', affiliationDetail2);
                                                                affiliationHtml = AFFILIATION_HTML;
                                                            } else {
                                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation validity end date is not available. ' +
                                                                    'Unable to display ' + AFFILIATION_TYPE + ' affiliation.');
                                                            }
                                                        } else {
                                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation validity end date is not available. ' +
                                                                'Unable to display ' + AFFILIATION_TYPE + ' affiliation.');
                                                        }
                                                    } else {
                                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content membership for affiliation type is not available. ' +
                                                            'Unable to display ' + AFFILIATION_TYPE + ' affiliation.');
                                                    }
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content membership for affiliation sub type is not available. ' +
                                                        'Unable to display ' + AFFILIATION_TYPE + ' affiliation.');
                                                }
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" and "memberships" data ' +
                                                    'are not available. Unable to display ' + AFFILIATION_TYPE + ' affiliation.');
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" data is not available. ' +
                                                'Unable to display ' + AFFILIATION_TYPE + ' affiliation.');
                                        }
                                    } else {
                                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Affiliation sub type is not Florida and or not yet supported. Unable to display ' + 
                                            AFFILIATION_TYPE + ' - ' + AFFILIATION_SUB_TYPE + ' affiliation.');
                                    }
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not available. Unable to display ' + 
                                    AFFILIATION_TYPE + ' affiliation.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model is not available. Unable to display ' + 
                                AFFILIATION_TYPE + ' affiliation.');
                        }
                        return affiliationHtml;
                    },
                    getMilitaryAffiliationHtml: function(affiliation, affiliationTemplate, contentModel) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_DISPLAY_MILITARY_AFFILIATION_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Displaying military affiliation...');
                        const UTILS = wdprProfileNav.main.utils;
                        const AFFILIATION_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.affiliations;
                        let affiliationHtml = null;
                        const AFFILIATION_TYPE = affiliation.type;
                        const AFFILIATION_SUB_TYPE = affiliation.subType;
                        if (contentModel) {
                            if (AFFILIATION_TYPE) {
                                if (AFFILIATION_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE.MILITARY) {
                                    let affiliationIconClass = 'di-us-military';
                                    let affiliationName = 'Military';
                                    let affiliationDetail = '';
                                    let affiliationDetail2 = '';
                                    if (UTILS.isStringAndNotEmpty(AFFILIATION_SUB_TYPE)) {
                                        if (AFFILIATION_SUB_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.SERVICE_MEMBER) {
                                            affiliationDetail = 'Service Member';
                                        } else if (AFFILIATION_SUB_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.RETIREE) {
                                            affiliationDetail = 'Retiree';
                                        } else if (AFFILIATION_SUB_TYPE === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.SPOUSE) {
                                            affiliationDetail = 'Spouse';
                                        }
                                    }
                                    if (UTILS.isStringAndNotEmpty(affiliationDetail)) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type is -> ' + AFFILIATION_TYPE + ' with affiliation detail value -> ' + 
                                            affiliationDetail + '. Displaying affiliation...');
                                        const AFFILIATION_HTML = affiliationTemplate.replace('{affiliationIconClass}', affiliationIconClass)
                                        .replace('{affiliationName}', affiliationName)
                                        .replace('{affiliationDetail}', affiliationDetail)
                                        .replace('{affiliationDetail2}', affiliationDetail2);
                                        affiliationHtml = AFFILIATION_HTML;
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not military. Unable to display military affiliation.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not available. Unable to display military affiliation.');
                            }
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content model is available. Proceeding to display military affiliation...');
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model is not available. Unable to display military affiliation.');
                        }
                        return affiliationHtml;
                    },

                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" and "memberships" data ' +
                                                'are not available. Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                                AFFILIATION_SUBTYPE + ' affiliation.');
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" data is not available. ' +
                                            'Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                            AFFILIATION_SUBTYPE + ' affiliation.');
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not available. Unable to display ' + 
                                        AFFILIATION_CATEGORY + ' affiliation category.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation category is not available. Unable to display ' +
                                    'affiliation category.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model is not available. Unable to display ' + 
                                AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' affiliation.');
                        }
                        return affiliationHtml;
                    },
                    getAnnualPassAffiliationHtml: function(affiliation, affiliationTemplate, contentModel) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_GET_AFFILIATION_HTML_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting affiliation HTML...');
                        const UTILS = wdprProfileNav.main.utils;
                        const VIEW_AFFILIATIONS = wdprProfileNav.features.guestIdentity.view.affiliations;
                        let affiliationHtml = null;
                        const AFFILIATION_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.affiliations;
                        const CONTENT_MODEL_KEY_PASSHOLDER = AFFILIATION_CONSTANTS.CONTENT_MODEL_KEY_PASSHOLDER;
                        const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                        const IS_TEST_PARAM_AP_RENEWABLE_ACTIVE = GUEST_IDENTITY_MODEL.testParameters.isTestParamAPRenewableActive;
                        const AFFILIATION_CATEGORY = affiliation.category;
                        const AFFILIATION_TYPE = affiliation.type;
                        const AFFILIATION_SUBTYPE = affiliation.subType;
                        const VALIDITY_END_DATE = affiliation.validityEndDate;
                        const IS_RENEWABLE = affiliation.renewable;
                        let isRenewable = false;
                        if (contentModel) {
                            if (UTILS.isStringAndNotEmpty(AFFILIATION_CATEGORY)) {
                                if (UTILS.isStringAndNotEmpty(AFFILIATION_TYPE)) {
                                    if (contentModel.profile) {
                                        if (contentModel.profile.memberships) {
                                            if (contentModel.profile.memberships[CONTENT_MODEL_KEY_PASSHOLDER]) {
                                                const CONTENT_MEMBERSHIP_FOR_AFFILIATION = 
                                                    contentModel.profile.memberships[AFFILIATION_CONSTANTS.CONTENT_MODEL_KEY_PASSHOLDER];
                                                if (CONTENT_MEMBERSHIP_FOR_AFFILIATION) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content membership for affiliation type is available. ' +
                                                        'Proceeding to attempt to display the affiliation...');
                                                    let siteBrandCode = null;
                                                    if (affiliation.sites) {
                                                        if (Array.isArray(affiliation.sites)) {
                                                            for (const SITE of affiliation.sites) {
                                                                if (UTILS.isStringAndNotEmpty(SITE)) {
                                                                    siteBrandCode = SITE.toLowerCase();
                                                                    break;
                                                                }
                                                            }
                                                        }
                                                    } else {
                                                        console.warn(LOG_MESSAGE_PREFIX + 'WARNING -> Affiliation sites are not available. ' +
                                                            'Unable to display the affiliation.');
                                                    }
                                                    const ENTITLEMENT_ID = VIEW_AFFILIATIONS.getAffiliationId(affiliation, 'ENTITLEMENT-ID');
                                                    let affiliationIconClass = '';
                                                    let affiliationName = '';
                                                    let affiliationDetail = '';
                                                    let affiliationDetail2 = '';
                                                    let iconPropertyName = 'icon';
                                                    let labelPropertyName = 'label';
                                                    let renewText = 'Renew Now';
                                                    if (UTILS.isStringAndNotEmpty(siteBrandCode)) {
                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Site brand code is -> ' + siteBrandCode + '. ' +
                                                            'Processing to set the icon and label property names...');
                                                        if ((siteBrandCode === 'wdw') || (siteBrandCode === 'dlr')) {
                                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Site brand code is either WDW or DLR -> ' + siteBrandCode + '. ' +
                                                                'Setting the icon and label property names to the site brand code property names...');
                                                            iconPropertyName = iconPropertyName + '_' + siteBrandCode;
                                                            labelPropertyName = labelPropertyName + '_' + siteBrandCode;
                                                            if (UTILS.isStringAndNotEmpty(IS_RENEWABLE)) {
                                                                if (IS_RENEWABLE.toLowerCase() === 'true' || IS_TEST_PARAM_AP_RENEWABLE_ACTIVE) {
                                                                    if (IS_TEST_PARAM_AP_RENEWABLE_ACTIVE) {
                                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Test parameter AP Renewable is active. ' +
                                                                            'Setting the isRenewable flag to true...');
                                                                    }
                                                                    isRenewable = true;
                                                                    const CONTENT_RENEW_TEXT = contentModel.profile.memberships.renew;
                                                                    if (UTILS.isStringAndNotEmpty(CONTENT_RENEW_TEXT)) {
                                                                        renewText = CONTENT_RENEW_TEXT;
                                                                    }
                                                                }
                                                            }
                                                        } else {
                                                            console.warn(LOG_MESSAGE_PREFIX + 'WARNING -> Site brand code is not WDW or DLR -> ' + siteBrandCode + '. ' +
                                                                'Unable to set the icon and label property names to the site brand code property names. ' +
                                                                'Displaying default icon and label property names...');
                                                        }
                                                    } else {
                                                        console.warn(LOG_MESSAGE_PREFIX + 'WARNING -> Site brand code is not available. ' +
                                                            'Unable to set the icon and label property names to the site brand code property names. ' +
                                                            'Displaying default icon and label property names...');
                                                    }
                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION[iconPropertyName]) {
                                                        affiliationIconClass = CONTENT_MEMBERSHIP_FOR_AFFILIATION[iconPropertyName];
                                                    }
                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION[labelPropertyName]) {
                                                        affiliationName = CONTENT_MEMBERSHIP_FOR_AFFILIATION[labelPropertyName];
                                                    }
                                                    if (UTILS.isStringAndNotEmpty(AFFILIATION_TYPE)) {
                                                        affiliationDetail = AFFILIATION_TYPE;
                                                        if (AFFILIATION_CATEGORY === AFFILIATION_CONSTANTS.AFFILIATION_CATEGORY.ANNUAL) {
                                                            if (UTILS.isStringAndNotEmpty(AFFILIATION_SUBTYPE)) {
                                                                affiliationDetail = AFFILIATION_SUBTYPE;
                                                            }
                                                        }
                                                        if (UTILS.isStringAndNotEmpty(ENTITLEMENT_ID)) {
                                                            affiliationDetail = affiliationDetail + ' | ID: ' + ENTITLEMENT_ID;
                                                        }
                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation detail is -> ' + affiliationDetail + '. Displaying affiliation...');
                                                    }
                                                    if (UTILS.isStringAndNotEmpty(VALIDITY_END_DATE)) {
                                                        const VALIDITY_END_DATE_FORMATTED = UTILS.formatIso8601DateToLongOrdinalDate(VALIDITY_END_DATE);
                                                        affiliationDetail2 = 'Expires: ' + VALIDITY_END_DATE_FORMATTED;
                                                    }
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content membership for affiliation type is -> ' + 
                                                        CONTENT_MODEL_KEY_PASSHOLDER + '. Displaying affiliation...');
                                                    const AFFILIATION_HTML = affiliationTemplate
                                                        .replaceAll('{affiliationIconClass}', affiliationIconClass)
                                                        .replaceAll('{affiliationCategory}', AFFILIATION_CATEGORY.toLowerCase())
                                                        .replaceAll('{affiliationType}', AFFILIATION_TYPE.toLowerCase())
                                                        .replaceAll('{affiliationName}', affiliationName)
                                                        .replaceAll('{affiliationDetail}', affiliationDetail)
                                                        .replaceAll('{affiliationDetail2}', affiliationDetail2);
                                                    affiliationHtml = AFFILIATION_HTML;
                                                    if (isRenewable) {
                                                        affiliationHtml = affiliationHtml
                                                            .replaceAll('<div class="affiliation-button-container" style="display: none;">', 
                                                                '<div class="affiliation-button-container" style="display: block;">')
                                                            .replaceAll('{affiliationBrandCode}', siteBrandCode)
                                                            .replaceAll('{RENEW_BUTTON_TEXT}', renewText);
                                                    }
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content membership for affiliation type is ' +
                                                        'not available. Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                                        AFFILIATION_SUBTYPE + ' affiliation.');
                                                }
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" and "memberships" data ' +
                                                    'are not available. Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                                    AFFILIATION_SUBTYPE + ' affiliation.');
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" and "memberships" data ' +
                                                'are not available. Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                                AFFILIATION_SUBTYPE + ' affiliation.');
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" data is not available. ' +
                                            'Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                            AFFILIATION_SUBTYPE + ' affiliation.');
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not available. Unable to display ' + 
                                        AFFILIATION_CATEGORY + ' affiliation category.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation category is not available. Unable to display ' +
                                    'affiliation category.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model is not available. Unable to display ' + 
                                AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' affiliation.');
                        }
                        return affiliationHtml;
                    },
                },
                interstitial: {
                    ensureMounted: function() {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'VIEW_INTERSTITIAL_ENSURE_MOUNTED_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Ensuring the interstitial element is mounted to the DOM...');
                        const INTERSTITIAL_ID = 'guest-profile-identity-verification-interstitial';
                        if (document.getElementById(INTERSTITIAL_ID)) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Interstitial element is already mounted to the DOM. Returning the element...');
                            return document.getElementById(INTERSTITIAL_ID);
                        }
                        const TEMPLATE = wdprProfileNav.features.guestIdentity.constants.viewTemplates.interstitial.INTERSTITIAL_TEMPLATE;
                        document.body.insertAdjacentHTML('beforeend', TEMPLATE);
                        const INTERSTITIAL_ELEMENT = document.getElementById(INTERSTITIAL_ID);
                        wdprProfileNav.features.guestIdentity.view.interstitial.bindActions(INTERSTITIAL_ELEMENT);
                        return INTERSTITIAL_ELEMENT;
                    },
                    bindActions: function(INTERSTITIAL_ELEMENT) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'VIEW_INTERSTITIAL_BIND_ACTIONS_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Binding actions to the interstitial element...');
                        if (INTERSTITIAL_ELEMENT) {
                            const INTERSTITIAL_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.viewTemplates.interstitial;
                            const CLOSE_BTN = document.getElementById(INTERSTITIAL_CONSTANTS.INTERSTITIAL_CLOSE_BUTTON_ID);
                            const DISMISS_BTN = document.getElementById(INTERSTITIAL_CONSTANTS.INTERSTITIAL_DISMISS_BUTTON_ID);
                            const CONTINUE_BTN = document.getElementById(INTERSTITIAL_CONSTANTS.INTERSTITIAL_CONTINUE_BUTTON_ID);
                            if (CLOSE_BTN) {
                                CLOSE_BTN.addEventListener('click', () => {
                                    wdprProfileNav.features.guestIdentity.view.interstitial.hide();
                                });
                            }
                            if (DISMISS_BTN) {
                                DISMISS_BTN.addEventListener('click', () => {
                                    wdprProfileNav.features.guestIdentity.view.interstitial.hide();
                                });
                            }
                            if (CONTINUE_BTN) {
                                CONTINUE_BTN.addEventListener('click', () => {
                                    wdprProfileNav.features.guestIdentity.view.interstitial.continue();
                                });
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Interstitial element is not available. Unable to bind actions to the interstitial element.');
                        }
                    },
                    show: function() {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'VIEW_INTERSTITIAL_SHOW_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Showing the interstitial element...');
                        const UTILS = wdprProfileNav.main.utils;
                        const INTERSTITIAL_ELEMENT = wdprProfileNav.features.guestIdentity.view.interstitial.ensureMounted();
                        const INTERSTITIAL_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.viewTemplates.interstitial;
                        const BRAND_CODE = wdprProfileNav.main.model.brandCode.toUpperCase();
                        if (INTERSTITIAL_ELEMENT) {
                            if (UTILS.isStringAndNotEmpty(BRAND_CODE)) {
                                const INTERSTITIAL_TITLE_TEXT = INTERSTITIAL_CONSTANTS.INTERSTITIAL_TITLE_TEXT;
                                const INTERSTITIAL_BODY_TEXT = INTERSTITIAL_CONSTANTS.INTERSTITIAL_BODY_TEXT[BRAND_CODE];
                                const INTERSTITIAL_CLOSE_BUTTON_TEXT = INTERSTITIAL_CONSTANTS.INTERSTITIAL_CLOSE_BUTTON_TEXT[BRAND_CODE];
                                const INTERSTITIAL_CONTINUE_BUTTON_TEXT = INTERSTITIAL_CONSTANTS.INTERSTITIAL_CONTINUE_BUTTON_TEXT[BRAND_CODE];
                                let isAllInterstitialTextsAvailable = false;
                                if (UTILS.isStringAndNotEmpty(INTERSTITIAL_TITLE_TEXT)) {
                                    INTERSTITIAL_ELEMENT.querySelector('.guest-profile-interstitial-modal__title').textContent = INTERSTITIAL_TITLE_TEXT;
                                    if (UTILS.isStringAndNotEmpty(INTERSTITIAL_BODY_TEXT)) {
                                        INTERSTITIAL_ELEMENT.querySelector('.guest-profile-interstitial-modal__body').textContent = INTERSTITIAL_BODY_TEXT;
                                        if (UTILS.isStringAndNotEmpty(INTERSTITIAL_CLOSE_BUTTON_TEXT)) {
                                            INTERSTITIAL_ELEMENT.querySelector('.guest-profile-interstitial-modal__button--close').textContent = INTERSTITIAL_CLOSE_BUTTON_TEXT;
                                            if (UTILS.isStringAndNotEmpty(INTERSTITIAL_CONTINUE_BUTTON_TEXT)) {
                                                INTERSTITIAL_ELEMENT.querySelector('.guest-profile-interstitial-modal__button--continue').textContent = INTERSTITIAL_CONTINUE_BUTTON_TEXT;
                                                isAllInterstitialTextsAvailable = true;
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Interstitial continue button text is not available. Unable to show the interstitial element.');
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Interstitial close button text is not available. Unable to show the interstitial element.');
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Interstitial body text is not available. Unable to show the interstitial element.');
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Interstitial title text is not available. Unable to show the interstitial element.');
                                }
                                if (isAllInterstitialTextsAvailable) {
                                    INTERSTITIAL_ELEMENT.classList.add('guest-profile-interstitial-modal--visible');
                                    INTERSTITIAL_ELEMENT.setAttribute('aria-hidden', 'false');
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Interstitial element is shown. The interstitial element is -> ' + 
                                        INTERSTITIAL_ELEMENT);
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Not all interstitial texts are available. Unable to show the interstitial element.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Brand code is not available. Unable to show the interstitial element.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Interstitial element is not available. Unable to show the interstitial element.');
                        }
                    },
                    hide: function() {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'VIEW_INTERSTITIAL_HIDE_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Hiding the interstitial element...');
                        const INTERSTITIAL_ELEMENT = document.getElementById('guest-profile-identity-verification-interstitial');
                        if (INTERSTITIAL_ELEMENT) {
                            INTERSTITIAL_ELEMENT.classList.remove('guest-profile-interstitial-modal--visible');
                            INTERSTITIAL_ELEMENT.setAttribute('aria-hidden', 'true');
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Interstitial element is not available. Unable to hide the interstitial element.');
                        }
                    },
                    continue: async function() {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'VIEW_INTERSTITIAL_CONTINUE_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Continuing the interstitial element...');
                        const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                        if (GUEST_IDENTITY_MODEL.idMeActiveInterstitialModal) {
                            const ID_ME_LAUNCHER_BUTTON_CONFIG = GUEST_IDENTITY_MODEL.idMeActiveInterstitialModal.idMeLauncherButtonConfig;
                            if (ID_ME_LAUNCHER_BUTTON_CONFIG) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button configuration is available. Proceeding to launch ID.me popup window...');
                                const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                                await GUEST_IDENTITY_CONTROLLER.openIdMePopupWindow(ID_ME_LAUNCHER_BUTTON_CONFIG);
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me popup window is launched. The ID.me popup window is -> ' + ID_ME_LAUNCHER_BUTTON_CONFIG);
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button configuration is not available. Unable to continue the interstitial element.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me active interstitial modal is not available. Unable to continue the interstitial element.');
                        }
                    }
                }
            }
        }
    },
    api: {
        guest: {
            getGuestProfile: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'API_GET_GUEST_PROFILE_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting guest profile data...');
                let guestProfile = null;
                const GUEST_PROFILE_MODEL = wdprProfileNav.features.guestIdentity.model.guestProfile;
                if (GUEST_PROFILE_MODEL) {
                    await wdprProfileNav.features.guestIdentity.controller.detectAffiliationsProcessingComplete();
                    if (GUEST_PROFILE_MODEL.isGuestProfileReady) {
                        if (!GUEST_PROFILE_MODEL.isAnonmymous) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is currently logged in.  The guest swid is -> ' +
                                GUEST_PROFILE_MODEL.swid);
                            if (GUEST_PROFILE_MODEL.isGuestAffiliationsReady) {
                                guestProfile = structuredClone(GUEST_PROFILE_MODEL);
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest affiliations model is ready. ' +
                                    'Returning guest profile data...');
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest affiliations model is not available.');
                            }
                        } else {
                            guestProfile = structuredClone(GUEST_PROFILE_MODEL);
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is anonymous and thus no guest affiliations ' + 
                                'data is available.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest profile model is not ready. Returning null.');
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest profile model is null. Returning null.');
                }
                return guestProfile;
            },
            getGuestAffiliations: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_GET_GUEST_AFFILIATIONS_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting guest affiliations...');
                let guestAffiliations = null;
                const GUEST_PROFILE = await wdprProfileNav.api.guest.getGuestProfile();
                if (GUEST_PROFILE) {
                    guestAffiliations = GUEST_PROFILE.affiliationInfo.affiliations;
                }
                return guestAffiliations;
            },
            hasMilitaryAffiliation: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_HAS_MILITARY_AFFILIATION_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the guest has a military affiliation...');
                let hasMilitaryAffiliation = false;
                const GUEST_PROFILE = await wdprProfileNav.api.guest.getGuestProfile();
                if (GUEST_PROFILE) {
                    if (GUEST_PROFILE.isGuestAffiliationsReady) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest affiliations model is ready. Checking if the guest ' +
                            'has a military affiliation...');
                        hasMilitaryAffiliation = GUEST_PROFILE.affiliationInfo.isMilitary;
                        if (hasMilitaryAffiliation) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest has a military affiliation. Returning true.');
                        } else {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest does not have a military affiliation. Returning false.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest affiliations model is not ready. Returning false.');
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest profile model is null. Returning false.');
                }
                return hasMilitaryAffiliation;
            },
            hasFloridaResidentAffiliation: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 
                    'API_HAS_FLORIDA_RESIDENT_AFFILIATION_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the guest has a Florida resident affiliation...');
                let hasFloridaResidentAffiliation = false;
                const GUEST_PROFILE = await wdprProfileNav.api.guest.getGuestProfile();
                if (GUEST_PROFILE) {
                    if (GUEST_PROFILE.isGuestAffiliationsReady) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest affiliations model is ready. Checking if the guest ' +
                            'has a Florida resident affiliation...');
                        hasFloridaResidentAffiliation = GUEST_PROFILE.affiliationInfo.isFloridaResident;
                        if (hasFloridaResidentAffiliation) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest has a Florida resident affiliation. Returning true.');
                        } else {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest does not have a Florida resident affiliation. Returning false.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest affiliations model is not ready. Returning false.');
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Guest profile model is null. Returning false.');
                }
                return hasFloridaResidentAffiliation;
            },
            isAnonymous: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_IS_ANONYMOUS_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the guest is anonymous...');
                let isAnonymous = false;
                const GUEST_PROFILE = await wdprProfileNav.api.guest.getGuestProfile();
                if (GUEST_PROFILE) {
                    isAnonymous = GUEST_PROFILE.isAnonmymous;
                }
                return isAnonymous;
            },
            isLoggedIn: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_IS_LOGGED_IN_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the guest is logged in...');
                let isLoggedIn = false;
                const GUEST_PROFILE = await wdprProfileNav.api.guest.getGuestProfile();
                if (GUEST_PROFILE) {
                    isLoggedIn = !GUEST_PROFILE.isAnonmymous;
                }
                return isLoggedIn;
            },
            identityVerification: {
                getDataScopeForFloridaResidentVerification: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'API_GET_DATA_SCOPE_FOR_FLORIDA_RESIDENT_VERIFICATION_';
                    let dataScopeForFloridaResidentVerification = null;
                    const ID_ME_DATA_SCOPE_TYPES = wdprProfileNav.features.guestIdentity.constants.idMe.ID_ME_DATA_SCOPE_TYPES;
                    const DATA_SCOPE_FOR_FLORIDA_RESIDENT_VERIFICATION = ID_ME_DATA_SCOPE_TYPES.FLORIDA_RESIDENT;
                    if (DATA_SCOPE_FOR_FLORIDA_RESIDENT_VERIFICATION) {
                        dataScopeForFloridaResidentVerification = structuredClone(DATA_SCOPE_FOR_FLORIDA_RESIDENT_VERIFICATION);
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> DATA_SCOPE_FOR_FLORIDA_RESIDENT_VERIFICATION is not available.');
                    }
                    return dataScopeForFloridaResidentVerification;
                },
                getDataScopeForMilitaryVerification: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'API_GET_DATA_SCOPE_FOR_MILITARY_VERIFICATION_';
                    let dataScopeForMilitaryVerification = null;
                    const ID_ME_DATA_SCOPE_TYPES = wdprProfileNav.features.guestIdentity.constants.idMe.ID_ME_DATA_SCOPE_TYPES;
                    const DATA_SCOPE_FOR_MILITARY_VERIFICATION = ID_ME_DATA_SCOPE_TYPES.MILITARY;
                    if (DATA_SCOPE_FOR_MILITARY_VERIFICATION) {
                        dataScopeForMilitaryVerification = structuredClone(DATA_SCOPE_FOR_MILITARY_VERIFICATION);
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> DATA_SCOPE_FOR_MILITARY_VERIFICATION is not available.');
                    }
                    return dataScopeForMilitaryVerification;
                },
                launchIdMePopupWindow: async function(dataScope) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'API_LAUNCH_ID_ME_POPUP_WINDOW_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Launching ID.me with data scope -> ' + dataScope);
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    let idMeLauncherButtonConfig = null;
                    const IS_DATA_SCOPE_VALID = GUEST_IDENTITY_CONTROLLER.isIdMeDataScopeValid(dataScope);
                    if (IS_DATA_SCOPE_VALID) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Data scope is valid. Proceeding to launch ID.me popup window...');
                        const ID_ME_LAUNCHER_BUTTON_CONFIG = wdprProfileNav.features.guestIdentity.model.idMeLauncherButtonConfig;
                        if (ID_ME_LAUNCHER_BUTTON_CONFIG) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button configuration is detected in the guestIdentity model. ' +
                                'Proceeding to launch ID.me popup window...');
                            idMeLauncherButtonConfig = structuredClone(ID_ME_LAUNCHER_BUTTON_CONFIG);
                            idMeLauncherButtonConfig.dataScope = dataScope;
                            await GUEST_IDENTITY_CONTROLLER.openIdMePopupWindow(idMeLauncherButtonConfig);
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button configuration is not detected in the guestIdentity model. ' +
                                'Cannot proceed to launch ID.me popup window.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Data scope is not valid. Cannot proceed to launch ID.me popup window.');
                    }
                },
                createIdMeLauncherButton: async function(buttonId, dataScope, buttonTypeCode) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'API_CREATE_ID_ME_LAUNCHER_BUTTON_ELEMENT_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Creating ID.me launcher button element and validating all inputs...');
                    const UTILS = wdprProfileNav.main.utils;
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    let isParametersValid = GUEST_IDENTITY_CONTROLLER.isCreateIdMeLauncherButtonParametersValid(buttonId, dataScope, buttonTypeCode);
                    if (isParametersValid) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> All parameters are valid with buttonId -> ' + buttonId + ' and dataScope -> ' +
                            dataScope + ' and buttonTypeCode -> ' + buttonTypeCode + '...');
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> All parameters are not valid with buttonId -> ' + buttonId + ' and dataScope -> ' +
                            dataScope + ' and buttonTypeCode -> ' + buttonTypeCode + '...');
                    }
                    let launcherButtonDomElement = null;
                    if (isParametersValid) {
                        const ID_ME_LAUNCHER_BUTTON_CONFIG = wdprProfileNav.features.guestIdentity.model.idMeLauncherButtonConfig;
                        const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                        if (ID_ME_LAUNCHER_BUTTON_CONFIG) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button configuration is detected in the guestIdentity model. ' +
                                'Proceeding to create the ID.me launcher button element...');
                            let idMeLauncherButtonConfig = structuredClone(ID_ME_LAUNCHER_BUTTON_CONFIG);
                            idMeLauncherButtonConfig.buttonId = buttonId;
                            idMeLauncherButtonConfig.dataScope = dataScope;
                            idMeLauncherButtonConfig.buttonTypeCode = buttonTypeCode;
                            if (GUEST_IDENTITY_MODEL.isIdMeLauncherButtonConfigInitialized) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button configuration is initialized. ' +
                                    'Proceeding to create the ID.me launcher button element...');
                                const LAUNCHER_BUTTON_DOM_ELEMENT = await UTILS.detectDomElementById(buttonId);
                                if (LAUNCHER_BUTTON_DOM_ELEMENT) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully detected DOM element with id -> ' +
                                        buttonId);
                                    launcherButtonDomElement = LAUNCHER_BUTTON_DOM_ELEMENT;
                                    const BUTTON_TYPE = GUEST_IDENTITY_CONTROLLER.getButtonTypeByButtonTypeCode(buttonTypeCode);
                                    if (BUTTON_TYPE && UTILS.isStringAndNotEmpty(BUTTON_TYPE.buttonTypeImageUrl)) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Button type is detected and has a buttonTypeImageUrl. ' +
                                            'Proceeding to append the ID.me launcher button image...');
                                        launcherButtonDomElement.replaceChildren();
                                        const launcherButtonImageDomElement = document.createElement('img');
                                        launcherButtonImageDomElement.src = BUTTON_TYPE.buttonTypeImageUrl;
                                        launcherButtonImageDomElement.alt = BUTTON_TYPE.buttonTypeDescription || 'ID.me verification button';
                                        launcherButtonImageDomElement.setAttribute('data-button-type-code', buttonTypeCode);
                                        launcherButtonDomElement.appendChild(launcherButtonImageDomElement);
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully appended ID.me launcher button image ' +
                                            'with src -> ' + BUTTON_TYPE.buttonTypeImageUrl + ' for buttonTypeCode -> ' + buttonTypeCode);
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to resolve buttonTypeImageUrl for buttonTypeCode -> ' +
                                            buttonTypeCode);
                                    }
                                    launcherButtonDomElement.idMeLauncherButtonConfig = idMeLauncherButtonConfig;
                                    launcherButtonDomElement.setAttribute('data-scope', dataScope);
                                    launcherButtonDomElement.setAttribute('data-client-id', idMeLauncherButtonConfig.dataClientId);
                                    launcherButtonDomElement.setAttribute('data-redirect', idMeLauncherButtonConfig.dataRedirectUri);
                                    launcherButtonDomElement.setAttribute('data-response', idMeLauncherButtonConfig.dataResponseType);
                                    launcherButtonDomElement.setAttribute('data-text', idMeLauncherButtonConfig.dataText);
                                    launcherButtonDomElement.setAttribute('data-display', idMeLauncherButtonConfig.dataDisplay);
                                    launcherButtonDomElement.setAttribute('data-show-verify', idMeLauncherButtonConfig.dataShowVerify);
                                    GUEST_IDENTITY_CONTROLLER.attachIdMeLauncherButtonClickedEventListener(launcherButtonDomElement);
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully created ID.me launcher button element ' + 
                                        'with buttonId -> ' + buttonId + ' and dataScope -> ' + dataScope + ' and buttonTypeCode -> ' + buttonTypeCode + '...');
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect DOM element with id -> ' + buttonId);
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button configuration is not initialized. ' +
                                    'Cannot proceed to create the ID.me launcher button element.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button configuration is not detected in the ' +
                                'guestIdentity model. Cannot proceed to create the ID.me launcher button element.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Data scope or button ID is not a valid string.');
                    }
                    return launcherButtonDomElement;
                },
                initIdMeLauncherButtons: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'API_INIT_ID_ME_LAUNCHER_BUTTONS_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Initializing ID.me launcher buttons...');
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    await GUEST_IDENTITY_CONTROLLER.loadIdMeSdkScript();
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me JS SDK script loaded successfully, now calling window.BindIDme() ' + 
                        'function to initialize ID.me launcher buttons...');
                    window.BindIDme();
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Called window.BindIDme() function successfully!');
                }
            },
            view: {
                displayAffiliations: async function(targetDomElementId) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'VIEW_DISPLAY_AFFILIATIONS_';
                    // TODO: Implement the view display affiliations functionality.  
                    // Create a handler method for each affiliation type in order 
                    // to handle affiliation specific logical variations in a graceful 
                    // and extensible manner.
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Displaying affiliations...');
                    wdprProfileNav.features.guestIdentity.view.affiliations.displayAffiliations(targetDomElementId);
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Display affiliations processing completed.');
                }
            }
        },
        travelAgent: {
            getTravelAgent: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_IS_TRAVEL_AGENT_CONTEXT_DETECTED_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the travel agent context is detected...');
                let isTravelAgentContextDetected = false;
                let travelAgent = null;
                const TRAVEL_AGENT_MODEL = wdprProfileNav.main.model.travelAgent;
                if (TRAVEL_AGENT_MODEL) {
                    await wdprProfileNav.main.detectTravelAgentProcessingComplete();
                    if (TRAVEL_AGENT_MODEL.isTravelAgentDataReady) {
                        if (TRAVEL_AGENT_MODEL.guestProfile.isSwidDetected) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent is detected and has specified a ' + 
                                'guest swid.  The guest swid is -> ' + TRAVEL_AGENT_MODEL.guestProfile.swid);
                            if (TRAVEL_AGENT_MODEL.guestProfile.isSwidProcessingComplete) {
                                travelAgent = structuredClone(TRAVEL_AGENT_MODEL);
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent data model is with guest ' + 
                                    'profile and guest affiliations data is ready. Returning travel agent data...');
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Travel agent model is not available.');
                            }
                        } else {
                            travelAgent = structuredClone(TRAVEL_AGENT_MODEL);
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent has not specified a swid and thus ' + 
                                'NO guest profile and guest affiliations data is available.');
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Travel agent data model is not ready. Returning null.');
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Travel agent data model is null. Returning null.');
                }
                return travelAgent;
            },
            isLoggedIn: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_IS_TRAVEL_AGENT_CONTEXT_DETECTED_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the travel agent context is detected...');
                let isTravelAgentContextDetected = false;
                const TRAVEL_AGENT_MODEL = await wdprProfileNav.api.travelAgent.getTravelAgent();
                if (TRAVEL_AGENT_MODEL) {
                    isTravelAgentContextDetected = TRAVEL_AGENT_MODEL.isTravelAgentContextDetected;
                }
                return isTravelAgentContextDetected;
            },
            hasTravelAgentGuestSwid: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_HAS_TRAVEL_AGENT_GUEST_SWID_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the travel agent has a guest swid...');
                let hasTravelAgentGuestSwid = false;
                const TRAVEL_AGENT_MODEL = await wdprProfileNav.api.travelAgent.getTravelAgent();
                if (TRAVEL_AGENT_MODEL) {
                    if (TRAVEL_AGENT_MODEL.guestProfile) {
                        hasTravelAgentGuestSwid = TRAVEL_AGENT_MODEL.guestProfile.isSwidDetected;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent guest swid is detected. Returning true.');
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect travel agent guest swid as the guest profile is not detected.');
                    }
                }
                return hasTravelAgentGuestSwid;
            },
            getTravelAgentGuestSwid: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_GET_TRAVEL_AGENT_GUEST_SWID_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting the travel agent guest swid...');
                let travelAgentGuestSwid = null;
                const TRAVEL_AGENT_MODEL = await wdprProfileNav.api.travelAgent.getTravelAgent();
                if (TRAVEL_AGENT_MODEL) {
                    if (TRAVEL_AGENT_MODEL.guestProfile) {
                        let hasTravelAgentGuestSwid = TRAVEL_AGENT_MODEL.guestProfile.isSwidDetected;
                        if (hasTravelAgentGuestSwid) {
                            travelAgentGuestSwid = structuredClone(TRAVEL_AGENT_MODEL.guestProfile.swid);
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent guest swid is detected.  Returning the guest swid -> ' + travelAgentGuestSwid);
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect travel agent guest swid as the guest profile is not detected.  ' + 
                                'NOTE: The guest profile may not have been requested by the travel agent thus no guest swid is available.  Returning null.');
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect travel agent guest swid as the guest profile is not detected.  ' + 
                            'NOTE: The guest profile may not have been requested by the travel agent thus no guest swid is available.  Returning null.');
                    }
                }
                return travelAgentGuestSwid;
            },
            getTravelAgentGuestProfileByEmailAndLastName: async function(emailAddress, lastName) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_GET_TRAVEL_AGENT_GUEST_PROFILE_BY_EMAIL_AND_LAST_NAME_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting the travel agent guest profile...');
                const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                GUEST_IDENTITY_CONTROLLER.resetTravelAgentGuestProfile();
                const TRAVEL_AGENT_MODEL = wdprProfileNav.main.model.travelAgent;
                let travelAgentGuestProfile = null;
                const IS_TRAVEL_AGENT_LOGGED_IN = await wdprProfileNav.api.travelAgent.isLoggedIn();
                if (IS_TRAVEL_AGENT_LOGGED_IN) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent is logged in. Proceeding to get the travel agent guest profile...');
                    const TRAVEL_AGENT = await wdprProfileNav.api.travelAgent.getTravelAgent();
                    if (TRAVEL_AGENT_MODEL) {
                        const TRAVEL_AGENT_GUEST_PROFILE = 
                            await GUEST_IDENTITY_CONTROLLER.getTravelAgentGuestProfile(emailAddress, lastName);
                        travelAgentGuestProfile = structuredClone(TRAVEL_AGENT_MODEL.guestProfile);
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect travel agent guest profile as the guest profile is not detected.');
                    }
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Travel agent is not logged in. Returning null.');
                }
                return travelAgentGuestProfile;
            },
            getTravelAgentGuestAffiliations: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_GET_TRAVEL_AGENT_GUEST_AFFILIATIONS_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting the travel agent guest affiliations...');
                let travelAgentGuestAffiliations = null;
                const IS_TRAVEL_AGENT_LOGGED_IN = await wdprProfileNav.api.travelAgent.isLoggedIn();
                if (IS_TRAVEL_AGENT_LOGGED_IN) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent is logged in. Proceeding to get the travel agent guest affiliations...');
                    const TRAVEL_AGENT_GUEST_PROFILE_MODEL = await wdprProfileNav.api.travelAgent.getTravelAgentGuestProfile();
                    if (TRAVEL_AGENT_GUEST_PROFILE_MODEL) {
                        if (TRAVEL_AGENT_GUEST_PROFILE_MODEL.isProfileDataReady) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent guest profile model is ready. Checking if the guest has affiliations...');
                            const TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS = TRAVEL_AGENT_GUEST_PROFILE_MODEL.affiliations;
                            if (TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS) {
                                const TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS_ENTRIES = TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS.entries;
                                if (TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS_ENTRIES) {
                                    travelAgentGuestAffiliations = structuredClone(TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS_ENTRIES);
                                } else {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect travel agent guest profile affiliations as the affiliations array is not a valid array.');
                                }
                            } else {
                                console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect travel agent guest profile affiliations as the affiliations array is not detected.');
                            }
                            travelAgentGuestAffiliations = structuredClone(TRAVEL_AGENT_GUEST_PROFILE_MODEL.affiliations);
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Travel agent guest profile model is not ready as the travel agent has not yet ' + 
                                'requested a guest profile thus no guest profile data is available.  Returning null as the travel agent guest affiliations ' + 
                                'are not available.');
                        }
                    }
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Travel agent is not logged in. Returning null.');
                }
                return travelAgentGuestAffiliations;
            },
            getTravelAgentGuestProfile: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_GET_TRAVEL_AGENT_GUEST_PROFILE_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting the travel agent guest profile...');
                const TRAVEL_AGENT_GUEST_PROFILE = wdprProfileNav.main.model.travelAgent.guestProfile;
                return TRAVEL_AGENT_GUEST_PROFILE;
            },
            hasMilitaryAffiliation: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'API_TRAVEL_AGENT_GUEST_HAS_MILITARY_AFFILIATION_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the guest has a military affiliation...');
                let hasMilitaryAffiliation = false;
                const IS_TRAVEL_AGENT_LOGGED_IN = await wdprProfileNav.api.travelAgent.isLoggedIn();
                if (IS_TRAVEL_AGENT_LOGGED_IN) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent is logged in. Proceeding to check if the guest has a military affiliation...');
                    const TRAVEL_AGENT_GUEST_PROFILE = wdprProfileNav.main.model.travelAgent.guestProfile;
                    if (TRAVEL_AGENT_GUEST_PROFILE) {
                        if (TRAVEL_AGENT_GUEST_PROFILE.isGuestAffiliationsReady) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest affiliations model is ready. Checking if the guest ' +
                                'has a military affiliation...');
                            hasMilitaryAffiliation = TRAVEL_AGENT_GUEST_PROFILE.affiliationInfo.isMilitary;
                            if (hasMilitaryAffiliation) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest has a military affiliation. Returning true.');
                            } else {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest does not have a military affiliation. Returning false.');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Guest affiliations model is not ready as the travel agent has not yet requested a guest profile thus no guest affiliations data is available. Returning false.');
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Guest profile model is null as the travel agent has not yet requested a guest profile thus no guest profile data is available.  Returning false.');
                    }
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Travel agent is not logged in. Returning false.');
                }
                return hasMilitaryAffiliation;
            },
            hasFloridaResidentAffiliation: async function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 
                'API_HAS_FLORIDA_RESIDENT_AFFILIATION_';
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if the guest has a Florida resident affiliation...');
                let hasFloridaResidentAffiliation = false;
                const IS_TRAVEL_AGENT_LOGGED_IN = await wdprProfileNav.api.travelAgent.isLoggedIn();
                if (IS_TRAVEL_AGENT_LOGGED_IN) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent is logged in. Proceeding to check if the guest has a Florida resident affiliation...');
                    const TRAVEL_AGENT_GUEST_PROFILE = wdprProfileNav.main.model.travelAgent.guestProfile;
                    if (TRAVEL_AGENT_GUEST_PROFILE) {
                        if (TRAVEL_AGENT_GUEST_PROFILE.isGuestAffiliationsReady) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest affiliations model is ready. Checking if the guest ' +
                                'has a Florida resident affiliation...');
                            hasFloridaResidentAffiliation = TRAVEL_AGENT_GUEST_PROFILE.affiliationInfo.isFloridaResident;
                            if (hasFloridaResidentAffiliation) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest has a Florida resident affiliation. Returning true.');
                            } else {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest does not have a Florida resident affiliation. Returning false.');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Guest affiliations model is not ready as the travel agent has not yet requested a guest profile thus no guest affiliations data is available. Returning false.');
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Guest profile model is null as the travel agent has not yet requested a guest profile thus no guest profile data is available.  Returning false.');
                    }
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Travel agent is not logged in. Returning false.');
                }
                return hasFloridaResidentAffiliation;
            },
        }
    }
};

window.wdprProfileNav = wdprProfileNav;
wdprProfileNav.main.init();

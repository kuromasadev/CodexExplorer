                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect the window.identity JS object with attempt count ' +
                                        wdprProfileNav.features.ewcs.model.oneIdv5IdentityDetectionAttemptCount + ' of ' +
                                        PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                        ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                        'Stopping further detection attempts.');
                            clearInterval(ONE_IDV5_IDENTITY_DETECTOR_INTERVAL);
                            wdprProfileNav.features.ewcs.model.oneIdv5IdentityDetectionAttemptCount = 0;
                        }
                    }, PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS);
                },
                getGuestInfoFromPepProfileAuth: async function(pepProfileAuth) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_PROCESS_PEP_PROFILE_AUTH_';
                    const GUEST_INFO = wdprProfileNav.features.ewcs.model.guestInfo;
                    if (pepProfileAuth) {
                        if (pepProfileAuth.isInitialized) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing PEP.PROFILE_AUTH JS object that is initialized. ' +
                                'Initializing EWCS related logic that depends on PEP.PROFILE_AUTH initialization...');
                            // Initialize EWCS related logic that depends on PEP.PROFILE_AUTH here
                            let isGuestLoggedIn = await pepProfileAuth.getLoggedInStatus();
                            if (isGuestLoggedIn) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is logged in. ' +
                                    'Retrieving guest profile information from PEP.PROFILE_AUTH...');
                                let profileAuthGuest = await pepProfileAuth.getGuest();
                                if (profileAuthGuest) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved guest profile ' +
                                        'information from PEP.PROFILE_AUTH with the following data: ' +
                                        JSON.stringify(profileAuthGuest));
                                    wdprProfileNav.main.model.profileAuthGuest = profileAuthGuest;
                                    const GUEST_TOKEN_INFO = profileAuthGuest.token;
                                    const GUEST_ACCESS_TOKEN = GUEST_TOKEN_INFO.access_token;
                                    const GUEST_SWID = GUEST_TOKEN_INFO.swid;
                                    const DECODED_GUEST_ACCESS_TOKEN = wdprProfileNav.main.utils.decodeJWT(GUEST_ACCESS_TOKEN);
                                    if (DECODED_GUEST_ACCESS_TOKEN) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully decoded guest access token retrieved from ' +
                                            'PEP.PROFILE_AUTH with the following decoded value: ' +
                                            JSON.stringify(DECODED_GUEST_ACCESS_TOKEN));
                                        const GUEST_CLIENT_ID = DECODED_GUEST_ACCESS_TOKEN.payload.client_id;
                                        if (GUEST_CLIENT_ID) {
                                            wdprProfileNav.features.ewcs.model.guestInfo.guestAccessToken = GUEST_ACCESS_TOKEN;
                                            wdprProfileNav.features.ewcs.model.guestInfo.guestSwid = GUEST_SWID;
                                            wdprProfileNav.features.ewcs.model.guestInfo.guestClientId = GUEST_CLIENT_ID;
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> GUEST_ACCESS_TOKEN retrieved from PEP.PROFILE_AUTH: \"' +
                                                GUEST_ACCESS_TOKEN + '\"');
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> GUEST_SWID retrieved from PEP.PROFILE_AUTH: \"' +
                                                GUEST_SWID + '\"');
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> GUEST_CLIENT_ID retrieved guest client id from decoded guest ' +
                                                'access token payload with the following value: \"' +
                                                GUEST_CLIENT_ID + '\"');
                                        } else {
                                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> GUEST_CLIENT_ID is null or undefined. ' +
                                                'client_id field is not included in the payload of the decoded guest access token. ' +
                                                'Decoded guest access token payload is: ' + JSON.stringify(DECODED_GUEST_ACCESS_TOKEN.payload));
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to decode guest access token retrieved from PEP.PROFILE_AUTH. ' +
                                            'Guest access token value is: \"' + GUEST_ACCESS_TOKEN + '\"');
                                    }
                                } else {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to retrieve guest profile information ' +
                                        'from PEP.PROFILE_AUTH profileAuthGuest value is null.');
                                }
                            } else {
                                GUEST_INFO.isAnonymous = true;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is NOT logged in. ' +
                                    'Setting guestInfo.isAnonymous to true.');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Processing PEP.PROFILE_AUTH JS object that is not initialized. ' +
                                'EWCS related logic that depends on PEP.PROFILE_AUTH initialization will not be initialized.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Processing of PEP.PROFILE_AUTH JS object failed as it is not detected. ' +
                            'EWCS related logic that depends on PEP.PROFILE_AUTH will not be initialized.');
                    }
                    wdprProfileNav.features.ewcs.model.guestInfo.isGuestInfoOneIdProcessingComplete = true;
                    return GUEST_INFO;
                },
                getGuestInfoFromOneIdv5Identity: async function(oneIdv5Identity) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_PROCESS_ONE_IDV5_IDENTITY_';
                    const GUEST_INFO = wdprProfileNav.features.ewcs.model.guestInfo;
                    if (oneIdv5Identity) {
                        if (oneIdv5Identity.initialized) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing window.WebSDK JS object that is initialized. ' +
                                'Initializing EWCS related logic that depends on window.WebSDK initialization...');
                            // Initialize EWCS related logic that depends on window.identity here
                            let isGuestLoggedIn = await oneIdv5Identity.isLoggedIn();
                            if (isGuestLoggedIn) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is logged in. ' +
                                    'Retrieving guest profile information from window.WebSDK...');
                                const ONE_IDV5_IDENTITY_GUEST = await oneIdv5Identity.getGuest();
                                if (ONE_IDV5_IDENTITY_GUEST) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved guest profile ' +
                                        'information from window.WebSDK with the following data: ' +
                                        JSON.stringify(ONE_IDV5_IDENTITY_GUEST));
                                    if (ONE_IDV5_IDENTITY_GUEST.data.oneIdGuest) {
                                        let profileAuthGuest = ONE_IDV5_IDENTITY_GUEST.data.oneIdGuest;
                                        const GUEST_TOKEN_INFO = await oneIdv5Identity.getToken();
                                        const GUEST_SWID = profileAuthGuest.profile.swid;
                                        profileAuthGuest.token = GUEST_TOKEN_INFO;
                                        profileAuthGuest.token.swid = GUEST_SWID;
                                        wdprProfileNav.main.model.profileAuthGuest = profileAuthGuest;
                                        const GUEST_ACCESS_TOKEN = GUEST_TOKEN_INFO.access_token;
                                        const DECODED_GUEST_ACCESS_TOKEN = wdprProfileNav.main.utils.decodeJWT(GUEST_ACCESS_TOKEN);
                                        if (DECODED_GUEST_ACCESS_TOKEN) {
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully decoded guest access token retrieved from ' +
                                                'window.WebSDK with the following decoded value: ' +
                                                JSON.stringify(DECODED_GUEST_ACCESS_TOKEN));
                                            const GUEST_CLIENT_ID = DECODED_GUEST_ACCESS_TOKEN.payload.client_id;
                                            if (GUEST_CLIENT_ID) {
                                                GUEST_INFO.guestAccessToken = GUEST_ACCESS_TOKEN;
                                                GUEST_INFO.guestSwid = GUEST_SWID;
                                                GUEST_INFO.guestClientId = GUEST_CLIENT_ID;
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> GUEST_ACCESS_TOKEN retrieved from window.WebSDK: \"' +
                                                    GUEST_ACCESS_TOKEN + '\"');
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> GUEST_SWID retrieved from window.WebSDK: \"' +
                                                    GUEST_SWID + '\"');
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> GUEST_CLIENT_ID retrieved guest client id from decoded guest ' +
                                                    'access token payload with the following value: \"' +
                                                    GUEST_CLIENT_ID + '\"');
                                            } else {
                                                console.warn(LOG_MESSAGE_PREFIX + 'WARN -> GUEST_CLIENT_ID is null or undefined. ' +
                                                    'client_id field is not included in the payload of the decoded guest access token. ' +
                                                    'Decoded guest access token payload is: ' + JSON.stringify(DECODED_GUEST_ACCESS_TOKEN.payload));
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to decode guest access token retrieved from window.WebSDK. ' +
                                                'Guest access token value is: \"' + GUEST_ACCESS_TOKEN + '\"');
                                        }
                                    }
                                } else {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to retrieve guest profile information ' +
                                        'from window.WebSDK ONE_IDV5_IDENTITY_GUEST value is null.');
                                }
                            } else {
                                GUEST_INFO.isAnonymous = true;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is NOT logged in. ' +
                                    'Setting guestInfo.isAnonymous to true.');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Processing window.WebSDK JS object that is not initialized. ' +
                                'EWCS related logic that depends on window.identity initialization will not be initialized.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Processing of PEP.PROFILE_AUTH JS object failed as it is not detected. ' +
                            'EWCS related logic that depends on window.WebSDK will not be initialized.');
                    }
                    wdprProfileNav.features.ewcs.model.guestInfo.isGuestInfoOneIdProcessingComplete = true;
                    return GUEST_INFO;
                },
                processGuestInfoAndInitializeOneTrustSDK: async function(guestInfo) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_PROCESS_GUEST_INFO_';
                    const EWCS_CONTROLLER = wdprProfileNav.features.ewcs.controller;
                    if (guestInfo) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing guest information retrieved from PEP.PROFILE_AUTH with the following data: ' +
                            JSON.stringify(guestInfo));
                        if (!guestInfo.isAnonymous) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing for non-anonymous guest...');
                            const ONE_TRUST_TOKEN = await EWCS_CONTROLLER.getOneTrustToken(guestInfo);
                            if (ONE_TRUST_TOKEN) {
                                wdprProfileNav.features.ewcs.model.guestInfo.guestOneTrustToken = ONE_TRUST_TOKEN;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved OneTrust token using guest information from PEP.PROFILE_AUTH. ' +
                                    'OneTrust token value is \"' + ONE_TRUST_TOKEN + '\". ' +
                                    'Now initializing the OneTrust SDK...');
                                EWCS_CONTROLLER.setOneTrustSDKInitCompleteEventListeners();
                                await EWCS_CONTROLLER.initializeOneTrustSDK(ONE_TRUST_TOKEN);
                                EWCS_CONTROLLER.detectOneTrustSDKFullInitComplete();
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to retrieve OneTrust token using guest ' +
                                    'information from PEP.PROFILE_AUTH. OneTrust token value is null. ' +
                                    'EWCS related logic that depends on the OneTrust token will not be initialized.');
                            }
                        } else {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing for anonymous guest...');
                            EWCS_CONTROLLER.setOneTrustSDKInitCompleteEventListeners();
                            await EWCS_CONTROLLER.initializeOneTrustSDKForAnonymousGuest();
                            EWCS_CONTROLLER.detectOneTrustSDKFullInitComplete();
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to process guest information as it is null.');
                    }
                },
                setOneTrustSDKInitCompleteEventListeners: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_INITIALIZE_ONETRUST_SDK_EVENT_LISTENERS_';
                    const GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME =
                        wdprProfileNav.features.ewcs.constants.events.GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME;
                    const ONETRUST_GROUPS_UPDATED_EVENT_NAME = 
                        wdprProfileNav.features.ewcs.constants.events.ONETRUST_GROUPS_UPDATED_EVENT_NAME;
                    window.addEventListener(ONETRUST_GROUPS_UPDATED_EVENT_NAME, 
                        wdprProfileNav.features.ewcs.controller.eventListeners.processOneTrustSDKOneTrustGroupsUpdatedListener);
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully set event listener for the ' +
                        ONETRUST_GROUPS_UPDATED_EVENT_NAME + ' event.');
                    window.addEventListener(GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME, 
                        wdprProfileNav.features.ewcs.controller.eventListeners.processGuestProfileOneTrustSdkInitCompleteListener);
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully set event listener for the ' +
                        GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME + ' event.');
                },
                initializeOneTrustSDK: async function(oneTrustToken) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_INITIALIZE_ONETRUST_SDK_';
                    const ONE_TRUST_TOKEN = wdprProfileNav.features.ewcs.model.guestInfo.guestOneTrustToken;
                    const ONE_TRUST_TOKEN_IDENTIFIER_TYPE = wdprProfileNav.features.ewcs.model.guestInfo.guestOneTrustTokenIdentifierType;
                    let isOneTrustTokenValid = true;
                    if (oneTrustToken) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Initializing OneTrust SDK with the following token: ' + oneTrustToken);
                        // Initialize OneTrust SDK here by loading the OneTrust script and passing the ONE_TRUST_TOKEN as needed by the OneTrust SDK
                        const ONE_TRUST_TOKEN_DECODED = wdprProfileNav.main.utils.decodeJWT(ONE_TRUST_TOKEN);
                        if (ONE_TRUST_TOKEN_DECODED) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully decoded OneTrust token with the following decoded value: ' +
                                JSON.stringify(ONE_TRUST_TOKEN_DECODED));
                            if (ONE_TRUST_TOKEN_DECODED.payload) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust token payload: ' + JSON.stringify(ONE_TRUST_TOKEN_DECODED.payload));
                                if (ONE_TRUST_TOKEN_DECODED.payload.sub) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust token payload "sub" field value: \"' +
                                        ONE_TRUST_TOKEN_DECODED.payload.sub + '\"');
                                    if (ONE_TRUST_TOKEN_IDENTIFIER_TYPE) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust token identifier type present with the following value: \"' +
                                            ONE_TRUST_TOKEN_IDENTIFIER_TYPE + '\"');
                                        wdprProfileNav.features.ewcs.model.guestInfo.guestOneTrustTokenId =
                                            ONE_TRUST_TOKEN_DECODED.payload.sub;
                                        const ONE_TRUST_SDK_CONFIG = wdprProfileNav.features.ewcs.model.oneTrust.oneTrustSdkConfig;
                                        const EWCS_GUEST_INFO = wdprProfileNav.features.ewcs.model.guestInfo;
                                        ONE_TRUST_SDK_CONFIG.dataSubjectParams.id =
                                            EWCS_GUEST_INFO.guestOneTrustTokenId;
                                        ONE_TRUST_SDK_CONFIG.dataSubjectParams.identifierType =
                                            EWCS_GUEST_INFO.guestOneTrustTokenIdentifierType;
                                        ONE_TRUST_SDK_CONFIG.dataSubjectParams.token = ONE_TRUST_TOKEN;
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Updated base OneTrust SDK config dataSubjectParams with OneTrust ' +
                                            'token id, identifierType and token values retrieved from decoded OneTrust token payload. ' +
                                            'Updated base OneTrust SDK config is: ' + JSON.stringify(ONE_TRUST_SDK_CONFIG));
                                        window.OneTrust = ONE_TRUST_SDK_CONFIG;
                                        const MODEL_ONETRUST = wdprProfileNav.features.ewcs.model.oneTrust;
                                        MODEL_ONETRUST.isOneTrustConfigCreationComplete = true;
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Set global window.OneTrust object with the base OneTrust SDK config ' +
                                            'that includes the OneTrust token id, identifierType and token values retrieved from decoded OneTrust token ' +
                                            'payload for EWCS feature initialization. ' +
                                            'window.OneTrust value is: ' + JSON.stringify(window.OneTrust));
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'WARN -> OneTrust token data does not contain an identifierType field. ' +
                                            'OneTrust token payload is: ' + JSON.stringify(ONE_TRUST_TOKEN_DECODED.payload));
                                        isOneTrustTokenValid = false;
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> OneTrust token payload does not contain a "sub" field. ' +
                                        'OneTrust token payload is: ' + JSON.stringify(ONE_TRUST_TOKEN_DECODED.payload));
                                    isOneTrustTokenValid = false;
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Decoded OneTrust token does not contain a payload. ' +
                                    'Decoded OneTrust token is: ' + JSON.stringify(ONE_TRUST_TOKEN_DECODED));
                                isOneTrustTokenValid = false;
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to decode OneTrust token. ' +
                                'OneTrust token value is: \"' + ONE_TRUST_TOKEN + '\"');
                            isOneTrustTokenValid = false;
                        }
                        wdprProfileNav.features.ewcs.model.guestInfo.isOneTrustTokenValid = isOneTrustTokenValid;
                        if (isOneTrustTokenValid) {
                            try {
                                await wdprProfileNav.features.ewcs.controller.loadOneTrustSDKScript();
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust SDK initialized successfully for EWCS feature. :-)');
                            } catch (error) {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to initialize OneTrust SDK for EWCS feature: ' + error.message);
                            }
                            wdprProfileNav.features.ewcs.controller.initializeDomElementEventHandlers();
                        } else {
                            const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN =
                                wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN;
                            const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS =
                                wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS;
                            const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE =
                                wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE;
                            localStorage.removeItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN);
                            localStorage.removeItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS);
                            localStorage.removeItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE);
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> OneTrust token is invalid. ' +
                                'Removed OneTrust token and its timestamp and identifier type from local storage to prevent ' +
                                'future use of the invalid token.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to initialize OneTrust SDK as the token is null.');
                    }
                },
                initializeOneTrustSDKForAnonymousGuest: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_INITIALIZE_ONETRUST_SDK_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing init of OneTrust SDK for anonymous guest ' +
                        'without guestInfo or a OneTrust JWT token respectively...');
                    const ONE_TRUST_SDK_CONFIG = wdprProfileNav.features.ewcs.model.oneTrust.oneTrustSdkConfig;
                    ONE_TRUST_SDK_CONFIG.dataSubjectParams.id = null;
                    ONE_TRUST_SDK_CONFIG.dataSubjectParams.identifierType = null;
                    ONE_TRUST_SDK_CONFIG.dataSubjectParams.token = null;
                    ONE_TRUST_SDK_CONFIG.dataSubjectParams.isAnonymous = true;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Updated base OneTrust SDK config dataSubjectParams with OneTrust ' +
                        'token id set to null, identifierType and token values also set to null, and isAnonymous set to true ' +
                        'for this anonymous guest.  Updated base OneTrust SDK config is -> ' + JSON.stringify(ONE_TRUST_SDK_CONFIG));
                    window.OneTrust = ONE_TRUST_SDK_CONFIG;
                    const MODEL_ONETRUST = wdprProfileNav.features.ewcs.model.oneTrust;
                    MODEL_ONETRUST.isOneTrustConfigCreationComplete = true;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Set global window.OneTrust object with the base OneTrust SDK config ' +
                        'that includes the OneTrust token id, identifierType and token values retrieved from decoded OneTrust token ' +
                        'payload for EWCS feature initialization. ' +
                        'window.OneTrust value is -> ' + JSON.stringify(window.OneTrust));
                    try {
                        await wdprProfileNav.features.ewcs.controller.loadOneTrustSDKScript();
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust SDK initialized successfully for the EWCS feature and ' +
                            'the anonymous guest. :-)');
                    } catch (error) {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to initialize OneTrust SDK for EWCS feature: ' +
                            error.message);
                    }
                    wdprProfileNav.features.ewcs.controller.initializeDomElementEventHandlers();
                },
                getOneTrustJsSdkUrl: function(oneTrustJsDataDomain, oneTrustJsSdkUrl) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_SET_ONETRUST_DATA_DOMAIN_FOR_JS_SDK_URL_';
                    const UTILS = wdprProfileNav.main.utils;
                    let formattedOneTrustJsSdkUrl = null;
                    const ONETRUST_JS_SDK_URL_DATA_DOMAIN_PARSE_TARGET =
                        wdprProfileNav.features.ewcs.constants.oneTrust.ONETRUST_JS_SDK_URL_DATA_DOMAIN_PARSE_TARGET;
                    if (UTILS.isStringAndNotEmpty(oneTrustJsDataDomain)) {
                        if (UTILS.isStringAndNotEmpty(oneTrustJsSdkUrl)) {
                            if (UTILS.isStringAndNotEmpty(ONETRUST_JS_SDK_URL_DATA_DOMAIN_PARSE_TARGET)) {
                                formattedOneTrustJsSdkUrl =
                                    oneTrustJsSdkUrl.replace(ONETRUST_JS_SDK_URL_DATA_DOMAIN_PARSE_TARGET, oneTrustJsDataDomain);
                                console.log(LOG_MESSAGE_PREFIX +
                                    'INFO -> Successfully set formattedOneTrustJsSdkUrl to the following -> ' +
                                        formattedOneTrustJsSdkUrl);
                            } else {
                                console.error(LOG_MESSAGE_PREFIX +
                                    'ERROR -> Unable to set the formattedOneTrustJsSdkUrl as the ' +
                                        'ONETRUST_JS_SDK_URL_DATA_DOMAIN_PARSE_TARGET is not a valid string.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to set the formattedOneTrustJsSdkUrl as the ' +
                                'oneTrustJsSdkUrl is not a valid string.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to set the formattedOneTrustJsSdkUrl as the ' +
                            'oneTrustJsDataDomain is not a valid string.');
                    }
                    return formattedOneTrustJsSdkUrl;
                },
                loadOneTrustSDKScript: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_LOAD_ONETRUST_SCRIPT_';
                    const UTILS = wdprProfileNav.main.utils;
                    const ONETRUST_JS_SDK_URL = wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.oneTrustJsSdkUrl;
                    const ONETRUST_JS_DATA_DOMAIN = wdprProfileNav.features.ewcs.controller.getOneTrustSDKBrandCodeRelatedDataDomain();
                    let formattedOneTrustJsSdkUrl = null;
                    return new Promise((resolve, reject) => {
                        let isAllDataRequiredForOneTrustScriptLoadPresent = true;
                        if (ONETRUST_JS_DATA_DOMAIN) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust JS Data Domain for EWCS feature is \"' + ONETRUST_JS_DATA_DOMAIN +
                                '\" based on the provided configuration.');
                            if (ONETRUST_JS_SDK_URL) {
                                formattedOneTrustJsSdkUrl =
                                    wdprProfileNav.features.ewcs.controller.getOneTrustJsSdkUrl(ONETRUST_JS_DATA_DOMAIN, ONETRUST_JS_SDK_URL);
                                if (UTILS.isStringAndNotEmpty(formattedOneTrustJsSdkUrl)) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust JS SDK URL for EWCS feature is \"' + formattedOneTrustJsSdkUrl +
                                        '\" based on the provided configuration.');
                                } else {
                                    isAllDataRequiredForOneTrustScriptLoadPresent = false;
                                    formattedOneTrustJsSdkUrl = null;
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to set the OneTrust JS SDK URL for EWCS feature as the ' +
                                        'formattedOneTrustJsSdkUrl is not a valid string');
                                }
                            } else {
                                isAllDataRequiredForOneTrustScriptLoadPresent = false;
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> OneTrust JS SDK URL for EWCS feature is null or undefined based ' +
                                    'on the provided configuration. ' +
                                    'Attempting to load OneTrust script without a src URL will likely fail.');
                            }
                        } else {
                            isAllDataRequiredForOneTrustScriptLoadPresent = false;
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> OneTrust JS Data Domain for EWCS feature is null or undefined based ' +
                                'on the provided configuration.');
                        }
                        if (isAllDataRequiredForOneTrustScriptLoadPresent) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> All required data for loading OneTrust script for EWCS feature is present. ' +
                                'formattedOneTrustJsSdkUrl -> \"' + formattedOneTrustJsSdkUrl + '\"' +
                                '\rONETRUST_JS_DATA_DOMAIN -> \"' + ONETRUST_JS_DATA_DOMAIN + '\". ' +
                                '\rProceeding to load OneTrust script by adding a script tag to the document head with the appropriate attributes ' +
                                'needed for OneTrust SDK initialization...');
                            const ONETRUST_SDK_SCRIPT_DOM_ELEMENT = document.createElement('script');
                            ONETRUST_SDK_SCRIPT_DOM_ELEMENT.src = formattedOneTrustJsSdkUrl;
                            ONETRUST_SDK_SCRIPT_DOM_ELEMENT.setAttribute('data-document-language', 'true');
                            ONETRUST_SDK_SCRIPT_DOM_ELEMENT.setAttribute('type', 'text/javascript');
                            ONETRUST_SDK_SCRIPT_DOM_ELEMENT.setAttribute('charset', 'UTF-8');
                            ONETRUST_SDK_SCRIPT_DOM_ELEMENT.setAttribute('data-domain-script', ONETRUST_JS_DATA_DOMAIN);
                            ONETRUST_SDK_SCRIPT_DOM_ELEMENT.onload = () => {
                                const MODEL_ONETRUST = wdprProfileNav.features.ewcs.model.oneTrust;
                                MODEL_ONETRUST.isOneTrustSdkScriptLoadComplete = true;
                                MODEL_ONETRUST.oneTrustJsDataDomain = ONETRUST_JS_DATA_DOMAIN;
                                MODEL_ONETRUST.oneTrustJsSdkUrl = formattedOneTrustJsSdkUrl;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrustSDK script loaded successfully! :-)' +
                                    '\n\oneTrustJsSdkUrl -> ' + formattedOneTrustJsSdkUrl +
                                    '\n\oneTrustJsDataDomain -> ' + ONETRUST_JS_DATA_DOMAIN +
                                    '\n\tOneTrust.dataSubjectParams -> ' + JSON.stringify(window.OneTrust.dataSubjectParams));
                                resolve();
                            };
                            ONETRUST_SDK_SCRIPT_DOM_ELEMENT.onerror = (error) => {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to load OneTrust script: ' + error);
                                reject(error);
                            };
                            document.head.appendChild(ONETRUST_SDK_SCRIPT_DOM_ELEMENT);
                        } else {
                            const ERROR_MESSAGE = 'Missing required data for loading OneTrust script for EWCS feature. ' +
                                'One or more of the following required data is missing: ONETRUST_JS_SDK_URL and or the ' +
                                'ONETRUST_JS_DATA_DOMAIN.  Please see prior error messages to confirm which is missing. ' +
                                '\rCannot load OneTrust script without all required data being present.';
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ' + ERROR_MESSAGE);
                            reject(new Error(ERROR_MESSAGE));
                        }
                    });
                },
                initializeDomElementEventHandlers: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_INITIALIZE_DOM_ELEMENT_EVENT_HANDLERS_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Initializing DOM element event handlers for EWCS feature...');
                    wdprProfileNav.features.ewcs.controller.detectFooterWithOneTrustLinkDomElements();
                },
                processDetectedDomElementsAndSetEventHandlers: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_PROCESS_DETECTED_DOM_ELEMENTS_AND_SET_EVENT_HANDLERS_';
                    const DOM_ELEMENTS = wdprProfileNav.features.ewcs.model.domElements;
                    if (DOM_ELEMENTS.isDomElementSearchSuccessful) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved DOM elements for footer with ' +
                            'OneTrust link and now setting event handlers as needed...');
                        if (DOM_ELEMENTS.oneTrustModalLinkElement) {
                            if (DOM_ELEMENTS.oneTrustModalLinkElement instanceof Element) {
                                if (DOM_ELEMENTS.oneTrustModalLinkElement.parentNode) {
                                    const CLONED_ONE_TRUST_MODAL_LINK_ELEMENT = DOM_ELEMENTS.oneTrustModalLinkElement.cloneNode(true);
                                    DOM_ELEMENTS.clonedOneTrustModalLinkElement = CLONED_ONE_TRUST_MODAL_LINK_ELEMENT;
                                    DOM_ELEMENTS.oneTrustModalLinkElement.parentNode.replaceChild(DOM_ELEMENTS.clonedOneTrustModalLinkElement,
                                        DOM_ELEMENTS.oneTrustModalLinkElement);
                                    DOM_ELEMENTS.clonedOneTrustModalLinkElement.addEventListener('click',
                                        wdprProfileNav.features.ewcs.controller.eventListeners.processOneTrustFooterLinkClickListener);
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully set the event handlers as needed to the ' +
                                        'OneTrust link in the footer! :-)');
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> DOM element for OneTrust modal link does not ' +
                                        'have a parentNode thus unable to set event handlers.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> DOM element for OneTrust modal link is not an instance ' +
                                    'of a DOM Element thus unable to set event handlers.');
                            }
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Failed to detect and retrieve DOM elements for footer with OneTrust ' +
                            'link thus vent handlers will not be set.');
                    }
                },
                getOneTrustSDKBrandCodeRelatedDataDomain: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_GET_ONETRUST_SDK_BRAND_CODE_RELATED_DATA_DOMAIN_';
                    const UTILS = wdprProfileNav.main.utils;
                    let oneTrustJsDataDomain = null;
                    let brandCode = null;
                    if (UTILS.isStringAndNotEmpty(wdprProfileNav.main.model.brandCode)) {
                        brandCode = wdprProfileNav.main.model.brandCode.toUpperCase();
                        const EWCS_CONFIG = wdprProfileNav.config.features.enterpriseWideConsentSyncConfig;
                        const ONE_TRUST_JS_DATA_DOMAIN_FOR_BRAND_CODE = EWCS_CONFIG[`oneTrustJsDataDomain${brandCode}`];
                        if (UTILS.isStringAndNotEmpty(ONE_TRUST_JS_DATA_DOMAIN_FOR_BRAND_CODE)) {
                            oneTrustJsDataDomain = ONE_TRUST_JS_DATA_DOMAIN_FOR_BRAND_CODE;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully determined OneTrust JS data domain for EWCS feature ' +
                                'based on brand code with the following value: \"' + oneTrustJsDataDomain + '\" for brand code \"' + brandCode + '\"');
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> No OneTrust JS data domain found for brand code \"' + brandCode +
                                '\".  Brand code must be part of the configuration for the EWCS feature.  ' +
                                'The current configuration for the EWCS feature is -> ' + JSON.stringify(EWCS_CONFIG));
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Brand code is not a valid string.  Brand code must be a valid string ' +
                            'and must be part of the configuration for the EWCS feature.  The current configuration for the EWCS feature is -> ' +
                            JSON.stringify(EWCS_CONFIG));
                    }
                    if (UTILS.isStringAndNotEmpty(oneTrustJsDataDomain)) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Determined OneTrust JS data domain for EWCS feature ' +
                            'based on brand code with the following value: \"' +
                            oneTrustJsDataDomain + '\" for brand code \"' + brandCode + '\"');
                    }
                    return oneTrustJsDataDomain;
                },
                getOneTrustTokenFromLocalStorage: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_GET_ONETRUST_TOKEN_FROM_LOCAL_STORAGE_';
                    let oneTrustToken = null;
                    const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN =
                        wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN;
                    const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS =
                        wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS;
                    const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE =
                        wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE;
                    const STORED_ONETRUST_TOKEN = localStorage.getItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN);
                    const STORED_ONETRUST_TOKEN_TIMESTAMP_MS = localStorage.getItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS);
                    const STORED_ONETRUST_TOKEN_IDENTIFIER_TYPE = localStorage.getItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE);
                    wdprProfileNav.features.ewcs.model.guestInfo.guestOneTrustTokenIdentifierType = STORED_ONETRUST_TOKEN_IDENTIFIER_TYPE;
                    if (STORED_ONETRUST_TOKEN && STORED_ONETRUST_TOKEN_TIMESTAMP_MS && STORED_ONETRUST_TOKEN_IDENTIFIER_TYPE) {
                        const TIME_NOW_MS = Date.now();
                        const ONE_TRUST_TOKEN_MAX_AGE_MS = wdprProfileNav.features.ewcs.model.oneTrustTokenMaxAgeMs;
                        if (TIME_NOW_MS - STORED_ONETRUST_TOKEN_TIMESTAMP_MS < ONE_TRUST_TOKEN_MAX_AGE_MS) {
                            oneTrustToken = STORED_ONETRUST_TOKEN;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Retrieved OneTrust token from local storage with the following value -> \"' +
                                oneTrustToken + '\". Token is still valid based on the configured max age for OneTrust token in EWCS feature.');
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> OneTrust token retrieved from local storage has expired based on the ' +
                                'configured max age for OneTrust token in EWCS feature.  ' +
                                'Stored OneTrust token value is \"' + STORED_ONETRUST_TOKEN + '\" and was stored at timestamp ' +
                                STORED_ONETRUST_TOKEN_TIMESTAMP_MS + '.  Current time is ' + TIME_NOW_MS + ' and max age for OneTrust token is ' +
                                ONE_TRUST_TOKEN_MAX_AGE_MS + 'ms.  Stored OneTrust token identifier type is \"' + STORED_ONETRUST_TOKEN_IDENTIFIER_TYPE +
                                    '\".  Now removing expired OneTrust token and its timestamp from local storage.');
                            localStorage.removeItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN);
                            localStorage.removeItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS);
                            localStorage.removeItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE);
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> No OneTrust token or timestamp or identifier type found in local storage with keys \"' +
                            LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN + '\" and \"' +
                            LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS + '\" and \"' +
                            LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE + '\" respectively.');
                    }
                    return oneTrustToken;
                },
                getOneTrustTokenFromOneIdEndpoint: async function(guestInfo) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_GET_ONETRUST_TOKEN_FROM_ONEID_ENDPOINT_';
                    let oneTrustToken = null;
                    if (guestInfo) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting OneTrust token by making a network request to the appropriate ' +
                            'endpoint using guest information retrieved from PEP.PROFILE_AUTH with the following data: ' +
                            JSON.stringify(guestInfo));
                        const ONEID_GRAPH_QL_ENDPOINT_URL =
                            wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.oneIdGraphQlEndpointUrl;
                        const CREATE_ONETRUST_TOKEN_QUERY_REQUEST_BODY =
                            wdprProfileNav.features.ewcs.constants.oneTrust.CREATE_ONETRUST_TOKEN_QUERY_REQUEST_BODY;
                        let createOneTrustTokenQueryRequestBody = JSON.parse(JSON.stringify(CREATE_ONETRUST_TOKEN_QUERY_REQUEST_BODY));
                        createOneTrustTokenQueryRequestBody.variables.input.swid = guestInfo.guestSwid;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Prepared request body for createOneTrustToken GraphQL query with the following data: ' +
                            JSON.stringify(createOneTrustTokenQueryRequestBody));
                        try {
                            const response = await fetch(ONEID_GRAPH_QL_ENDPOINT_URL, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': 'Bearer ' + guestInfo.guestAccessToken,
                                    'x-disney-identity-client-id': guestInfo.guestClientId
                                    },
                                body: JSON.stringify(createOneTrustTokenQueryRequestBody)
                            });
                            if (response.ok) {
                                const OK_RESPONSE_JSON = await response.json();
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully received a 200 OK response from fetch request to create ' +
                                    'OneTrust token with the following response and will inspect response for data ->', OK_RESPONSE_JSON);
                                if (OK_RESPONSE_JSON.data) {
                                    if (OK_RESPONSE_JSON.data.createOneTrustToken) {
                                        oneTrustToken = OK_RESPONSE_JSON.data.createOneTrustToken.oneTrustToken;
                                        const ONETRUST_IDENTIFIER_TYPE = OK_RESPONSE_JSON.data.createOneTrustToken.idType;
                                        if (oneTrustToken) {
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved OneTrust token from response of ' +
                                                'createOneTrustToken GraphQL query with the following value -> \"' +
                                                oneTrustToken + '\"');
                                            if (ONETRUST_IDENTIFIER_TYPE) {
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved OneTrust token identifier type from response of ' +
                                                    'createOneTrustToken GraphQL query with the following value -> \"' +
                                                    ONETRUST_IDENTIFIER_TYPE + '\"');
                                                wdprProfileNav.features.ewcs.model.guestInfo.guestOneTrustTokenIdentifierType = ONETRUST_IDENTIFIER_TYPE;
                                                const TIME_NOW_EPOCH_MS = Date.now();
                                                const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN =
                                                    wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN;
                                                const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP =
                                                    wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP_MS;
                                                const LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE =
                                                    wdprProfileNav.features.ewcs.constants.oneTrust.LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE;
                                                localStorage.setItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN, oneTrustToken);
                                                localStorage.setItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_TIMESTAMP, TIME_NOW_EPOCH_MS);
                                                localStorage.setItem(LOCAL_STORAGE_KEY_GUEST_PROFILE_ONETRUST_TOKEN_IDENTIFIER_TYPE, ONETRUST_IDENTIFIER_TYPE);
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> No OneTrust token identifier type found in response of ' +
                                                    'createOneTrustToken GraphQL query JSON response payload.  "idType" JSON field in response is null or undefined.');
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> createOneTrustToken GraphQL query response does not ' +
                                                'include a OneTrust token value in the expected location. ' +
                                                'Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON.data));
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> createOneTrustToken GraphQL query response does not ' +
                                            'include "createOneTrustToken" field in the expected location. ' +
                                            'Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON.data));
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> createOneTrustToken GraphQL query response does not ' +
                                        'include "data" field. ' +
                                        'Response JSON is -> ' + JSON.stringify(OK_RESPONSE_JSON));
                                }
                            } else {
                                const ERROR_RESPONSE_JSON = await response.json();
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Error creating OneTrust token due to XHR response status code being ' +
                                    response.status + ' and NOT a 200 OK response. :-(\r' +
                                    'Response from XHR request is ->', ERROR_RESPONSE_JSON);
                            }
                        } catch (error) {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Error creating OneTrust token due to fetch request error -> ' + error);
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to get OneTrust token by making a network request to the appropriate ' +
                            'endpoint as guest information is null.');
                    }
                    return oneTrustToken;
                },
                getOneTrustToken: async function(guestInfo) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_EWCS_GET_ONETRUST_TOKEN_';
                    let oneTrustToken = null;
                    if (guestInfo) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting OneTrust token using guest information retrieved from PEP.PROFILE_AUTH with the following data: ' +
                            JSON.stringify(guestInfo));
                        oneTrustToken = wdprProfileNav.features.ewcs.controller.getOneTrustTokenFromLocalStorage();
                        if (oneTrustToken) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved OneTrust token from local storage. ' +
                                'OneTrust token value is \"' + oneTrustToken + '\". Returning this token without making a network request to create a new OneTrust token.');
                        } else {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> No valid OneTrust token found in local storage. ' +
                                'A new OneTrust token will be created by making a network request to the appropriate endpoint.');
                            oneTrustToken = await wdprProfileNav.features.ewcs.controller.getOneTrustTokenFromOneIdEndpoint(guestInfo);
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to get OneTrust token as guest information is null.');
                    }
                    return oneTrustToken;
                },
                getFooterDomElementSelectorForBrandCode: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_GET_FOOTER_DOM_ELEMENT_SELECTOR_FOR_BRAND_CODE_';
                    const EWCS_CONFIG = wdprProfileNav.config.features.enterpriseWideConsentSyncConfig; 
                    const UTILS = wdprProfileNav.main.utils;
                    const BRAND_CODE = wdprProfileNav.main.model.brandCode.toUpperCase();
                    const FOOTER_DOM_ELEMENT_SELECTOR_FOR_BRAND_CODE = EWCS_CONFIG[`footerDomElementSelector${BRAND_CODE}`];
                    let footerDomElementSelector = null;
                    if (UTILS.isStringAndNotEmpty(FOOTER_DOM_ELEMENT_SELECTOR_FOR_BRAND_CODE)) {
                        footerDomElementSelector = FOOTER_DOM_ELEMENT_SELECTOR_FOR_BRAND_CODE;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully determined footer dom element selector for EWCS feature ' +
                            'based on brand code with the following value: \"' + footerDomElementSelector + '\" for brand code \"' + BRAND_CODE + '\"');
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> No footer dom element selector found for brand code \"' + BRAND_CODE +
                            '\".  Brand code must be part of the configuration for the EWCS feature.  ' +
                            'The current configuration for the EWCS feature is -> ' + JSON.stringify(EWCS_CONFIG));
                    }
                    return footerDomElementSelector;
                },
                detectFooterWithOneTrustLinkDomElements: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_GET_FOOTER_WITH_ONETRUST_LINK_';
                    console.log(LOG_MESSAGE_PREFIX + ' -> Attempting to find the syndicated footer...');
                    const UTILS = wdprProfileNav.main.utils;
                    const FOOTER_DOM_ELEMENT_SELECTOR = wdprProfileNav.features.ewcs.controller.getFooterDomElementSelectorForBrandCode();
                    const BRAND_CODE = wdprProfileNav.main.model.brandCode.toUpperCase();
                    const EWCS_CONFIG = wdprProfileNav.config.features.enterpriseWideConsentSyncConfig;
                    if (UTILS.isStringAndNotEmpty(FOOTER_DOM_ELEMENT_SELECTOR)) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully determined footer dom element selector for EWCS feature ' +
                            'based on brand code with the following value: \"' + FOOTER_DOM_ELEMENT_SELECTOR + '\" for brand code \"' + BRAND_CODE + '\"');
                        const DOM_ELEMENTS = wdprProfileNav.features.ewcs.model.domElements;
                        const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS =
                            wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalFrequencyMs;
                        const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS =
                            wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalMaxAttempts;
                        const INTERVAL_DETECTION_MODULUS_FREQUENCY =
                            wdprProfileNav.main.constants.INTERVAL_DETECTION_MODULUS_FREQUENCY;
                        const FOOTER_ONETRUST_LINK_DETECTOR_INTERVAL = setInterval(async function() {
                            DOM_ELEMENTS.domElementsDetectionAttemptCount = DOM_ELEMENTS.domElementsDetectionAttemptCount + 1;
                            if (DOM_ELEMENTS.domElementsDetectionAttemptCount <= PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS) {
                                const SYNDICATED_FOOTER = document.querySelector(FOOTER_DOM_ELEMENT_SELECTOR);
                                if (SYNDICATED_FOOTER) {
                                    DOM_ELEMENTS.footerElement = SYNDICATED_FOOTER;
                                    if (DOM_ELEMENTS.domElementsDetectionAttemptCount === 1 || 
                                        DOM_ELEMENTS.domElementsDetectionAttemptCount % INTERVAL_DETECTION_MODULUS_FREQUENCY === 0) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Found the syndicated footer and attempting to find the ' +
                                            'child with href="#oneTrustModal" inside this specific footer...');
                                    }
                                    const ONETRUST_SELECTOR = '[href="#oneTrustModal"]';
                                    DOM_ELEMENTS.oneTrustModalLinkElement = SYNDICATED_FOOTER.querySelector(ONETRUST_SELECTOR);
                                    if (DOM_ELEMENTS.oneTrustModalLinkElement) {
                                        DOM_ELEMENTS.isDomElementSearchSuccessful = true;
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully found OneTrust modal link DOM element -> ',
                                            DOM_ELEMENTS.oneTrustModalLinkElement +
                                            '\n\tLink Text -> ', DOM_ELEMENTS.oneTrustModalLinkElement.textContent ||
                                            DOM_ELEMENTS.oneTrustModalLinkElement.innerText);
                                        clearInterval(FOOTER_ONETRUST_LINK_DETECTOR_INTERVAL);
                                        wdprProfileNav.features.ewcs.controller.processDetectedDomElementsAndSetEventHandlers();
                                    } else {
                                        if (DOM_ELEMENTS.domElementsDetectionAttemptCount === 1 || 
                                            DOM_ELEMENTS.domElementsDetectionAttemptCount % INTERVAL_DETECTION_MODULUS_FREQUENCY === 0) {
                                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> No child element with href="#oneTrustModal" detected ' +
                                                'within the footer DOM element on attempt count ' + DOM_ELEMENTS.domElementsDetectionAttemptCount +
                                                ' of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                                ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                                'Retrying detection...');
                                        }
                                    }
                                } else {
                                    if (DOM_ELEMENTS.domElementsDetectionAttemptCount === 1 || 
                                        DOM_ELEMENTS.domElementsDetectionAttemptCount % INTERVAL_DETECTION_MODULUS_FREQUENCY === 0) {
                                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> No <footer class="syndicated-footer-wrapper"> detected ' +
                                            'in the DOM on attempt count ' + DOM_ELEMENTS.domElementsDetectionAttemptCount + ' of ' +
                                            PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                            ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                            'Retrying detection...');
                                    }
                                }
                            } else {
                                DOM_ELEMENTS.domElementsDetectionAttemptCount = DOM_ELEMENTS.domElementsDetectionAttemptCount - 1;
                                console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect the OneTrust modal link DOM element with ' +
                                    'attempt count ' +
                                    DOM_ELEMENTS.domElementsDetectionAttemptCount + ' of ' +
                                    PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                    ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                    'Stopping further detection attempts.');
                                clearInterval(FOOTER_ONETRUST_LINK_DETECTOR_INTERVAL);
                            }
                        }, PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS);
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect the syndicated footer as no footer dom element selector ' +
                            'was found for brand code \"' + BRAND_CODE + '\".  Brand code and footer dom element selector must be part of the ' +
                            'configuration for the EWCS feature.  The current configuration for the EWCS feature is -> ' + 
                            JSON.stringify(EWCS_CONFIG));
                    }
                },
                detectOneTrustSDKFullInitComplete: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_EWCS_DETECT_ONETRUST_FULL_INIT_COMPLETE_';
                    console.log(LOG_MESSAGE_PREFIX + ' -> Attempting to detect if the OneTrust SDK is fully initialized...');
                    const EWCS_MODEL_ONETRUST = wdprProfileNav.features.ewcs.model.oneTrust;
                    const EWCS_CONTROLLER = wdprProfileNav.features.ewcs.controller;
                    const UTILS = wdprProfileNav.main.utils;
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalFrequencyMs;
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalMaxAttempts;
                    const INTERVAL_DETECTION_MODULUS_FREQUENCY =
                        wdprProfileNav.main.constants.INTERVAL_DETECTION_MODULUS_FREQUENCY;
                    const ONETRUST_SDK_FULL_INIT_DETECTOR_INTERVAL = setInterval(async function() {
                        EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount = EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount + 1;
                        if (EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount <= PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS) {
                            if (OneTrust.getDataSubjectId) {
                                const ONETRUST_DATA_SUBJECT_ID = OneTrust.getDataSubjectId();
                                if (UTILS.isStringAndNotEmpty(ONETRUST_DATA_SUBJECT_ID)) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust SDK is fully initialized. Data Subject ID ' +
                                        'detected -> \"' + ONETRUST_DATA_SUBJECT_ID + '\"');
                                    clearInterval(ONETRUST_SDK_FULL_INIT_DETECTOR_INTERVAL);
                                    EWCS_CONTROLLER.eventEmitters.guestProfileOneTrustSDKInitCompleteEventEmitter(ONETRUST_DATA_SUBJECT_ID);
                                    wdprProfileNav.features.ewcs.model.guestInfo.isGuestInfoOneTrustTokenProcessingComplete = true;
                                }
                            } else {
                                if (EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount === 1 || 
                                    EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount % INTERVAL_DETECTION_MODULUS_FREQUENCY === 0) {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> The OneTrust SDK is not detected as fully initialized ' +
                                        'in the browser window ' + EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount + ' of ' +
                                        PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                        ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                        'Retrying detection...');
                                }
                            }
                        } else {
                            EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount =
                                EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount - 1;
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect the OneTrust SDK as fully initialized with ' +
                                'attempt count ' + EWCS_MODEL_ONETRUST.oneTrustSdkFullInitDetectionAttemptCount + ' of ' +
                                PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                'Stopping further detection attempts.');
                            clearInterval(ONETRUST_SDK_FULL_INIT_DETECTOR_INTERVAL);
                        }
                    }, PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS);
                },
                eventListeners: {
                    processOneTrustFooterLinkClickListener: function(event) {
                        event.preventDefault();
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'FEATURE_EWCS_PROCESS_ONETRUST_FOOTER_LINK_CLICK_LISTENER_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> click event detected and launching OneTrust modal...');
                        if (window.OneTrust) {
                            window.OneTrust.ToggleInfoDisplay();
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrust modal successfully launched! :-)');
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> window.OneTrust object is not detected thus ' +
                                'unable to launch the OneTrust modal. :-(');
                        }
                    },
                    processOneTrustSDKOneTrustGroupsUpdatedListener: function(event) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'FEATURE_EWCS_PROCESS_ONETRUST_GROUPS_UPDATED_EVENT_LISTENER_';
                        let eventJSONString = "";
                        if (event) {
                            if (event.detail) {
                                eventJSONString = JSON.stringify(event.detail);
                            }
                        }
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneTrustGroupsUpdated event detected with the following ' +
                            'event.detail data -> ' + eventJSONString);
                    },
                    processGuestProfileOneTrustSdkInitCompleteListener: function(event) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'FEATURE_EWCS_PROCESS_GUEST_PROFILE_ONETRUST_SDK_INIT_COMPLETE_EVENT_LISTENER_';
                        const GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME = wdprProfileNav.features.ewcs.constants.events
                            .GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME;
                        let eventJSONString = "";
                        if (event) {
                            if (event.detail) {
                                eventJSONString = JSON.stringify(event.detail);
                            }
                        }
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ' + GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME +
                            ' event detected with the following event.detail data -> ' + eventJSONString);
                    }
                },
                eventEmitters: {
                    guestProfileOneTrustSDKInitCompleteEventEmitter: function(oneTrustDataSubjectId) {
                        const GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME = wdprProfileNav.features.ewcs.constants.events
                            .GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME;
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'EWCS_EVENT_EMITTER_';
                        const UTILS = wdprProfileNav.main.utils;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ' + GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME +
                            ' event emitting now...');
                        let eventName = GUEST_PROFILE_ONE_TRUST_SDK_INIT_COMPLETE_EVENT_NAME;
                        let eventDetail = "";
                        if (UTILS.isStringAndNotEmpty(oneTrustDataSubjectId)) {
                            eventDetail = oneTrustDataSubjectId;
                        }
                        const EVENT = new Event(eventName);
                        EVENT.detail = eventDetail;
                        wdprProfileNav.main.utils.dispatchEvent(EVENT, eventName);
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ' + eventName + ' successfully emitted!');
                    }
                }
            }
        },

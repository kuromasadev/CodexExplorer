                        AFFILIATIONS_CONTAINER_TEMPLATE: `
                            <style>
                                .guest-profile-affiliations-container {
                                    margin-top: 10px;
                                }
                                
                                .guest-affiliation {
                                    display: flex;
                                    flex-direction: row;
                                    align-items: flex-start;   /* top-align icon with name row */
                                    gap: 15px;
                                    margin-bottom: 10px;
                                    line-height: 1.5;
                                }
                                .guest-affiliation .affiliation-icon-container {
                                    flex: 0 0 auto;
                                    min-width: 37px;
                                    display: flex;
                                    align-items: center;       /* center icon inside its box */
                                    justify-content: center;
                                    /* optional fine-tune so icon visually lines up with text cap height */
                                    padding-top: 2px;
                                }
                                .guest-affiliation .affiliation-icon.di {
                                    font-size: 30px;
                                    line-height: 1;
                                    display: inline-block;
                                }

                                .guest-affiliation .affiliation-icon-container img {
                                    width: 37px;
                                    height: auto;
                                }

                                .guest-affiliation .affiliation-name-and-detail-container {
                                    display: flex;
                                    flex-direction: row;
                                    flex-wrap: wrap;
                                    align-items: center;       /* vertically center button with detail text */
                                    align-content: flex-start;
                                    gap: 4px 12px;             /* row gap, then gap between detail and button */
                                    flex: 1 1 auto;
                                    min-width: 0;
                                }

                                .guest-affiliation .affiliation-name {
                                    flex: 0 0 100%;
                                    width: 100%;
                                    display: block;
                                    font-size: 18px;
                                    line-height: 1.5;
                                    margin-bottom: 0;
                                }

                                .guest-affiliation .affiliation-detail {
                                    flex: 0 1 auto;            /* width follows content; can shrink if needed */
                                    min-width: 0;
                                    display: block;
                                    font-size: 14px;
                                    line-height: 1.5;
                                }

                                .guest-affiliation .affiliation-button-container {
                                    flex: 0 0 auto;            /* button column sized to content (incl. min-width on .affiliation__button) */
                                    display: none;             /* default hidden; see note below about inline styles */
                                    font-size: 14px;
                                    line-height: 1.5;
                                }

                                .guest-affiliation .affiliation-detail span {
                                    display: block;
                                    font-size: 12px;
                                    line-height: 1.5;
                                    color: #666;
                                }

                                .guest-affiliation .id-me-verified-badge {
                                    width: 145px;
                                    height: auto;
                                    margin: -10px -16px -16px -4px;
                                }

                                .guest-affiliation .affiliation__button {
                                    min-width: 120px;
                                    padding: 10px 20px;
                                    border-radius: 9999px;
                                    font-family: InspireTWDC, Arial, sans-serif;
                                    font-size: 14px;
                                    font-weight: 600;
                                    cursor: pointer;
                                    line-height: 1.2;
                                }
                                .guest-affiliation .affiliation__button:focus-visible {
                                    outline: 2px solid #0079bc;
                                    outline-offset: 2px;
                                }
                                .guest-affiliation .affiliation__button--close {
                                    background: #ffffff;
                                    color: #0079bc;
                                    border: 1px solid #0079bc;
                                }
                                .guest-affiliation .affiliation__button--close:hover {
                                    background: #f5f8fa;
                                }
                                .guest-affiliation .affiliation__button--renew {
                                    background: #0079bc;
                                    color: #ffffff;
                                    border: 1px solid #0079bc;
                                }
                                .guest-affiliation .affiliation__button--renew:hover {
                                    background: #083c5d;
                                    border-color: #083c5d;
                                }
                            </style>
                            <div class="guest-profile-affiliations-container">
                                {affiliationsInnerHtml}
                            </div>
                        `.trim(),

                        const GUEST_API = wdprProfileNav.api.guest;
                        const AFFILIATION_TYPE_AND_SUBTYPE_MAP_KEY_DELIMITER = AFFILIATION_CONSTANTS.AFFILIATION_TYPE_AND_SUBTYPE_MAP_KEY_DELIMITER;
                        const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;

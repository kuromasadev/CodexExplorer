                    getMainEntrancePassAffiliationHtml: function(affiliation, affiliationTemplate, contentModel) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_GET_MAIN_ENTRANCE_PASS_AFFILIATION_HTML_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting affiliation HTML...');
                        const UTILS = wdprProfileNav.main.utils;
                        const AFFILIATION_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.affiliations;
                        let affiliationHtml = null;
                        const AFFILIATION_CATEGORY = affiliation.category;
                        const AFFILIATION_TYPE = affiliation.type;
                        const AFFILIATION_SUBTYPE = affiliation.subType;
                        const MAIN_ENTRANCE_PASS = AFFILIATION_CONSTANTS.AFFILIATION_TYPE.MAIN_ENTRANCE_PASS;
                        const MAIN_ENTRANCE_PASS_SUBTYPE_PRIMARY = AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MAIN_ENTRANCE_PASS_SUBTYPE.PRIMARY;
                        if (contentModel) {
                            if (UTILS.isStringAndNotEmpty(AFFILIATION_CATEGORY)) {
                                if (UTILS.isStringAndNotEmpty(AFFILIATION_TYPE)) {
                                    if (contentModel.profile) {
                                        if (contentModel.profile.memberships) {
                                            if (contentModel.profile.memberships[MAIN_ENTRANCE_PASS]) {
                                                const CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE = 
                                                    contentModel.profile.memberships[MAIN_ENTRANCE_PASS];
                                                if (CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE) {
                                                    let affiliationIconClass = '';
                                                    let affiliationName = '';
                                                    let affiliationDetail = '';
                                                    let affiliationDetail2 = '';
                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.icon) {
                                                        affiliationIconClass = CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.icon;
                                                    }
                                                    if (CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.label) {
                                                        affiliationName = CONTENT_MEMBERSHIP_FOR_AFFILIATION_TYPE.label;
                                                    }
                                                    if (AFFILIATION_SUBTYPE === MAIN_ENTRANCE_PASS_SUBTYPE_PRIMARY) {
                                                        let affiliationSwid = null;
                                                        if (affiliation.guest) {
                                                            if (affiliation.guest.guestIdType === 'swid') {
                                                                if (UTILS.isStringAndNotEmpty(affiliation.guest.guestIdValue)) {
                                                                    affiliationSwid = affiliation.guest.guestIdValue;
                                                                }
                                                            }
                                                        }
                                                        if (UTILS.isStringAndNotEmpty(affiliationSwid)) {
                                                            const GUEST_PROFILE_MODEL = wdprProfileNav.features.guestIdentity.model.guestProfile;
                                                            if (GUEST_PROFILE_MODEL) {
                                                                if (GUEST_PROFILE_MODEL.swid === affiliationSwid) {
                                                                    if (GUEST_PROFILE_MODEL.profileAuthInfo) {
                                                                        if (GUEST_PROFILE_MODEL.profileAuthInfo.profile) {
                                                                            const PROFILE = GUEST_PROFILE_MODEL.profileAuthInfo.profile;
                                                                            if (UTILS.isStringAndNotEmpty(PROFILE.firstName)) {
                                                                                if (UTILS.isStringAndNotEmpty(PROFILE.lastName)) {
                                                                                    let suffix = '';
                                                                                    if (UTILS.isStringAndNotEmpty(PROFILE.suffix)) {
                                                                                        suffix = PROFILE.suffix;
                                                                                    }
                                                                                    affiliationDetail = 
                                                                                        PROFILE.firstName + ' ' + PROFILE.lastName + ' ' + suffix;
                                                                                    affiliationDetail = affiliationDetail.trim();
                                                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation detail is -> ' + 
                                                                                        affiliationDetail + '. Displaying affiliation...');
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                } else {
                                                                    console.warn(LOG_MESSAGE_PREFIX + 'WARNING -> Guest profile swid does not match the ' +
                                                                        'affiliation swid. Unable to display the primary ' + MAIN_ENTRANCE_PASS + 
                                                                        ' type affiliation.');
                                                                }
                                                            }
                                                        }
                                                    }
                                                    if (!UTILS.isStringAndNotEmpty(affiliationDetail)) {
                                                        console.warn(LOG_MESSAGE_PREFIX + 'WARNING -> Guest profile first name and last name are not available ' +
                                                            ' for the primary ' + MAIN_ENTRANCE_PASS + ' type affiliation.  Unable to display the affiliation.');
                                                    } else {
                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content membership for affiliation type is -> ' + 
                                                            AFFILIATION_TYPE + '. Displaying affiliation...');
                                                        const AFFILIATION_HTML = affiliationTemplate
                                                            .replaceAll('{affiliationIconClass}', affiliationIconClass)
                                                            .replaceAll('{affiliationCategory}', AFFILIATION_CATEGORY.toLowerCase())
                                                            .replaceAll('{affiliationType}', AFFILIATION_TYPE.toLowerCase())
                                                            .replaceAll('{affiliationName}', affiliationName)
                                                            .replaceAll('{affiliationDetail}', affiliationDetail)
                                                            .replaceAll('{affiliationDetail2}', affiliationDetail2);
                                                        affiliationHtml = AFFILIATION_HTML;
                                                    }
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content membership for affiliation type is ' +
                                                        'not available. Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                                        AFFILIATION_SUBTYPE + ' affiliation.');
                                                }
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" and "memberships" data ' +
                                                    'are not available. Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                                    AFFILIATION_SUBTYPE + ' affiliation.');
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Content model "profile" and "memberships" data ' +
                                                'are not available. Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                                AFFILIATION_SUBTYPE + ' affiliation.');
                                        }
                                    } else {

                    let isIdMeButtonIdValid = false;
                    if (UTILS.isStringAndNotEmpty(buttonId)) {
                        isIdMeButtonIdValid = true;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Button ID -> \"' + buttonId + '\" is a valid string.');
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Button ID is not a valid string.');

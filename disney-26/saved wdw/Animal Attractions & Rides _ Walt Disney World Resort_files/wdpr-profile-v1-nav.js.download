                                            'Unable to display ' + AFFILIATION_CATEGORY + ' - ' + AFFILIATION_TYPE + ' - ' + 
                                            AFFILIATION_SUBTYPE + ' affiliation.');
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not available. Unable to display ' + 
                                        AFFILIATION_CATEGORY + ' affiliation category.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation category is not available. Unable to display ' +
                                    'affiliation category.');

                            'FEATURE_GUEST_IDENTITY_EVENT_EMITTER_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> New affiliation type military retiree created event emitter is triggered...');
                        const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                        await GUEST_IDENTITY_CONTROLLER.eventEmitters.newAffiliationTypeCreatedEventEmitter();
                        const NEW_AFFILIATION_TYPE_MILITARY_RETIREE_CREATED_EVENT_NAME = 

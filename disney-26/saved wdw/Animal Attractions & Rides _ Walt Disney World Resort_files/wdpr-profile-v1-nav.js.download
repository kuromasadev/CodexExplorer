                        const NEW_AFFILIATION_TYPE_MILITARY_RETIREE_CREATED_EVENT = new Event(NEW_AFFILIATION_TYPE_MILITARY_RETIREE_CREATED_EVENT_NAME);
                        wdprProfileNav.main.utils.dispatchEvent(NEW_AFFILIATION_TYPE_MILITARY_RETIREE_CREATED_EVENT, NEW_AFFILIATION_TYPE_MILITARY_RETIREE_CREATED_EVENT_NAME);
                    },
                    newAffiliationTypeMilitarySpouseCreatedEventEmitter: async function() {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'FEATURE_GUEST_IDENTITY_EVENT_EMITTER_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> New affiliation type military spouse created event emitter is triggered...');
                        const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                        await GUEST_IDENTITY_CONTROLLER.eventEmitters.newAffiliationTypeCreatedEventEmitter();
                        const NEW_AFFILIATION_TYPE_MILITARY_SPOUSE_CREATED_EVENT_NAME = 
                            wdprProfileNav.features.guestIdentity.constants.events.NEW_AFFILIATION_TYPE_MILITARY_SPOUSE_CREATED_EVENT_NAME;
                        const NEW_AFFILIATION_TYPE_MILITARY_SPOUSE_CREATED_EVENT = new Event(NEW_AFFILIATION_TYPE_MILITARY_SPOUSE_CREATED_EVENT_NAME);
                        wdprProfileNav.main.utils.dispatchEvent(NEW_AFFILIATION_TYPE_MILITARY_SPOUSE_CREATED_EVENT, NEW_AFFILIATION_TYPE_MILITARY_SPOUSE_CREATED_EVENT_NAME);
                    }
                },
                eventListeners: {
                    idMeCallbackCompleteMessageListener: async function(event) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'FEATURE_GUEST_IDENTITY_EVENT_LISTENER_';
                        const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                        const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                        const GUEST_IDENTITY_VIEW = wdprProfileNav.features.guestIdentity.view;
                        const EVENT_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.events;
                        const AFFILIATION_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.affiliations;
                        const UTILS = wdprProfileNav.main.utils;
                        const ID_ME_CALLBACK_COMPLETE_MESSAGE_TYPE = EVENT_CONSTANTS.ID_ME_CALLBACK_COMPLETE_MESSAGE_TYPE;
                        if (event.origin !== window.location.origin) {
                            return;
                        }
                        if (!event.data || event.data.type !== ID_ME_CALLBACK_COMPLETE_MESSAGE_TYPE) {
                            return;
                        }
                        if (event.data.status) {
                            if (UTILS.isStringAndNotEmpty(event.data.status)) {
                                if (event.data.status.toLowerCase() === 'success') {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me callback complete message received from popup. ' +
                                        'The status is success so continuing to process the identity verification callback response data...');
                                    const IDENTITY_VERIFICATION_CALLBACK_RESPONSE_DATA = event.data.identityVerificationCallbackResponseData;
                                    if (IDENTITY_VERIFICATION_CALLBACK_RESPONSE_DATA) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Identity verification callback response data is available. ' +
                                            'The identity verification callback response data is -> ' + 
                                            JSON.stringify(IDENTITY_VERIFICATION_CALLBACK_RESPONSE_DATA));
                                        // TODO: Process the identity verification callback response data AND emit specific 
                                        // events related to which affiliation type was processed....
                                        const RESOURCE = IDENTITY_VERIFICATION_CALLBACK_RESPONSE_DATA.resource;
                                        let affiliationType = null;
                                        let affiliationSubType = null;
                                        let affiliationCreateRequestData = null;
                                        let isIdMeStatusPersisted = false;
                                        let isAllRequiredDataAvailable = true;
                                        if (RESOURCE) {
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Resource is available. ' +
                                                'The resource is -> ' + JSON.stringify(RESOURCE));
                                            if (RESOURCE.affiliationType) {
                                                affiliationType = RESOURCE.affiliationType;
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type is available. ' +
                                                    'The affiliation type is -> ' + RESOURCE.affiliationType);
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not available.');
                                                isAllRequiredDataAvailable = false;
                                            }
                                            if (RESOURCE.affiliationSubType) {
                                                affiliationSubType = RESOURCE.affiliationSubType;
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation sub type is available. ' +
                                                    'The affiliation sub type is -> ' + RESOURCE.affiliationSubType);
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation sub type is not available.');
                                                isAllRequiredDataAvailable = false;
                                            }
                                            if (RESOURCE.affiliationCreateRequestData) {
                                                affiliationCreateRequestData = RESOURCE.affiliationCreateRequestData;
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation create request data is available. ' +
                                                    'The affiliation create request data is -> ' + JSON.stringify(RESOURCE.affiliationCreateRequestData));
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation create request data is not available.');
                                                isAllRequiredDataAvailable = false;
                                            }
                                            if (RESOURCE.isIdMeStatusPersisted) {
                                                if (RESOURCE.isIdMeStatusPersisted === true) {
                                                    isIdMeStatusPersisted = true;
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Is ID.me status persisted is true. ' +
                                                        'The is ID.me status persisted is -> ' + RESOURCE.isIdMeStatusPersisted);
                                                } else {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Is ID.me status persisted is false. ' +
                                                        'The is ID.me status persisted is -> ' + RESOURCE.isIdMeStatusPersisted);
                                                }
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Is ID.me status persisted is not available.');
                                            }
                                        }
                                        if (isIdMeStatusPersisted) {
                                            if (isAllRequiredDataAvailable) {
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> All required data is available. ' +
                                                    'The affiliation type is -> ' + affiliationType + ' and the affiliation sub type is -> ' + 
                                                    affiliationSubType + ' and the affiliation create request data is -> ' + 
                                                    JSON.stringify(affiliationCreateRequestData) + ' and the is ID.me status persisted is -> ' + 
                                                    isIdMeStatusPersisted);
                                                if (affiliationType === AFFILIATION_CONSTANTS.AFFILIATION_TYPE.MILITARY) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type is military. ' +
                                                        'The affiliation type is -> ' + affiliationType);
                                                    if (affiliationSubType === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.SERVICE_MEMBER) {
                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation sub type is service member. ' +
                                                            'The affiliation sub type is -> ' + affiliationSubType + ' Continuing to process the service member affiliation...');
                                                        await GUEST_IDENTITY_CONTROLLER.eventEmitters.newAffiliationTypeMilitaryServiceMemberCreatedEventEmitter();
                                                    } else if (affiliationSubType === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.RETIREE) {
                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation sub type is retiree. ' +
                                                            'The affiliation sub type is -> ' + affiliationSubType + ' Continuing to process the retiree affiliation...');
                                                        await GUEST_IDENTITY_CONTROLLER.eventEmitters.newAffiliationTypeMilitaryRetireeCreatedEventEmitter();
                                                    } else if (affiliationSubType === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_MILITARY_SUBTYPE.SPOUSE) {
                                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation sub type is spouse. ' +
                                                            'The affiliation sub type is -> ' + affiliationSubType + ' Continuing to process the spouse affiliation...');
                                                        await GUEST_IDENTITY_CONTROLLER.eventEmitters.newAffiliationTypeMilitarySpouseCreatedEventEmitter();
                                                    } else {
                                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation sub type is not available.');
                                                    }
                                                } else if (affiliationType === AFFILIATION_CONSTANTS.AFFILIATION_TYPE_FLORIDA_RESIDENT) {
                                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation type is Florida resident. ' +
                                                        'The affiliation type is -> ' + affiliationType);
                                                } else {
                                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation type is not available.');
                                                }
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> All required data is not available.');
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Is ID.me status persisted is not available.');
                                        }
                                        GUEST_IDENTITY_MODEL.idMeActiveInterstitialModal.idMeLauncherButtonConfig = null;
                                        GUEST_IDENTITY_VIEW.interstitial.hide();
                                        GUEST_IDENTITY_CONTROLLER.closeIDMePopupWindow();
                                        GUEST_IDENTITY_CONTROLLER.eventEmitters.guestAffiliationsReadyEventEmitter();
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Identity verification callback response data is not available.');
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me callback complete message received from popup. ' +
                                        'The status is not success.');
                                }
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me callback complete message received from popup. ' +
                                'The status is not available.');
                        }
                    },
                    idMeLauncherButtonClickedEventListener: async function(event) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'FEATURE_GUEST_IDENTITY_EVENT_LISTENER_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button clicked event listener is triggered...');
                        try {
                            const ID_ME_LAUNCHER_BUTTON_CONFIG = event.currentTarget.idMeLauncherButtonConfig;
                            const ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT = event.currentTarget;
                            event.idMeLauncherButtonConfig = ID_ME_LAUNCHER_BUTTON_CONFIG;
                            event.idMeLauncherButtonDomElement = ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT;
                            const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                            const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                            const GUEST_IDENTITY_VIEW = wdprProfileNav.features.guestIdentity.view;
                            if (ID_ME_LAUNCHER_BUTTON_DOM_ELEMENT) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button dom element is detected in the event target. ' +
                                    'Proceeding to emit the ID.me launcher button clicked event...');
                                if (ID_ME_LAUNCHER_BUTTON_CONFIG) {
                                    GUEST_IDENTITY_MODEL.idMeActiveInterstitialModal.idMeLauncherButtonConfig = ID_ME_LAUNCHER_BUTTON_CONFIG;
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button configuration is detected in the event target. ' +
                                        'Proceeding to emit the ID.me launcher button clicked event...');
                                    GUEST_IDENTITY_CONTROLLER.eventEmitters.idMeLauncherButtonClickedEventEmitter(event);
                                    GUEST_IDENTITY_VIEW.interstitial.show();
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button configuration is not detected in the event target.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button dom element is not detected in the event target.');
                            }
                        } catch (error) {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button click handler failed.', error);
                        }
                    },
                    onAffiliationRenewButtonClicked: function(affiliationBrandCode, event) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_ON_AFFILIATION_RENEW_BUTTON_CLICKED_';
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Renew button clicked for affiliation brand code -> ' + 
                            affiliationBrandCode + '...');
                        const GUEST_IDENTITY_CONFIG = wdprProfileNav.config.features.guestIdentityConfig;
                        const BRAND_CODE = wdprProfileNav.main.model.brandCode;
                        const UTILS = wdprProfileNav.main.utils;
                        const AFFILIATION_RENEWAL_PATH = '/passes/renew/';
                        if (UTILS.isStringAndNotEmpty(BRAND_CODE)) {
                            if (UTILS.isStringAndNotEmpty(affiliationBrandCode)) {
                                if (affiliationBrandCode.toLowerCase() === BRAND_CODE.toLowerCase()) {
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation brand code ' + affiliationBrandCode + 
                                        ' is the same as the brand code ' + BRAND_CODE + '. ' +
                                        'Proceeding to renew the affiliation and navigating to the appropriate renewal page...');
                                    window.location.href = window.location.origin + AFFILIATION_RENEWAL_PATH;
                                } else {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Affiliation brand code ' + affiliationBrandCode + 
                                        ' is not the same as the current site brand code ' + BRAND_CODE + '. ' +
                                        'Opening new window to appropriate site to renew the affiliation...');
                                    let affiliationRenewalSiteUrl = null;
                                    if (affiliationBrandCode.toLowerCase() === 'dlr') {
                                        affiliationRenewalSiteUrl = GUEST_IDENTITY_CONFIG.guestIdentityAffiliationSiteUrlDLR;
                                    } else if (affiliationBrandCode.toLowerCase() === 'wdw') {
                                        affiliationRenewalSiteUrl = GUEST_IDENTITY_CONFIG.guestIdentityAffiliationSiteUrlWDW;
                                    } else if (affiliationBrandCode.toLowerCase() === 'dcl') {
                                        affiliationRenewalSiteUrl = GUEST_IDENTITY_CONFIG.guestIdentityAffiliationSiteUrlDCL;
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Brand code is not available. Unable to renew the affiliation.');
                                    }
                                    if (UTILS.isStringAndNotEmpty(affiliationRenewalSiteUrl)) {
                                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation renewal site URL is available. ' +
                                            'The affiliation renewal site URL is -> ' + affiliationRenewalSiteUrl);
                                        const NEW_WINDOW = window.open(affiliationRenewalSiteUrl + AFFILIATION_RENEWAL_PATH, '_blank');
                                        if (NEW_WINDOW) {
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> New window was opened successfully. ' +
                                                'The new window URL is -> ' + NEW_WINDOW.location.href);
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> New window was not opened. Unable to renew the affiliation.');
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation renewal site URL is not available. Unable to ' +
                                            'open a new window to the affiliation renewal site.');
                                    }
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Affiliation brand code is not available. Unable to ' +
                                    'renew the affiliation and open a new window to the affiliation renewal site.  ' + 
                                    'The site brand code is -> ' + BRAND_CODE);
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Brand code is not available. Unable to renew the affiliation.');
                        }
                    }
                }
            },
            view: {
                affiliations: {
                    // TODO: Implement the affiliations view functionality.  
                    // Create a handler method for each affiliation type in order 
                    // to handle affiliation specific logical variations in a graceful 
                    // and extensible manner.
                    processAffiliationCategoriesAndTypes: async function(targetDomElementId, TARGET_DOM_ELEMENT,AFFILIATIONS, 
                        AFFILIATION_TEMPLATE, AFFILIATIONS_CONTAINER_TEMPLATE, CONTENT_MODEL) {
                        const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                            'VIEW_AFFILIATIONS_PROCESS_AFFILIATION_CATEGORIES_AND_TYPES_';

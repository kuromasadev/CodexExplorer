                        INTERSTITIAL_TEMPLATE: `
                            <style>
                                .guest-profile-interstitial-modal {
                                    position: fixed;
                                    inset: 0;
                                    z-index: 1000;
                                    display: none; /* hidden by default, DOM still exists */
                                    align-items: center;
                                    justify-content: center;
                                    padding: 16px;
                                    background: rgba(255, 255, 255, 0.85); /* semi-transparent white overlay */
                                }

                                .guest-profile-interstitial-modal--visible {
                                    display: flex;
                                }
                                .guest-profile-interstitial-modal__panel {
                                    position: relative;
                                    background: #ffffff;
                                    border: 1px solid #e3ecf3;
                                    border-radius: 12px;
                                    box-shadow: 0 8px 24px rgba(0, 35, 60, 0.15);
                                    width: 100%;
                                    max-width: 560px;
                                    padding: 24px;
                                }
                                .guest-profile-interstitial-modal__close {
                                    position: absolute;
                                    top: 16px;
                                    right: 16px;
                                    background: transparent;
                                    border: 0;
                                    padding: 4px;
                                    cursor: pointer;
                                    color: #0079bc;
                                }
                                .guest-profile-interstitial-modal__close .di-close-reversed {
                                    font-size: 18px;
                                }
                                .guest-profile-interstitial-modal__close:focus-visible {
                                    outline: 2px solid #0079bc;
                                    outline-offset: 2px;
                                }
                                .guest-profile-interstitial-modal__title {
                                    margin: 0 48px 12px 0;
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: #00233c;
                                    line-height: 1.2;
                                }
                                .guest-profile-interstitial-modal__body {
                                    margin: 0;
                                    font-size: 14px;
                                    line-height: 1.5;
                                    color: #607682;
                                }
                                .guest-profile-interstitial-modal__actions {
                                    display: flex;
                                    justify-content: flex-end;
                                    align-items: center;
                                    gap: 12px;
                                    margin-top: 24px;
                                }
                                .guest-profile-interstitial-modal__button {
                                    min-width: 120px;
                                    padding: 10px 20px;
                                    border-radius: 9999px;
                                    font-family: InspireTWDC, Arial, sans-serif;
                                    font-size: 14px;
                                    font-weight: 600;
                                    cursor: pointer;
                                    line-height: 1.2;
                                }
                                .guest-profile-interstitial-modal__button:focus-visible {
                                    outline: 2px solid #0079bc;
                                    outline-offset: 2px;
                                }
                                .guest-profile-interstitial-modal__button--close {
                                    background: #ffffff;
                                    color: #0079bc;
                                    border: 1px solid #0079bc;
                                }
                                .guest-profile-interstitial-modal__button--close:hover {
                                    background: #f5f8fa;
                                }
                                .guest-profile-interstitial-modal__button--continue {
                                    background: #0079bc;
                                    color: #ffffff;
                                    border: 1px solid #0079bc;
                                }
                                .guest-profile-interstitial-modal__button--continue:hover {
                                    background: #083c5d;
                                    border-color: #083c5d;
                                }
                            </style>
                            
                            <div
                                id="guest-profile-identity-verification-interstitial"
                                class="guest-profile-interstitial-modal"
                                role="dialog"
                                aria-modal="true"
                                aria-hidden="true"
                                aria-labelledby="guest-profile-identity-verification-interstitial-title">
                                <div class="guest-profile-interstitial-modal__panel">
                                    <button
                                        id="guest-profile-identity-verification-interstitial-dismiss-button"
                                        type="button"
                                        class="guest-profile-interstitial-modal__close"
                                        aria-label="Close">
                                        <span aria-hidden="true" class="di di-close-reversed"></span>
                                    </button>
                                    <div class="guest-profile-interstitial-modal__content">
                                            <h2 id="guest-profile-identity-verification-interstitial-title" class="guest-profile-interstitial-modal__title">
                                                {INTERSTITIAL_TITLE_TEXT}
                                        </h2>
                                        <p class="guest-profile-interstitial-modal__body">
                                            {INTERSTITIAL_BODY_TEXT}
                                        </p>
                                    </div>
                                    <div class="guest-profile-interstitial-modal__actions">
                                        <button
                                            id="guest-profile-identity-verification-interstitial-close-button"
                                            type="button"
                                            class="guest-profile-interstitial-modal__button guest-profile-interstitial-modal__button--close">
                                            {INTERSTITIAL_CLOSE_BUTTON_TEXT}
                                        </button>
                                        <button
                                            id="guest-profile-identity-verification-interstitial-continue-button"
                                            type="button"
                                            class="guest-profile-interstitial-modal__button guest-profile-interstitial-modal__button--continue">
                                            {INTERSTITIAL_CONTINUE_BUTTON_TEXT}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `.trim(),
                    }
                }
            },
            controller: {
                init: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_GUEST_IDENTITY_INIT_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Initializing guestIdentity feature for ' +
                        'WDPR Profile Nav application with the following configuration: ' +
                        JSON.stringify(wdprProfileNav.config.features.guestIdentityConfig));
                    const IS_GUEST_IDENTITY_FEATURE_ENABLED = wdprProfileNav.features.guestIdentity.controller.isGuestIdentityFeatureEnabled();
                    wdprProfileNav.features.guestIdentity.model.isGuestIdentityFeatureEnabled = IS_GUEST_IDENTITY_FEATURE_ENABLED;
                    if (IS_GUEST_IDENTITY_FEATURE_ENABLED) {
                        await wdprProfileNav.features.guestIdentity.controller.initEnabledGuestIdentityFeature();
                    } else {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Skipping initialization of guestProfile feature as it is not enabled ' +
                            'based on the provided configuration.');
                    }
                },
                isGuestIdentityFeatureEnabled: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'FEATURE_GUEST_IDENTITY_IS_ENABLED_';
                    let isGuestIdentityFeatureEnabled = false;
                    if (!wdprProfileNav.config.features.guestIdentityConfig) {
                        console.warn('guestIdentityConfig not detected in wdprProfileNav.config.features.guestIdentityConfig. ' +
                            'Assuming guestIdentityConfig feature is disabled.');
                    } else {
                        const IS_GUEST_IDENTITY_ENABLED =
                            wdprProfileNav.config.features.guestIdentityConfig.isGuestIdentityEnabled;
                        const GUEST_IDENTITY_ENABLED_BRANDS =
                            wdprProfileNav.config.features.guestIdentityConfig.guestIdentityEnabledBrands;
                        const CURRENT_BRAND_CODE = wdprProfileNav.main.model.brandCode;
                        if (IS_GUEST_IDENTITY_ENABLED === 'true') {
                            if (GUEST_IDENTITY_ENABLED_BRANDS.includes(CURRENT_BRAND_CODE)) {
                                isGuestIdentityFeatureEnabled = true;
                                console.log(LOG_MESSAGE_PREFIX + 'guestIdentity feature is enabled for current brand code \"' + CURRENT_BRAND_CODE +
                                    '\" based on guestIdentityConfig detected in wdprProfileNav.config.features.guestIdentityConfig.');
                            } else {
                                console.warn(LOG_MESSAGE_PREFIX + 'guestIdentity feature is disabled for current brand code \"' + CURRENT_BRAND_CODE +
                                    '\" based on guestIdentityConfig detected in wdprProfileNav.config.features.guestIdentityConfig. ' +
                                    'Current brand code is not included in the list of guestIdentityEnabledBrands.');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'guestIdentity feature is disabled based on guestProfile config detected in ' +
                                'wdprProfileNav.config.features.guestIdentityConfig.');
                        }
                        console.log(LOG_MESSAGE_PREFIX + 'guestIdentity config detected in wdprProfileNav.config.features.guestIdentityConfig ' +
                            'with the following value: ' + JSON.stringify(wdprProfileNav.config.features.guestIdentityConfig));
                    }
                    return isGuestIdentityFeatureEnabled;
                },
                initEnabledGuestIdentityFeature: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 
                        'FEATURE_GUEST_IDENTITY_INIT_ENABLED_';
                    const UTILS = wdprProfileNav.main.utils;
                    const GUEST_IDENTITY_CONFIG = wdprProfileNav.config.features.guestIdentityConfig;
                    const BRAND_CODE = wdprProfileNav.main.model.brandCode;
                    const BRAND_CODES = wdprProfileNav.main.constants.brandCodes
                    const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                    const GUEST_IDENTITY_VIEW = wdprProfileNav.features.guestIdentity.view;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Initializing enabled guestIdentity feature for ' +
                        'WDPR Profile Nav application with the following configuration: ' +
                        JSON.stringify(GUEST_IDENTITY_CONFIG));
                    let idMeLauncherButtonConfig = wdprProfileNav.features.guestIdentity.model.idMeLauncherButtonConfig;
                    const IS_TEST_PARAM_AP_RENEWABLE_ACTIVE = wdprProfileNav.features.guestIdentity.controller.isTestParamAPRenewableActive();
                    if (IS_TEST_PARAM_AP_RENEWABLE_ACTIVE) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Test parameter AP Renewable is active. ' +
                            'Proceeding to initialize the ID.me launcher button configuration...');
                    } else {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Test parameter AP Renewable is not active. ' +
                            'Skipping initialization of the ID.me launcher button configuration...');
                    }
                    if (idMeLauncherButtonConfig) {
                        let isClientIdSet = false;
                        let isRedirectUriSet = false;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button configuration is detected in the guestIdentity model. ' +
                            'Proceeding to initialize the ID.me launcher button configuration...');
                        if (BRAND_CODE === BRAND_CODES.DCL) {
                            idMeLauncherButtonConfig.dataClientId = GUEST_IDENTITY_CONFIG.guestIdentityIdMeClientIdDCL;
                            isClientIdSet = true;
                            if (UTILS.isStringAndNotEmpty(GUEST_IDENTITY_CONFIG.guestIdentityIdMeCallbackUrlDCL)) {
                                idMeLauncherButtonConfig.dataRedirectUri = GUEST_IDENTITY_CONFIG.guestIdentityIdMeCallbackUrlDCL;
                                isRedirectUriSet = true;
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guestIdentityIdMeCallbackUrlDCL is not set in the guestIdentity config. ' +
                                    'Cannot proceed to initialize the ID.me launcher button configuration.');
                            }
                        } else if (BRAND_CODE === BRAND_CODES.DLR) {
                            idMeLauncherButtonConfig.dataClientId = GUEST_IDENTITY_CONFIG.guestIdentityIdMeClientIdDLR;
                            isClientIdSet = true;
                            if (UTILS.isStringAndNotEmpty(GUEST_IDENTITY_CONFIG.guestIdentityIdMeCallbackUrlDLR)) {
                                idMeLauncherButtonConfig.dataRedirectUri = GUEST_IDENTITY_CONFIG.guestIdentityIdMeCallbackUrlDLR;
                                isRedirectUriSet = true;
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guestIdentityIdMeCallbackUrlDLR is not set in the guestIdentity config. ' +
                                    'Cannot proceed to initialize the ID.me launcher button configuration.');
                            }
                        } else if (BRAND_CODE === BRAND_CODES.WDW) {
                            idMeLauncherButtonConfig.dataClientId = GUEST_IDENTITY_CONFIG.guestIdentityIdMeClientIdWDW;
                            isClientIdSet = true;
                            if (UTILS.isStringAndNotEmpty(GUEST_IDENTITY_CONFIG.guestIdentityIdMeCallbackUrlWDW)) {
                                idMeLauncherButtonConfig.dataRedirectUri = GUEST_IDENTITY_CONFIG.guestIdentityIdMeCallbackUrlWDW;
                                isRedirectUriSet = true;
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guestIdentityIdMeCallbackUrlWDW is not set in the guestIdentity config. ' +
                                    'Cannot proceed to initialize the ID.me launcher button configuration.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Brand code is not detected in the guestIdentity model. ' +
                                'Cannot proceed to initialize the ID.me launcher button configuration.');
                        }
                        if (isClientIdSet) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Client ID is set in the ID.me launcher button configuration. ' +
                                'Proceeding to initialize the ID.me launcher button configuration...');
                            if (isRedirectUriSet) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> dataRedirectUri is set in the ID.me launcher button configuration ' + 
                                    'with the following guestIdentityIdMeCallbackUrl -> ' + idMeLauncherButtonConfig.dataRedirectUri);
                                if (UTILS.isStringAndNotEmpty(GUEST_IDENTITY_CONFIG.guestIdentityIdMeAuthorizeUrl)) {
                                    idMeLauncherButtonConfig.dataAuthorizeUrl = GUEST_IDENTITY_CONFIG.guestIdentityIdMeAuthorizeUrl;
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> dataAuthorizeUrl is set in the ID.me launcher button configuration ' + 
                                        'with the following guestIdentityIdMeAuthorizeUrl -> ' + GUEST_IDENTITY_CONFIG.guestIdentityIdMeAuthorizeUrl);
                                    GUEST_IDENTITY_MODEL.isIdMeLauncherButtonConfigInitialized = true;
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button configuration is 100% initialized.');
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guestIdentityIdMeAuthorizeUrl is not set in the guestIdentity config. ' +
                                        'Cannot proceed to initialize the ID.me launcher button configuration.');
                                }
                                if (UTILS.isStringAndNotEmpty(GUEST_IDENTITY_CONFIG.guestAffiliationsSortOrderMapKeys)) {
                                    GUEST_IDENTITY_MODEL.guestAffiliationsSortOrderMapKeys = GUEST_IDENTITY_CONFIG.guestAffiliationsSortOrderMapKeys;
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> guestAffiliationsSortOrderMapKeys is set in the guestIdentity config. ' +
                                        'Proceeding to initialize the guest affiliations sort order map keys...');
                                    const GUEST_AFFILIATIONS_SORT_ORDER_MAP_KEYS_ARRAY = GUEST_IDENTITY_CONFIG.guestAffiliationsSortOrderMapKeys.split(',');
                                    GUEST_IDENTITY_MODEL.guestAffiliationsSortOrderMapKeysArray = 
                                        GUEST_AFFILIATIONS_SORT_ORDER_MAP_KEYS_ARRAY.map((key) => key.trim());
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> guestAffiliationsSortOrderMapKeys array is initialized. ' +
                                        'Guest affiliations sort order map keys array is -> ' + 
                                        JSON.stringify(GUEST_IDENTITY_MODEL.guestAffiliationsSortOrderMapKeysArray));
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guestAffiliationsSortOrderMapKeys is not set in the guestIdentity config. ' +
                                        'Cannot proceed to initialize the guest affiliations sort order map keys.');
                                }
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Proceeding to initialize the interstitial element...');
                                const INTERSTITIAL_ELEMENT = GUEST_IDENTITY_VIEW.interstitial.ensureMounted();
                                if (INTERSTITIAL_ELEMENT) {
                                    GUEST_IDENTITY_MODEL.isInterstitialMountedInDOM = true;
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Interstitial element is mounted to the DOM successfully! :-)');
                                } else {
                                    GUEST_IDENTITY_MODEL.isInterstitialMountedInDOM = false;
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to mount the interstitial element to the DOM. ' +
                                        'Cannot proceed to initialize the interstitial element.');
                                }
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guestIdentityIdMeCallbackUrl for the current brand ' + BRAND_CODE +
                                    ' is not set in the guestIdentity config. ' +
                                    'Cannot proceed to initialize the ID.me launcher button configuration.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Client ID is not set in the ID.me launcher button configuration ' +
                                'for the current brand ' + BRAND_CODE + ' in the guestIdentity config. ' +
                                'Cannot proceed to initialize the ID.me launcher button configuration.');
                        }
                        if (GUEST_IDENTITY_MODEL.isIdMeLauncherButtonConfigInitialized) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me launcher button configuration is initialized.');
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button configuration is not initialized. ' +
                                'Cannot proceed to create the ID.me launcher button element.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me launcher button configuration is not detected in the guestIdentity model. ' +
                            'Cannot proceed to initialize the ID.me launcher button.');
                    }
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    GUEST_IDENTITY_CONTROLLER.buildIndexedArrays();
                    GUEST_IDENTITY_CONTROLLER.attachIdMeCallbackCompleteMessageListener();
                    await GUEST_IDENTITY_CONTROLLER.detectOneIdProcessingComplete();
                },
                isTestParamAPRenewableActive: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_IS_TEST_PARAM_AP_RENEWABLE_ACTIVE_';
                    console.log(LOG_MESSAGE_PREFIX + ' -> Checking if the test parameter AP Renewable is active...');
                    const UTILS = wdprProfileNav.main.utils;
                    const TEST_PARAMETERS = wdprProfileNav.features.guestIdentity.model.testParameters;
                    const IS_TEST_PARAM_AP_RENEWABLE_ACTIVE = wdprProfileNav.features.guestIdentity.constants.queryParameters.IS_TEST_PARAM_AP_RENEWABLE_ACTIVE;
                    const queryParamValue = UTILS.getQueryParamValueByName(IS_TEST_PARAM_AP_RENEWABLE_ACTIVE);
                    if (queryParamValue === 'true') {
                        TEST_PARAMETERS.isTestParamAPRenewableActive = true;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Test parameter AP Renewable is active. Returning true.');
                    } else {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Test parameter AP Renewable is not active (query param missing or not \"true\").');
                    }
                    return TEST_PARAMETERS.isTestParamAPRenewableActive;
                },
                buildIndexedArrays: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_BUILD_INDEXED_ARRAYS_';
                    console.log(LOG_MESSAGE_PREFIX + ' -> Building indexed arrays...');
                    const ID_ME_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.idMe;
                    ID_ME_CONSTANTS.ID_ME_DATA_SCOPE_TYPES_ARRAY = Object.values(ID_ME_CONSTANTS.ID_ME_DATA_SCOPE_TYPES);
                    ID_ME_CONSTANTS.ID_ME_BUTTON_TYPES_ARRAY = Object.values(ID_ME_CONSTANTS.ID_ME_BUTTON_TYPES);
                    ID_ME_CONSTANTS.ID_ME_VERIFIED_BADGES_ARRAY = Object.values(ID_ME_CONSTANTS.ID_ME_VERIFIED_BADGES);
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Indexed arrays built successfully.');
                },
                detectOneIdProcessingComplete: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_DETECT_ONEID_PROCESSING_COMPLETE_';
                    console.log(LOG_MESSAGE_PREFIX + ' -> Attempting to detect if the OneID processing is complete...');
                    const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                    const EWCS_MODEL_GUEST_INFO = wdprProfileNav.features.ewcs.model.guestInfo;
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    const UTILS = wdprProfileNav.main.utils;
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalFrequencyMs;
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalMaxAttempts;
                    const INTERVAL_DETECTION_MODULUS_FREQUENCY =
                        wdprProfileNav.main.constants.INTERVAL_DETECTION_MODULUS_FREQUENCY;
                    const ONEID_PROCESSING_COMPLETE_DETECTOR_INTERVAL = setInterval(async function() {
                        GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount = 
                            GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount + 1;
                        if (GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount <= PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS) {
                            if (EWCS_MODEL_GUEST_INFO.isGuestInfoOneIdProcessingComplete) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> OneID processing is complete.  EWCS_MODEL_GUEST_INFO data is -> ' +
                                    JSON.stringify(EWCS_MODEL_GUEST_INFO));
                                clearInterval(ONEID_PROCESSING_COMPLETE_DETECTOR_INTERVAL);
                                await GUEST_IDENTITY_CONTROLLER.setGuestProfileData(EWCS_MODEL_GUEST_INFO);
                                GUEST_IDENTITY_CONTROLLER.eventEmitters.guestProfileReadyEventEmitter();
                                wdprProfileNav.features.guestIdentity.model.guestProfile.isGuestProfileReady = true;
                            } else {
                                if (GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount === 1 || 
                                    GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount % INTERVAL_DETECTION_MODULUS_FREQUENCY === 0) {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> The OneID processing not detected as fully complete ' +
                                        'in the browser window ' + GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount + ' of ' +
                                        PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                        ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                        'Retrying detection...');
                                }
                            }
                        } else {
                            GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount =
                                GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount - 1;
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect the OneID processing as fully complete with ' +
                                'attempt count ' + GUEST_IDENTITY_MODEL.oneIdProcessingCompleteDetectionAttemptCount + ' of ' +
                                PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                'Stopping further detection attempts.');
                            clearInterval(ONEID_PROCESSING_COMPLETE_DETECTOR_INTERVAL);
                        }
                    }, PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS);
                },
                detectAffiliationsProcessingComplete: async function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_DETECT_AFFILIATIONS_PROCESSING_COMPLETE_';
                    console.log(LOG_MESSAGE_PREFIX + ' -> Attempting to detect if the affiliations processing is complete...');
                    const GUEST_IDENTITY_MODEL_GUEST_PROFILE = wdprProfileNav.features.guestIdentity.model.guestProfile;
                    const GUEST_IDENTITY_MODEL = wdprProfileNav.features.guestIdentity.model;
                    const UTILS = wdprProfileNav.main.utils;
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalFrequencyMs;
                    const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS =
                        wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalMaxAttempts;
                    let observerAffiliationsProcessingCompleteDetectionAttemptCount = 0;
                    while (observerAffiliationsProcessingCompleteDetectionAttemptCount 
                        <= PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS) {
                        observerAffiliationsProcessingCompleteDetectionAttemptCount =
                            observerAffiliationsProcessingCompleteDetectionAttemptCount + 1;
                        if (GUEST_IDENTITY_MODEL_GUEST_PROFILE.isAnonmymous) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is anonymous. No affiliation data will be retrieved.');
                            break;
                        } else if (GUEST_IDENTITY_MODEL_GUEST_PROFILE.isGuestAffiliationsReady) {
                            const AFFILIATIONS_ARRAY = GUEST_IDENTITY_MODEL_GUEST_PROFILE.affiliationInfo.affiliations;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliations processing is complete. There are ' + 
                                AFFILIATIONS_ARRAY.length + ' affiliations detected in the guest profile.');
                            break;
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> The affiliations processing not detected as fully complete ' +
                                'in the browser window ' +
                                observerAffiliationsProcessingCompleteDetectionAttemptCount + ' of ' +
                                PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                                ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                                'Retrying detection...');
                            await UTILS.delay(PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS);
                        }
                    }
                    if (!GUEST_IDENTITY_MODEL_GUEST_PROFILE.isGuestAffiliationsReady) {
                        observerAffiliationsProcessingCompleteDetectionAttemptCount =
                        observerAffiliationsProcessingCompleteDetectionAttemptCount - 1;
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect the affiliations processing as fully complete ' +
                            'with attempt count ' +
                            observerAffiliationsProcessingCompleteDetectionAttemptCount + ' of ' +
                            PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                            ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                            'Stopping further detection attempts.');
                    }
                },
                isAffiliationOwnedByLoggedInGuest: function(affiliation) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_IS_AFFILIATION_OWNED_BY_LOGGED_IN_GUEST_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking if affiliation is owned by logged in guest...');
                    const UTILS = wdprProfileNav.main.utils;
                    const GUEST_IDENTITY_MODEL_GUEST_PROFILE = wdprProfileNav.features.guestIdentity.model.guestProfile;
                    const GUEST_PROFILE_MODEL = wdprProfileNav.features.guestIdentity.model.guestProfile;
                    let isAffiliationOwnedByLoggedInGuest = false;
                    if (affiliation) {
                        let affiliationSwid = null;
                        if (affiliation.guest) {
                            if (affiliation.guest.guestIdType === 'swid') {
                                if (UTILS.isStringAndNotEmpty(affiliation.guest.guestIdValue)) {
                                    affiliationSwid = affiliation.guest.guestIdValue;
                                }
                            }
                        }
                        if (UTILS.isStringAndNotEmpty(affiliationSwid)) {
                            if (GUEST_PROFILE_MODEL) {
                                if (GUEST_PROFILE_MODEL.swid === affiliationSwid) {
                                    isAffiliationOwnedByLoggedInGuest = true;
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliation is owned by logged in guest. Returning true.');
                                } else {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARNING -> Guest profile swid does not match the ' +
                                        'affiliation swid. Returning false.');
                                }
                            } else {
                                console.warn(LOG_MESSAGE_PREFIX + 'WARNING -> Guest profile model is null. Returning false.');
                            }
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARNING -> Affiliation swid is null or undefined. Returning false.');
                        }
                    }
                    return isAffiliationOwnedByLoggedInGuest;
                },
                processGuestAffiliations: function(guestAffiliationsArray) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_PROCESS_GUEST_AFFILIATIONS_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing guest affiliations array with length -> ' + 
                        guestAffiliationsArray.length + '...');
                    const UTILS = wdprProfileNav.main.utils;
                    const GUEST_IDENTITY_MODEL_GUEST_PROFILE = wdprProfileNav.features.guestIdentity.model.guestProfile;
                    const AFFILIATION_TYPE_RESIDENCY = 
                        wdprProfileNav.features.guestIdentity.constants.affiliations.AFFILIATION_TYPE.RESIDENCY;
                    const AFFILIATION_TYPE_RESIDENCY_SUBTYPE_FLORIDA = 
                        wdprProfileNav.features.guestIdentity.constants.affiliations.AFFILIATION_TYPE_RESIDENCY_SUBTYPE.FLORIDA;
                    const AFFILIATION_TYPE_MILITARY = 
                        wdprProfileNav.features.guestIdentity.constants.affiliations.AFFILIATION_TYPE.MILITARY;
                    const AFFILIATION_TYPE_MILITARY_SUBTYPE = 
                        wdprProfileNav.features.guestIdentity.constants.affiliations.AFFILIATION_TYPE_MILITARY_SUBTYPE;
                    if (guestAffiliationsArray) {
                        for (const affiliation of guestAffiliationsArray) {
                            if (affiliation.type === AFFILIATION_TYPE_RESIDENCY) {
                                if (UTILS.isStringAndNotEmpty(affiliation.subType)) {
                                    if (affiliation.subType === AFFILIATION_TYPE_RESIDENCY_SUBTYPE_FLORIDA) {
                                        GUEST_IDENTITY_MODEL_GUEST_PROFILE.affiliationInfo.isFloridaResident = true;
                                    }
                                } else {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to process guest affiliation as the ' +
                                        'affiliation.subType is null or undefined.  Affiliation data is -> ' +
                                        JSON.stringify(affiliation));
                                }
                            } else if (affiliation.type === AFFILIATION_TYPE_MILITARY) {
                                GUEST_IDENTITY_MODEL_GUEST_PROFILE.affiliationInfo.isMilitary = true;
                                if (UTILS.isStringAndNotEmpty(affiliation.subType)) {
                                    if (affiliation.subType === AFFILIATION_TYPE_MILITARY_SUBTYPE.SERVICE_MEMBER) {
                                        GUEST_IDENTITY_MODEL_GUEST_PROFILE.affiliationInfo.isMilitaryServiceMember = true;
                                    } else if (affiliation.subType === AFFILIATION_TYPE_MILITARY_SUBTYPE.RETIREE) {
                                        GUEST_IDENTITY_MODEL_GUEST_PROFILE.affiliationInfo.isMilitaryRetiree = true;
                                    } else if (affiliation.subType === AFFILIATION_TYPE_MILITARY_SUBTYPE.SPOUSE) {
                                        GUEST_IDENTITY_MODEL_GUEST_PROFILE.affiliationInfo.isMilitarySpouse = true;
                                    }
                                }
                            }
                        }
                    }
                },
                processTravelAgentGuestAffiliations: function(guestAffiliationsArray) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_PROCESS_TRAVEL_AGENT_GUEST_AFFILIATIONS_';
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Processing travel agent guest affiliations array...');
                    const UTILS = wdprProfileNav.main.utils;
                    const TRAVEL_AGENT_GUEST_PROFILE = wdprProfileNav.main.model.travelAgent.guestProfile;
                    const AFFILIATION_TYPE_RESIDENCY = 
                        wdprProfileNav.features.guestIdentity.constants.affiliations.AFFILIATION_TYPE.RESIDENCY;
                    const AFFILIATION_TYPE_RESIDENCY_SUBTYPE_FLORIDA = 
                        wdprProfileNav.features.guestIdentity.constants.affiliations.AFFILIATION_TYPE_RESIDENCY_SUBTYPE.FLORIDA;
                    const AFFILIATION_TYPE_MILITARY = 
                        wdprProfileNav.features.guestIdentity.constants.affiliations.AFFILIATION_TYPE.MILITARY;
                    if (guestAffiliationsArray) {
                        for (const affiliation of guestAffiliationsArray) {
                            if (affiliation.type === AFFILIATION_TYPE_RESIDENCY) {
                                if (UTILS.isStringAndNotEmpty(affiliation.subType)) {
                                    if (affiliation.subType === AFFILIATION_TYPE_RESIDENCY_SUBTYPE_FLORIDA) {
                                        TRAVEL_AGENT_GUEST_PROFILE.affiliationInfo.isFloridaResident = true;
                                    }
                                } else {
                                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to process guest affiliation as the ' +
                                        'affiliation.subType is null or undefined.  Affiliation data is -> ' +
                                        JSON.stringify(affiliation));
                                }
                            } else if (affiliation.type === AFFILIATION_TYPE_MILITARY) {
                                TRAVEL_AGENT_GUEST_PROFILE.affiliationInfo.isMilitary = true;
                            }
                        }
                    }
                },
                setGuestProfileData: async function(ewcsGuestInfo) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_SET_GUEST_PROFILE_DATA_';
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    if (ewcsGuestInfo) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Setting guest profile data with the following data: ' +
                            JSON.stringify(ewcsGuestInfo));
                        const PROFILE_AUTH_GUEST = wdprProfileNav.main.model.profileAuthGuest;
                        const GUEST_PROFILE_MODEL = wdprProfileNav.features.guestIdentity.model.guestProfile;
                        GUEST_PROFILE_MODEL.swid = ewcsGuestInfo.guestSwid;
                        GUEST_PROFILE_MODEL.accessToken = ewcsGuestInfo.guestAccessToken;
                        GUEST_PROFILE_MODEL.clientId = ewcsGuestInfo.guestClientId;
                        GUEST_PROFILE_MODEL.isAnonmymous = ewcsGuestInfo.isAnonymous;
                        if (PROFILE_AUTH_GUEST) {
                            GUEST_PROFILE_MODEL.profileAuthInfo = PROFILE_AUTH_GUEST;
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to set guest profile profileAuthInfo data as ' +
                                'profileAuthGuest is null.');
                        }
                        if (!GUEST_PROFILE_MODEL.isAnonmymous) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Access token is not null. Retrieving guest profile affiliation ' +
                                'data from /affiliations endpoint...');
                            const GUEST_AFFILIATIONS_ARRAY = 
                                await GUEST_IDENTITY_CONTROLLER.getAffiliationsFromAffiliationsEndpoint(GUEST_PROFILE_MODEL);
                            if (GUEST_AFFILIATIONS_ARRAY) {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved ' + GUEST_AFFILIATIONS_ARRAY.length + ' guest profile affiliation data from ' +
                                    'the /affiliations endpoint.');
                                GUEST_PROFILE_MODEL.affiliationInfo.affiliations = GUEST_AFFILIATIONS_ARRAY;
                                GUEST_IDENTITY_CONTROLLER.processGuestAffiliations(GUEST_AFFILIATIONS_ARRAY);
                                GUEST_PROFILE_MODEL.isGuestAffiliationsReady = true;
                                GUEST_IDENTITY_CONTROLLER.eventEmitters.guestAffiliationsReadyEventEmitter();
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to retrieve guest profile affiliation data as the ' +
                                    '/affiliations endpoint returned no data.');
                            }
                        } else {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest is anonymous. No affiliation data will be retrieved.');
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to set guest profile data as guestInfo is null.');
                    }
                },
                isGuestProfileValid: function(guestProfile) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_IS_GUEST_PROFILE_VALID_';
                    const UTILS = wdprProfileNav.main.utils;
                    let isGuestProfileValid = true;
                    if (guestProfile) {
                        if (!UTILS.isStringAndNotEmpty(guestProfile.swid)) {
                            isGuestProfileValid = false;
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Guest profile is not valid as the guest\'s swid is null or undefined.');
                        }
                        if (!UTILS.isStringAndNotEmpty(guestProfile.accessToken)) {
                            isGuestProfileValid = false;
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Guest profile is not valid as the guest\'s access token is null or undefined.');
                        }
                        if (!UTILS.isStringAndNotEmpty(guestProfile.clientId)) {
                            isGuestProfileValid = false;
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Guest profile is not valid as the guest\'s client id is null or undefined.');
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Guest profile is not valid as the guest profile is null or undefined.');
                    }
                    return isGuestProfileValid;
                },
                getAffiliationsFromAffiliationsEndpoint: async function(guestProfile) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_GET_AFFILIATIONS_FROM_AFFILIATIONS_ENDPOINT_';
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    const GUEST_PROFILE_MODEL = wdprProfileNav.features.guestIdentity.model.guestProfile;
                    let guestAffiliationsArray = [];
                    let isGuestProfileValid = GUEST_IDENTITY_CONTROLLER.isGuestProfileValid(guestProfile);
                    if (isGuestProfileValid) {
                        const GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH =
                            wdprProfileNav.config.features.guestIdentityConfig.guestIdentityAffiliationsEndpointPath;
                        const AFFILIATIONS_ENDPOINT_PATH_SWID_PARSE_TARGET =
                            wdprProfileNav.features.guestIdentity.constants.affiliations.AFFILIATIONS_ENDPOINT_PATH_SWID_PARSE_TARGET;
                        const GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID = 
                            GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH.replace(AFFILIATIONS_ENDPOINT_PATH_SWID_PARSE_TARGET, guestProfile.swid);
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Getting guest affiliations list for guest profile with swid -> ' + 
                            guestProfile.swid + ' and endpoint path -> ' + GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + ' ...');
                        try {
                            const response = await fetch(GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID, {
                                method: 'GET',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': 'Bearer ' + guestProfile.accessToken,
                                    'x-disney-identity-client-id': guestProfile.clientId
                                }
                            });
                            if (response.ok) {
                                const OK_RESPONSE_JSON = await response.json();
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully received a 200 OK response from fetch request to ' + 
                                    GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + ' to retrieve guest affiliations list with the ' +
                                    'following response and will inspect response data...');
                                if (OK_RESPONSE_JSON.affiliationsResource) {
                                    const AFFILIATIONS_RESOURCE = OK_RESPONSE_JSON.affiliationsResource;
                                    if (AFFILIATIONS_RESOURCE.affiliations) {
                                        const AFFILIATIONS = AFFILIATIONS_RESOURCE.affiliations;
                                        if (Array.isArray(AFFILIATIONS)) {
                                            guestAffiliationsArray = AFFILIATIONS;
                                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved ' + guestAffiliationsArray.length +
                                                ' guest affiliations from response from ' + GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + 
                                                ' endpoint.');
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guestAffiliationsList is NOT an array in the ' +
                                                'response from the ' + GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + ' endpoint to ' +
                                                'retrieve guest affiliations list. The \"entries\" field is detected in the response data ' +
                                                'but it is NOT an array.  Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON));
                                        }
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guestAffiliationsList is null or undefined in the ' +
                                            'response from the ' + GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + ' endpoint to ' +
                                            'retrieve guest affiliations list. The \"entries\" field in the response data is null or undefined. ' +
                                            'Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON));
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> affiliationsResource is null or undefined in the ' +
                                        'response from the ' + GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + ' endpoint to ' +
                                        'retrieve guest affiliations list. The \"affiliationsResource\" field in the response data is null or undefined. ' +
                                        'Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON));
                                }
                                if (OK_RESPONSE_JSON.profileResource) {
                                    const PROFILE_RESOURCE = OK_RESPONSE_JSON.profileResource;
                                    if (PROFILE_RESOURCE.profile) {
                                        GUEST_PROFILE_MODEL.profileInfo = PROFILE_RESOURCE;
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> profile is null or undefined in the ' +
                                            'response from the ' + GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + ' endpoint to ' +
                                            'retrieve guest affiliations list. The \"profile\" field in the response data is null or undefined. ' +
                                            'Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON));
                                    }
                                } else {
                                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> profileResource is null or undefined in the ' +
                                        'response from the ' + GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + ' endpoint to ' +
                                        'retrieve guest affiliations list. The \"profileResource\" field in the response data is null or undefined. ' +
                                        'Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON));
                                }
                            } else {
                                const ERROR_RESPONSE_JSON = await response.json();
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Error retrieving guest affiliations list due to XHR response status code being ' +
                                    response.status + ' and NOT a 200 OK response code from the ' + GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID +
                                    ' endpoint. :-(\r' + 'Response from XHR request is ->', ERROR_RESPONSE_JSON);
                            }
                        } catch (error) {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Error retrieving guest affiliations list from the ' + 
                                GUEST_IDENTITY_AFFILIATIONS_ENDPOINT_PATH_WITH_SWID + ' endpoint due to fetch request error -> ' + error);
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to get guest affiliations list as the guest profile is not valid. ' +
                            'isGuestProfileValid = ' + isGuestProfileValid);
                    }
                    return guestAffiliationsArray;
                },
                isEmailAddressAndLastNameValid: function(emailAddress, lastName) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_IS_EMAIL_ADDRESS_AND_LAST_NAME_VALID_';
                    const UTILS = wdprProfileNav.main.utils;
                    let isEmailAddressAndLastNameValid = false;
                    if (UTILS.isStringAndNotEmpty(emailAddress)) {
                        if (UTILS.isStringAndNotEmpty(lastName)) {
                            isEmailAddressAndLastNameValid = true;
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Last name is not valid. Returning false.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Email address is not valid. Returning false.');
                    }
                    return isEmailAddressAndLastNameValid;
                },
                isTravelAgentValid: function(travelAgent) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_IS_TRAVEL_AGENT_VALID_';
                    const UTILS = wdprProfileNav.main.utils;
                    let isTravelAgentValid = false;
                    if (travelAgent) {
                        if (travelAgent.isTravelAgentContextDetected) {
                            if (UTILS.isStringAndNotEmpty(travelAgent.authorization)) {
                                isTravelAgentValid = true;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent is valid. Returning true.');
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Travel agent is not valid as the authorization ' + 
                                    'is null or undefined.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Travel agent is not valid as the travel agent context ' +
                                'is not detected.');
                        }
                        isTravelAgentValid = true;
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Travel agent is not defined. Returning false.');
                    }
                    return isTravelAgentValid;
                },
                getTravelAgentGuestProfileFromApiEndpoint: async function(travelAgent, emailAddress, lastName) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_GET_TRAVEL_AGENT_GUEST_PROFILE_FROM_API_ENDPOINT_';
                    const UTILS = wdprProfileNav.main.utils;
                    const GUEST_IDENTITY_CONTROLLER = wdprProfileNav.features.guestIdentity.controller;
                    const GUEST_IDENTITY_TRAVEL_AGENT_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.travelAgent;
                    const TRAVEL_AGENT_GUEST_PROFILE_MODEL = wdprProfileNav.main.model.travelAgent.guestProfile;
                    let travelAgentGuestProfile = null;
                    let isEmailAddressAndLastNameValid = 
                        GUEST_IDENTITY_CONTROLLER.isEmailAddressAndLastNameValid(emailAddress, lastName);
                    let isTravelAgentValid = 
                        GUEST_IDENTITY_CONTROLLER.isTravelAgentValid(travelAgent);
                    let isAllInputDataValid = false;
                    if (isTravelAgentValid) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent is valid. Getting travel agent guest profile from API endpoint...');
                        if (isEmailAddressAndLastNameValid) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Email address and last name are valid. Getting travel agent guest profile from API endpoint...');
                            isAllInputDataValid = true;
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to get travel agent guest profile from API endpoint as the email address and last name are not valid.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to get travel agent guest profile from API endpoint as the travel agent is not valid.');
                    }
                    if (isAllInputDataValid) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> All input data is valid. Getting travel agent guest profile from API endpoint...');
                        const TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH_TEMPLATE = 
                            GUEST_IDENTITY_TRAVEL_AGENT_CONSTANTS.TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH_TEMPLATE;
                        const EMAIL_ADDRESS_PARAM_PARSE_TARGET = 
                            GUEST_IDENTITY_TRAVEL_AGENT_CONSTANTS.EMAIL_ADDRESS_PARAM_PARSE_TARGET;
                        const LAST_NAME_PARAM_PARSE_TARGET = 
                            GUEST_IDENTITY_TRAVEL_AGENT_CONSTANTS.LAST_NAME_PARAM_PARSE_TARGET;
                        const TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH = 
                            TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH_TEMPLATE.replace(
                                EMAIL_ADDRESS_PARAM_PARSE_TARGET, emailAddress).replace(
                                    LAST_NAME_PARAM_PARSE_TARGET, lastName);
                        const TRAVEL_AGENT_AUTHORIZATION_TOKEN = travelAgent.authorization;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent guest profile endpoint path is -> ' + TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH);
                        try {
                            const response = await fetch(TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH, {
                                method: 'GET',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': 'Bearer ' + TRAVEL_AGENT_AUTHORIZATION_TOKEN,
                                }
                            });
                            if (response.ok) {
                                const OK_RESPONSE_JSON = await response.json();
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully received a 200 OK response from fetch request to ' + 
                                    TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH + ' to retrieve guest affiliations list with the ' +
                                    'following response and will inspect response for data ->' + JSON.stringify(OK_RESPONSE_JSON));
                                const TRAVEL_AGENT_GUEST_PROFILE_DATA = OK_RESPONSE_JSON.guestProfile;
                                if (TRAVEL_AGENT_GUEST_PROFILE_DATA) {
                                    if (UTILS.isStringAndNotEmpty(TRAVEL_AGENT_GUEST_PROFILE_DATA.swid)) {
                                        TRAVEL_AGENT_GUEST_PROFILE_MODEL.profileData = TRAVEL_AGENT_GUEST_PROFILE_DATA;
                                        TRAVEL_AGENT_GUEST_PROFILE_MODEL.swid = TRAVEL_AGENT_GUEST_PROFILE_DATA.swid;
                                        TRAVEL_AGENT_GUEST_PROFILE_MODEL.isSwidDetected = true;
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Travel agent guest profile data is not valid as the swid is null or undefined.');
                                    }
                                    if (UTILS.isStringAndNotEmpty(TRAVEL_AGENT_GUEST_PROFILE_DATA.xid)) {
                                        TRAVEL_AGENT_GUEST_PROFILE_MODEL.xid = TRAVEL_AGENT_GUEST_PROFILE_DATA.xid;
                                        TRAVEL_AGENT_GUEST_PROFILE_MODEL.isXidDetected = true;
                                    } else {
                                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Travel agent guest profile data is not valid as the xid is null or undefined.');
                                    }
                                    if (TRAVEL_AGENT_GUEST_PROFILE_DATA.affiliations) {
                                        if (TRAVEL_AGENT_GUEST_PROFILE_DATA.affiliations.entries) {
                                            const ENTRIES = TRAVEL_AGENT_GUEST_PROFILE_DATA.affiliations.entries;
                                            if (Array.isArray(ENTRIES)) {
                                                TRAVEL_AGENT_GUEST_PROFILE_MODEL.affiliationInfo.affiliations.push(...ENTRIES);
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved and added ' + ENTRIES.length +
                                                    ' guest affiliations list from response from ' + TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH +
                                                    ' with the following data ->' + JSON.stringify(ENTRIES));
                                                GUEST_IDENTITY_CONTROLLER.processTravelAgentGuestAffiliations(ENTRIES);
                                                TRAVEL_AGENT_GUEST_PROFILE_MODEL.isGuestAffiliationsReady = true;
                                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully processed travel agent guest affiliations with the following data -> ' + 
                                                    JSON.stringify(TRAVEL_AGENT_GUEST_PROFILE_MODEL.affiliationInfo));
                                            } else {
                                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guest affiliations list is NOT an array in the ' +
                                                    'response from the ' + TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH + ' endpoint to ' +
                                                    'retrieve guest affiliations list. The \"entries\" field is detected in the response data ' +
                                                    'but it is NOT an array.  Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON));
                                            }
                                        } else {
                                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> guest affiliations list is null or undefined in the ' +
                                                'response from the ' + TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH + ' endpoint to ' +
                                                'retrieve guest affiliations list. The \"entries\" field in the response data is null or undefined. ' +
                                                'Response data is -> ' + JSON.stringify(OK_RESPONSE_JSON));
                                        }
                                    }
                                    travelAgentGuestProfile = TRAVEL_AGENT_GUEST_PROFILE_MODEL;
                                    travelAgentGuestProfile.isSwidProcessingComplete = true;
                                    travelAgentGuestProfile.isProfileDataReady = true;
                                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully retrieved travel agent guest profile from API endpoint with the following data -> ' + 
                                        JSON.stringify(travelAgentGuestProfile));
                                }
                            } else {
                                const ERROR_RESPONSE_JSON = await response.json();
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Error retrieving guest affiliations list due to XHR response status code being ' +
                                    response.status + ' and NOT a 200 OK response code from the ' + TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH +
                                    ' endpoint. :-(\r' + 'Response from XHR request is ->', ERROR_RESPONSE_JSON);
                            }
                        } catch (error) {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Error retrieving guest affiliations list from the ' + 
                                TRAVEL_AGENT_GUEST_PROFILE_ENDPOINT_PATH + ' endpoint due to fetch request error -> ' + error);
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to get travel agent guest profile from API endpoint as the input data is not valid.');
                    }
                    return TRAVEL_AGENT_GUEST_PROFILE_MODEL;
                },
                getIdMeJsSdkUrl: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_GET_ID_ME_JS_SDK_URL_';
                    const UTILS = wdprProfileNav.main.utils;
                    const GUEST_IDENTITY_CONFIG = wdprProfileNav.config.features.guestIdentityConfig;
                    let idMeJsSdkUrl = null;
                    if (GUEST_IDENTITY_CONFIG) {
                        if (UTILS.isStringAndNotEmpty(GUEST_IDENTITY_CONFIG.guestIdentityIdMeJsSdkUrl)) {
                            idMeJsSdkUrl = GUEST_IDENTITY_CONFIG.guestIdentityIdMeJsSdkUrl;
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to set the idMeJsSdkUrl as the ' +
                                'guestIdentityIdMeJsSdkUrl is not a valid string.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to set the idMeJsSdkUrl as the ' +
                            'guestIdentityConfig is null.');
                    }
                    return idMeJsSdkUrl;
                },
                loadIdMeSdkScript: function() {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_LOAD_ID_ME_SDK_SCRIPT_';
                    const UTILS = wdprProfileNav.main.utils;
                    const ID_ME_JS_SDK_URL = wdprProfileNav.features.guestIdentity.controller.getIdMeJsSdkUrl();
                    let formattedIdMeJsSdkUrl = null;
                    return new Promise((resolve, reject) => {
                        let isAllDataRequiredForIdMeScriptLoadPresent = true;
                        if (ID_ME_JS_SDK_URL) {
                            if (UTILS.isStringAndNotEmpty(ID_ME_JS_SDK_URL)) {
                                formattedIdMeJsSdkUrl = ID_ME_JS_SDK_URL;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me JS SDK URL for Guest Identity feature is \"' + 
                                    formattedIdMeJsSdkUrl + '\" based on the provided configuration.');
                            } else {
                                isAllDataRequiredForIdMeScriptLoadPresent = false;
                                formattedIdMeJsSdkUrl = null;
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to set the ID.me JS SDK URL for Guest Identity ' +
                                    'feature as the formattedIdMeJsSdkUrl is not a valid string');
                            }
                        } else {
                            isAllDataRequiredForIdMeScriptLoadPresent = false;
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ID.me JS SDK URL for EWCS feature is null or undefined based ' +
                                'on the provided configuration. ' +
                                'Attempting to load ID.me JS SDK script without a src URL will fail.');
                        }
                        if (isAllDataRequiredForIdMeScriptLoadPresent) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> All required data for loading OneTrust script for EWCS feature is present. ' +
                                'formattedOneTrustJsSdkUrl -> \"' + formattedIdMeJsSdkUrl + '\"' +
                                '\rProceeding to load ID.me JS SDK script by adding a script tag to the document head with the appropriate attributes ' +
                                'needed for ID.me JS SDK initialization...');
                            const ID_ME_SDK_SCRIPT_DOM_ELEMENT = document.createElement('script');
                            ID_ME_SDK_SCRIPT_DOM_ELEMENT.src = formattedIdMeJsSdkUrl;
                            ID_ME_SDK_SCRIPT_DOM_ELEMENT.onload = () => {
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> ID.me JS SDK script loaded successfully! :-)');
                                resolve();
                            };
                            ID_ME_SDK_SCRIPT_DOM_ELEMENT.onerror = (error) => {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to load ID.me JS SDK script: ' + error);
                                reject(error);
                            };
                            document.head.appendChild(ID_ME_SDK_SCRIPT_DOM_ELEMENT);
                        } else {
                            const ERROR_MESSAGE = 'Missing required data for loading ID.me script for Guest Identity feature. ' +
                                'One or more of the following required data is missing: ID_ME_JS_SDK_URL. ' + 
                                'Please see prior error messages to confirm which is missing. ' +
                                '\rCannot load ID.me JS SDK script without all required data being present.';
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> ' + ERROR_MESSAGE);
                            reject(new Error(ERROR_MESSAGE));
                        }
                    });
                },
                isIdMeDataScopeValid: function(dataScope) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_IS_ID_ME_DATA_SCOPE_VALID_';
                    const UTILS = wdprProfileNav.main.utils;
                    const ID_ME_CONSTANTS = wdprProfileNav.features.guestIdentity.constants.idMe;
                    let isIdMeDataScopeValid = false;
                    if (UTILS.isStringAndNotEmpty(dataScope)) {
                        // TODO: Fix this method to reference a different array that is created in the model at initialization time.
                        if (ID_ME_CONSTANTS.ID_ME_DATA_SCOPE_TYPES_ARRAY.includes(dataScope)) {
                            isIdMeDataScopeValid = true;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Data scope -> \"' + dataScope + '\" is a valid data scope.');
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Data scope -> \"' + dataScope + '\" is not a valid data scope.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Data scope is not a valid value.');
                    }
                    return isIdMeDataScopeValid;
                },
                isIdMeButtonIdValid: function(buttonId) {
                    const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                        'FEATURE_GUEST_IDENTITY_IS_ID_ME_BUTTON_ID_VALID_';

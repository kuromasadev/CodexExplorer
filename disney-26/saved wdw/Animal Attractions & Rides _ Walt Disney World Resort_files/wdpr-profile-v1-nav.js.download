*/

const wdprProfileNav = {
    config: {
        features: {
            enterpriseWideConsentSyncConfig: {"isEnterpriseWideConsentSyncEnabled":"true","enterpriseWideConsentSyncEnabledBrands":["DLR","WDW","DCL","PD","HH","VB","DVC","AUL","DGC"],"enterpriseWideConsentSyncOneTrustSdkDlrEnabledLocales":["en-US","es-ES"],"enterpriseWideConsentSyncOneTrustSdkWdwEnabledLocales":["en-US","es-ES"],"enterpriseWideConsentSyncOneTrustSdkDclEnabledLocales":["en-US","es-ES"],"enterpriseWideConsentSyncOneTrustSdkPdEnabledLocales":["en-US","es-ES"],"enterpriseWideConsentSyncOneTrustSdkHhEnabledLocales":["en-US","es-ES"],"enterpriseWideConsentSyncOneTrustSdkVbEnabledLocales":["en-US","es-ES"],"enterpriseWideConsentSyncOneTrustSdkDvcEnabledLocales":["en-US","es-ES"],"enterpriseWideConsentSyncOneTrustSdkAulEnabledLocales":["en-US","es-ES"],"enterpriseWideConsentSyncOneTrustSdkDgcEnabledLocales":["en-US","es-ES"],"oneIdGraphQlEndpointUrl":"https://login.disney.com/api/graphql","oneTrustJsSdkUrl":"https://cdn.cookielaw.org/consent/JS_DATA_DOMAIN/otSDKStub.js","oneTrustJsDataDomainDLR":"97b8cff7-e3cb-4508-98dd-c0bb34978138","oneTrustJsDataDomainWDW":"42fca394-9b6c-42bb-9f1f-b4cf05e572ac","oneTrustJsDataDomainDCL":"676e6411-e749-41e2-afdc-90c4a39144f7","oneTrustJsDataDomainPD":"231ff817-513a-4374-86b7-3d72f26ae10d","oneTrustJsDataDomainHH":"6d1e1dc8-e19e-40f7-a524-c573252c96c5","oneTrustJsDataDomainVB":"f61d9eef-9faf-46cb-a034-2825f6ab6e74","oneTrustJsDataDomainDVC":"5cf7a9fa-488e-40be-975d-65dcd7e11991","oneTrustJsDataDomainAUL":"02060ddc-39c9-445c-ad29-3d1769e6d42d","oneTrustJsDataDomainDGC":"3e953dba-a841-43d3-ba66-6d905b319432","footerDomElementSelectorDLR":"footer.syndicated-footer-wrapper","footerDomElementSelectorWDW":"footer.syndicated-footer-wrapper","footerDomElementSelectorDCL":"footer.syndicated-footer-wrapper","footerDomElementSelectorPD":"ul.syndicated-legal__links--legalFooter","footerDomElementSelectorHH":"footer.syndicated-footer-wrapper","footerDomElementSelectorVB":"footer.syndicated-footer-wrapper","footerDomElementSelectorDVC":"footer.syndicated-footer-wrapper","footerDomElementSelectorAUL":"footer.syndicated-footer-wrapper","footerDomElementSelectorDGC":"footer.footer-links","oneTrustTokenMaxAgeMinutes":"10","pepProfileAuthDetectorIntervalFrequencyMs":"100","pepProfileAuthDetectorIntervalMaxAttempts":"400"},
            guestIdentityConfig: {"isGuestIdentityEnabled":"true","guestIdentityEnabledBrands":["DLR","WDW","DCL"],"guestIdentityAffiliationsEndpointPath":"/profile/guest-services/v1/B2C_GUEST_LOGIN_SWID/guest-profile","guestIdentityIdMeClientIdDLR":"UPDATE_ME","guestIdentityIdMeClientIdWDW":"UPDATE_ME","guestIdentityIdMeClientIdDCL":"76d0a4f16568e4664ddd1986105b7bef","guestIdentityIdMeJsSdkUrl":"https://s3.amazonaws.com/idme/developer/idme-buttons/assets/js/idme-wallet-button.js","guestIdentityIdMeCallbackUrlDLR":"https://disneyland.disney.go.com/profile/guest-services/identity-verification-callback","guestIdentityIdMeCallbackUrlWDW":"https://disneyworld.disney.go.com/profile/guest-services/identity-verification-callback","guestIdentityIdMeCallbackUrlDCL":"https://disneycruise.disney.go.com/profile/guest-services/identity-verification-callback","guestIdentityIdMeAuthorizeUrl":"https://api.idmelabs.com/oauth/authorize","guestAffiliationsSortOrderMapKeys":"AnnualPass,MILITARY||SERVICE_MEMBER,MILITARY||SPOUSE,MILITARY||RETIREE,GEOGRAPHIC||FL_RESIDENT,RESIDENCY||FLORIDA,GEOGRAPHIC||BAJA_RESIDENT,GEOGRAPHIC||NOCAL_RESIDENT,GEOGRAPHIC||SOCAL_RESIDENT,GEOGRAPHIC||TX_RESIDENT,GEOGRAPHIC||CANADA_RESIDENT,CASTAWAYCLUB,DVC,CAST,NON_CAST,D23,PREMIERE,DISNEY_STREAMING,DISNEY_STREAMING_PERKS,DISNEY_CARD_MEMBER,GOLDEN_OAK","isTravelAgentEnabled":false,"isMembershipAndPassesGuestIdentityVerificationEnabled":false,"guestIdentityAffiliationSiteUrlDLR":"https://disneyland.disney.go.com","guestIdentityAffiliationSiteUrlWDW":"https://disneyworld.disney.go.com","guestIdentityAffiliationSiteUrlDCL":"https://disneycruise.disney.go.com"}
        }
    },
    main: {
        model: {
            baseUrl: '',
            isMobileDevice: false,
            brandCode: '',
            profileAuthGuest: null,
            locale: {
                currentSelectedLocaleCode: null,
                currentSelectedLocaleCookieData: null,
            },
            travelAgent: {
                isTravelAgentContextDetected: false,
                authorization: null,
                sessionTime: null,
                ticketData: null,
                guestProfile: {
                    swid: null,
                    xid: null,
                    isSwidDetected: false,
                    isXidDetected: false,
                    isSwidProcessingComplete: false,
                    isGuestAffiliationsReady: false,
                    isProfileDataReady: false,
                    affiliationInfo: {
                        isFloridaResident: false,
                        isMilitary: false,
                        affiliations: []
                    },
                    profileData: null
                },
                isTravelAgentDataReady: false,
                isTravelAgentGuestProfileDataReady: false,
            },
            reporting: {
                performance: {
                    appInitStartTimeMs: 0,
                    appInitStartTimeAfterDomReadyMs: 0,
                    appInitEndTimeMs: 0,
                    processTimeForFullAppInitAfterDomReadyMs: 0,
                    processTimeForFullAppInitBeforeDomReadyMs: 0
                }
            },
            content: {
                profile: null,
                isProfileContentReady: false
            }
        },
        constants: {
            WDPR_PROFILE_LOG_MESSAGE_PREFIX: 'WDPR_PROFILE_NAV_',
            BASE_URL_PARSE_TARGET: '{{baseUrl}}',
            LOCALE_CODE_COOKIE_NAME: 'localeCookie_jar_aka',
            travelAgent: {
                TRAVEL_AGENT_AUTHORIZATION_COOKIE_NAME: 'Travel-Agent-Authorization',
                TRAVEL_AGENT_SESSION_TIME_COOKIE_NAME: 'Travel-Agent-Session-Time',
                TRAVEL_AGENT_TICKET_DATA_COOKIE_NAME: 'TICKET_DATA_jar',
                DEFAULT_TRAVEL_AGENT_GUEST_PROFILE: {
                    swid: null,
                    xid: null,
                    isSwidDetected: false,
                    isXidDetected: false,
                    isSwidProcessingComplete: false,
                    isGuestAffiliationsReady: false,
                    isProfileDataReady: false,
                    affiliationInfo: {
                        isFloridaResident: false,
                        isMilitary: false,
                        affiliations: []
                    },
                    profileData: null
                },
            },
            brandCodes: {
                WDW: 'WDW',
                DLR: 'DLR',
                DCL: 'DCL',
                HH: 'HH',
                VB: 'VB',
                DVC: 'DVC',
                AUL: 'AUL',
                PD: 'PD',
                DGC: 'DGC',
                NA: 'NA'
            },
            DEFAULT_LOCALE_CODE: 'en-US',
            INTERVAL_DETECTION_MODULUS_FREQUENCY: 100,
            CONTENT: {
                LOCALE_CODE_PARSE_TARGET: '{localeCode}',
                ENDPOINT_PATH: '/profile-api/content/{localeCode}/profile-spa/?condensed=true'
            }
        },
        init: async function(baseUrlParameter) {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'MAIN_INIT_';
            const REPORT_PERFORMANCE = wdprProfileNav.main.model.reporting.performance;
            if (REPORT_PERFORMANCE.appInitStartTimeMs === 0) {
                REPORT_PERFORMANCE.appInitStartTimeMs = Date.now();
            }
            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Checking DOM ready state to initialize wdprProfileNav app...');
            if (document.readyState !== 'loading') {
                let isInitProcessingErrorDetected = false;
                wdprProfileNav.main.model.reporting.performance.appInitStartTimeAfterDomReadyMs = Date.now();
                try {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> DOM ready state is \"' + document.readyState +
                        '\" so initialize wdprProfileNav app...');
                    if (baseUrlParameter) {
                        wdprProfileNav.main.model.baseUrl = baseUrlParameter;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> wdprProfileNav.main.model.baseUrl set with the following ' +
                            'value \"' + wdprProfileNav.main.model.baseUrl + '\"');
                    } else {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> baseUrlParameter NOT detected and thus ' +
                            'wdprProfileNav.main.model.baseUrl set with the following value \"' +
                            wdprProfileNav.main.model.baseUrl + '\"');
                    }
                    wdprProfileNav.main.utils.isMobileDevice();
                    wdprProfileNav.main.detectBrandCode();
                    wdprProfileNav.main.detectLocale();
                    wdprProfileNav.main.detectTravelAgentContext();
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Detecting brand code complete. Brand code detected as \"' + wdprProfileNav.main.model.brandCode + '\"');
                    await wdprProfileNav.features.ewcs.controller.init();
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> EWCS controller init complete. EWCS controller initialized.');
                    await wdprProfileNav.features.guestIdentity.controller.init();
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Guest identity controller init complete. Guest identity controller initialized.');
                    await wdprProfileNav.main.initComplete();
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> wdprProfileNav init complete! :-)');
                } catch (error) {
                    isInitProcessingErrorDetected = true;
                    if (error instanceof SyntaxError) {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Syntax error:', error.message);
                    } else if (error instanceof TypeError) {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Type error:', error.message);
                    } else if (error instanceof ReferenceError) {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Reference error:', error.message);
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unknown error:', error.message);
                    }
                } finally {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Completed init method processing.' +
                        '\n\tisInitProcessingErrorDetected value -> ' + isInitProcessingErrorDetected);
                }
            } else {
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> DOM is not yet ready so will retry once DOM is ready.' +
                    '\n\tAdding event listener for \'DOMContentLoaded\' event. :-)');
                window.document.addEventListener('DOMContentLoaded', wdprProfileNav.main.init);
            }
        },
        initComplete: async function() {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'MAIN_INIT_COMPLETE_';
            const REPORT_PERFORMANCE = wdprProfileNav.main.model.reporting.performance;
            REPORT_PERFORMANCE.appInitEndTimeMs = Date.now();
            let processTimeForFullAppInitAfterDomReadyMs = REPORT_PERFORMANCE.appInitEndTimeMs -
                REPORT_PERFORMANCE.appInitStartTimeAfterDomReadyMs;
            let processTimeForFullAppInitBeforeDomReadyMs = REPORT_PERFORMANCE.appInitEndTimeMs - REPORT_PERFORMANCE.appInitStartTimeMs;
            REPORT_PERFORMANCE.processTimeForFullAppInitAfterDomReadyMs = processTimeForFullAppInitAfterDomReadyMs;
            REPORT_PERFORMANCE.processTimeForFullAppInitBeforeDomReadyMs = processTimeForFullAppInitBeforeDomReadyMs;
            console.log(LOG_MESSAGE_PREFIX + 'INFO -> wdprProfileNav init complete with the following performance metrics ->',
                '\n\tDetected Brand Code -> ' + wdprProfileNav.main.model.brandCode +
                '\n\tPerformance Info ->\n' + JSON.stringify(REPORT_PERFORMANCE));
            if (wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.isEnterpriseWideConsentSyncEnabled === 'true') {
                const EWCS_MODEL_ONETRUST = wdprProfileNav.features.ewcs.model.oneTrust;
                const EWCS_MODEL_GUEST_INFO = wdprProfileNav.features.ewcs.model.guestInfo;
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> wdprProfileNav init complete with EWCS feature enabled.',
                    '\n\tEWCS Brand Code -> ' + wdprProfileNav.main.model.brandCode +
                    '\n\tEWCS OneTrust Info ->\n' + JSON.stringify(EWCS_MODEL_ONETRUST) +
                    '\n\tEWCS Guest Info ->\n' + JSON.stringify(EWCS_MODEL_GUEST_INFO));
            } else {
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> wdprProfileNav init complete with EWCS feature NOT enabled');
            }
            await wdprProfileNav.main.initContent();
            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content initialization complete! :-)');
        },
        initContent: async function() {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'MAIN_INIT_CONTENT_';
            const LOCALE_MODEL = wdprProfileNav.main.model.locale;
            const LOCALE_CODE = LOCALE_MODEL.currentSelectedLocaleCode;
            const PROFILE_CONTENT = await wdprProfileNav.main.getProfileContentFromContentEndpoint(LOCALE_CODE);
            if (PROFILE_CONTENT) {
                wdprProfileNav.main.model.content.profile = PROFILE_CONTENT;
                wdprProfileNav.main.model.content.isProfileContentReady = true;
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Profile content successfully retrieved from content endpoint! :-)');
            } else {
                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect profile content as the profile content is not ' +
                    'a valid object. :-(');
            }
        },
        detectProfileContentReady: async function() {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 
                'MAIN_DETECT_PROFILE_CONTENT_READY_';
            const CONTENT_MODEL = wdprProfileNav.main.model.content;
            const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS =
            wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalFrequencyMs;
            const PEP_PROFILE_CONTENT_DETECTOR_INTERVAL_MAX_ATTEMPTS =
            wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalMaxAttempts;
            if (CONTENT_MODEL.isProfileContentReady) {
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Profile content is ready! :-)');
            } else {
                let observerProfileContentReadyDetectionAttemptCount = 0;
                while (observerProfileContentReadyDetectionAttemptCount <= PEP_PROFILE_CONTENT_DETECTOR_INTERVAL_MAX_ATTEMPTS) {
                    observerProfileContentReadyDetectionAttemptCount = observerProfileContentReadyDetectionAttemptCount + 1;
                    if (CONTENT_MODEL.isProfileContentReady) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Profile content is ready! :-)');
                        break;
                    }
                }
                if (!CONTENT_MODEL.isProfileContentReady) {
                    observerProfileContentReadyDetectionAttemptCount = observerProfileContentReadyDetectionAttemptCount - 1;
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Profile content is not ready and failed to load in a ' +
                        'timely manner. :-(');
                }
            }
        },
        detectBrandCode: function() {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'MAIN_DETECT_BRAND_CODE_';
            let brandCode = null;
            if (window.location.hostname.includes('disneyland')) {
                brandCode = wdprProfileNav.main.constants.brandCodes.DLR;
            } else if (window.location.hostname.includes('disneyworld')) {
                brandCode = wdprProfileNav.main.constants.brandCodes.WDW;
            } else if (window.location.hostname.includes('disneycruise')) {
                brandCode = wdprProfileNav.main.constants.brandCodes.DCL;
            } else if (window.location.hostname.includes('hiltonhead')) {
                brandCode = wdprProfileNav.main.constants.brandCodes.HH;
            } else if (window.location.hostname.includes('verobeach')) {
                brandCode = wdprProfileNav.main.constants.brandCodes.VB;
            } else if (window.location.hostname.includes('disneyaulani')) {
                brandCode = wdprProfileNav.main.constants.brandCodes.AUL;
            } else if ((window.location.hostname.includes('dvc-lightcycle')) || 
                (window.location.hostname.includes('disneyvacationclub'))) {
                brandCode = wdprProfileNav.main.constants.brandCodes.DVC;
            } else if (window.location.hostname.includes('plandisney')) {
                brandCode = wdprProfileNav.main.constants.brandCodes.PD;
            } else if (window.location.hostname.includes('disneygiftcard')) {
                brandCode = wdprProfileNav.main.constants.brandCodes.DGC;
            } else {
                brandCode = wdprProfileNav.main.constants.brandCodes.NA;
            }
            wdprProfileNav.main.model.brandCode = brandCode;
            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Brand code detected as \"' + brandCode + '\"');
        },
        detectLocale: function() {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'MAIN_DETECT_LOCALE_';
            const LOCALE_CODE_COOKIE_NAME = wdprProfileNav.main.constants.LOCALE_CODE_COOKIE_NAME;
            const UTILS = wdprProfileNav.main.utils;
            const DEFAULT_LOCALE_CODE = wdprProfileNav.main.constants.DEFAULT_LOCALE_CODE;
            const LOCALE_MODEL = wdprProfileNav.main.model.locale;
            const LOCALE_COOKIE_DATA = UTILS.getCookieData(LOCALE_CODE_COOKIE_NAME);
            if (UTILS.isValidString(LOCALE_COOKIE_DATA)) {
                const DECODED_LOCALE_COOKIE_DATA = UTILS.decodeUrlEncodedString(LOCALE_COOKIE_DATA);
                if (UTILS.isJSONAndNotEmpty(DECODED_LOCALE_COOKIE_DATA)) {
                    const LOCALE_COOKIE_DATA_JSON = JSON.parse(DECODED_LOCALE_COOKIE_DATA);
                    LOCALE_MODEL.currentSelectedLocaleCookieData = LOCALE_COOKIE_DATA_JSON;
                    if (UTILS.isValidString(LOCALE_MODEL.currentSelectedLocaleCookieData.contentLocale)) {
                        LOCALE_MODEL.currentSelectedLocaleCode = LOCALE_MODEL.currentSelectedLocaleCookieData.contentLocale;
                        if (LOCALE_MODEL.currentSelectedLocaleCode.includes('_')) {
                            LOCALE_MODEL.currentSelectedLocaleCode = LOCALE_MODEL.currentSelectedLocaleCode.replace('_', '-');
                        }
                        LOCALE_MODEL.currentSelectedLocaleCode = LOCALE_MODEL.currentSelectedLocaleCode.toLowerCase();
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Locale code detected as \"' + LOCALE_MODEL.currentSelectedLocaleCode + '\"');
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect locale code as the cookie data is not a valid string.');
                    }
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect locale code as the cookie data is not a valid JSON.');
                }
            } else {
                console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect locale code as the cookie data is not a valid string so setting ' +
                    'the current selected locale code to the default en-US.');
            }
            if (!LOCALE_MODEL.currentSelectedLocaleCode) {
                console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect locale code as the current selected locale code is not a valid string so ' +
                    'setting the current selected locale code to the default en-US.');
                LOCALE_MODEL.currentSelectedLocaleCode = DEFAULT_LOCALE_CODE;
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Current selected locale code set default value to \"' + LOCALE_MODEL.currentSelectedLocaleCode + '\"');
            } else {
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Current selected locale code detected as \"' + LOCALE_MODEL.currentSelectedLocaleCode + '\"');
            }
        },
        detectTravelAgentContext: function() {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'MAIN_DETECT_TRAVEL_AGENT_CONTEXT_';
            const UTILS = wdprProfileNav.main.utils;
            const TRAVEL_AGENT_MODEL = wdprProfileNav.main.model.travelAgent;
            const TRAVEL_AGENT_AUTHORIZATION_COOKIE_NAME = wdprProfileNav.main.constants.travelAgent.TRAVEL_AGENT_AUTHORIZATION_COOKIE_NAME;
            const TRAVEL_AGENT_SESSION_TIME_COOKIE_NAME = wdprProfileNav.main.constants.travelAgent.TRAVEL_AGENT_SESSION_TIME_COOKIE_NAME;
            const TRAVEL_AGENT_TICKET_DATA_COOKIE_NAME = wdprProfileNav.main.constants.travelAgent.TRAVEL_AGENT_TICKET_DATA_COOKIE_NAME;
            const TRAVEL_AGENT_AUTHORIZATION_COOKIE_DATA = UTILS.getCookieData(TRAVEL_AGENT_AUTHORIZATION_COOKIE_NAME);
            const TRAVEL_AGENT_SESSION_TIME_COOKIE_DATA = UTILS.getCookieData(TRAVEL_AGENT_SESSION_TIME_COOKIE_NAME);
            const TRAVEL_AGENT_TICKET_DATA_COOKIE_DATA = UTILS.getCookieData(TRAVEL_AGENT_TICKET_DATA_COOKIE_NAME);
            if (UTILS.isStringAndNotEmpty(TRAVEL_AGENT_AUTHORIZATION_COOKIE_DATA)) {
                TRAVEL_AGENT_MODEL.authorization = TRAVEL_AGENT_AUTHORIZATION_COOKIE_DATA;
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent authorization detected as \"' + TRAVEL_AGENT_MODEL.authorization + '\"');
                if (UTILS.isStringAndNotEmpty(TRAVEL_AGENT_SESSION_TIME_COOKIE_DATA)) {
                    TRAVEL_AGENT_MODEL.sessionTime = TRAVEL_AGENT_SESSION_TIME_COOKIE_DATA;
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent session time detected as \"' + TRAVEL_AGENT_MODEL.sessionTime + '\"');
                    if (UTILS.isStringAndNotEmpty(TRAVEL_AGENT_TICKET_DATA_COOKIE_DATA)) {
                        const DECODED_TRAVEL_AGENT_TICKET_DATA_COOKIE_DATA = UTILS.decodeUrlEncodedString(TRAVEL_AGENT_TICKET_DATA_COOKIE_DATA);
                        if (UTILS.isJSONAndNotEmpty(DECODED_TRAVEL_AGENT_TICKET_DATA_COOKIE_DATA)) {
                            const TRAVEL_AGENT_TICKET_DATA_COOKIE_DATA_JSON = JSON.parse(DECODED_TRAVEL_AGENT_TICKET_DATA_COOKIE_DATA);
                            TRAVEL_AGENT_MODEL.ticketData = TRAVEL_AGENT_TICKET_DATA_COOKIE_DATA_JSON; 
                            TRAVEL_AGENT_MODEL.isTravelAgentContextDetected = true;
                            TRAVEL_AGENT_MODEL.isTravelAgentDataReady = true;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent context detected. ' +
                                'isTravelAgentContextDetected value set to -> \"' + TRAVEL_AGENT_MODEL.isTravelAgentContextDetected + '\"');
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent model data detected as \"' + 
                                JSON.stringify(TRAVEL_AGENT_MODEL) + '\"');
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect travel agent ticket data as the cookie data is not a valid JSON.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect travel agent ticket data as the cookie data is not a valid string.');
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect travel agent session time as the cookie data is not a valid string.');
                }
            } else {
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Unable to detect travel agent authorization as the cookie data is not a valid string.');
            }
            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent model data detected as \"' + 
                JSON.stringify(TRAVEL_AGENT_MODEL) + '\"');
        },
        detectTravelAgentProcessingComplete: async function() {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                'MAIN_DETECT_TRAVEL_AGENT_PROCESSING_COMPLETE_';
            console.log(LOG_MESSAGE_PREFIX + ' -> Attempting to detect if the travel processing is complete...');
            const TRAVEL_AGENT_MODEL = wdprProfileNav.main.model.travelAgent;
            const UTILS = wdprProfileNav.main.utils;
            const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS =
                wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalFrequencyMs;
            const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS =
                wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalMaxAttempts;
            let observerTravelAgentProcessingCompleteDetectionAttemptCount = 0;
            while (observerTravelAgentProcessingCompleteDetectionAttemptCount 
                <= PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS) {
                observerTravelAgentProcessingCompleteDetectionAttemptCount =
                    observerTravelAgentProcessingCompleteDetectionAttemptCount + 1;
                if (!TRAVEL_AGENT_MODEL.guestProfile.isSwidDetected) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent has not specified a guest swid so no additional ' +
                        'data will be retrieved.');
                    break;
                } else if (TRAVEL_AGENT_MODEL.guestProfile.isSwidProcessingComplete) {
                    const TRAVEL_AGENT_GUEST_PROFILE = TRAVEL_AGENT_MODEL.guestProfile;
                    if (TRAVEL_AGENT_GUEST_PROFILE) {
                        const TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS = TRAVEL_AGENT_GUEST_PROFILE.affiliationInfo.affiliations;
                        if (TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Affiliations processing is complete. There are ' + 
                                TRAVEL_AGENT_GUEST_PROFILE_AFFILIATIONS.length + ' affiliations detected in the guest profile with the ' + 
                                'affiliations array.');
                            break;
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect travel agent guest profile affiliations ' +
                                'as the affiliations array not detected.');
                        }
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect travel agent guest profile as the guest ' +
                            'profile is not a valid object.');
                    }
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Travel agent related processing not detected as fully complete ' +
                        'in the browser window ' +
                        observerTravelAgentProcessingCompleteDetectionAttemptCount + ' of ' +
                        PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                        ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                        'Retrying detection...');
                    await UTILS.delay(PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS);
                }
            }
            if (!TRAVEL_AGENT_MODEL.isTravelAgentDataReady) {
                observerTravelAgentProcessingCompleteDetectionAttemptCount =
                observerTravelAgentProcessingCompleteDetectionAttemptCount - 1;
                console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect travel agent related processing as fully complete ' +
                    'with attempt count ' +
                    observerTravelAgentProcessingCompleteDetectionAttemptCount + ' of ' +
                    PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                    ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                    'Stopping further detection attempts.');
            } else {
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Travel agent related processing detected as fully complete with the ' + 
                    'following travel agent model data -> ' + JSON.stringify(TRAVEL_AGENT_MODEL));
            }
        },
        getContentEndpointUrl: function(localeCode) {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                'FEATURE_GUEST_IDENTITY_GET_CONTENT_ENDPOINT_URL_';
            const CONTENT_ENDPOINT_PATH = wdprProfileNav.main.constants.CONTENT.ENDPOINT_PATH;
            const LOCALE_CODE_PARSE_TARGET = wdprProfileNav.main.constants.CONTENT.LOCALE_CODE_PARSE_TARGET;
            const CONTENT_ENDPOINT_URL = CONTENT_ENDPOINT_PATH.replace(LOCALE_CODE_PARSE_TARGET, localeCode);
            console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content endpoint URL detected as \"' + CONTENT_ENDPOINT_URL + '\"');
            return CONTENT_ENDPOINT_URL;
        },
        getProfileContentFromContentEndpoint: async function(localeCode) {
            const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                'FEATURE_GUEST_IDENTITY_GET_PROFILE_CONTENT_FROM_CONTENT_ENDPOINT_';
            const UTILS = wdprProfileNav.main.utils;
            let profileContent = null;
            if (UTILS.isStringAndNotEmpty(localeCode)) {
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Locale code is valid. Getting profile content ' +
                    'from content endpoint...');
                const CONTENT_ENDPOINT_URL = wdprProfileNav.main.getContentEndpointUrl(localeCode);
                if (UTILS.isStringAndNotEmpty(CONTENT_ENDPOINT_URL)) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Content endpoint URL is valid. Getting profile ' +
                        'content from content endpoint...');
                    try {
                        const CONTENT_ENDPOINT_RESPONSE = await fetch(CONTENT_ENDPOINT_URL, {
                            method: 'GET',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });
                        if (CONTENT_ENDPOINT_RESPONSE.ok) {
                            const CONTENT_ENDPOINT_RESPONSE_JSON = await CONTENT_ENDPOINT_RESPONSE.json();
                            if (CONTENT_ENDPOINT_RESPONSE_JSON) {
                                profileContent = CONTENT_ENDPOINT_RESPONSE_JSON;
                                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Profile content successfully retrieved from content endpoint. :-)');
                            } else {
                                console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to get profile content from content endpoint as the ' +
                                    'content endpoint response is not a valid object.');
                            }
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> The content endpoint response is not an OK 200 status code.  ' +
                                'Unable to process the content endpoint response. Content endpoint URL is \"' + CONTENT_ENDPOINT_URL + 
                                '\" and the Content endpoint response status code -> ' + CONTENT_ENDPOINT_RESPONSE.status + 
                                ' and the Content endpoint response status text -> ' + CONTENT_ENDPOINT_RESPONSE.statusText);
                        }
                    } catch (error) {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to get profile content from content endpoint as the content ' +
                            'endpoint URL is not a valid string. Error message -> ' + error.message);
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to get profile content from content endpoint as the content ' + 
                        'endpoint URL is not a valid string.');
                }
            }
            return profileContent;
        },
        utils: {
            isMobileDevice: function() {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'MAIN_INIT_';
                let isMobileDevice = false;
                const MOBILE_DEVICE_USER_AGENTS = [
                    /Android/i,
                    /iPhone/i,
                    /iPad/i,
                    /iPod/i,
                    /webOS/i,
                ];
                isMobileDevice = MOBILE_DEVICE_USER_AGENTS.some(
                    mobileDeviceUserAgent => navigator.userAgent.match(mobileDeviceUserAgent));
                if (!isMobileDevice) {
                    let isIpadDetectediOS13AndAbove = /Macintosh/i.test(navigator.userAgent) &&
                            navigator.maxTouchPoints && navigator.maxTouchPoints > 1;
                    if (isIpadDetectediOS13AndAbove) {
                        isMobileDevice = true;
                    }
                }
                wdprProfileNav.main.model.isMobileDevice = isMobileDevice;
                if (isMobileDevice) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Mobile device detect. ' +
                        'isMobileDevice value set to -> \"' + wdprProfileNav.main.model.isMobileDevice + '\"');
                } else {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Mobile device not detected. ' +
                        'isMobileDevice value set to -> \"' + wdprProfileNav.main.model.isMobileDevice + '\"');
                }
                console.log(LOG_MESSAGE_PREFIX + 'navigator.userAgent -> ' + navigator.userAgent +
                    '\risMobileDevice -> ' + wdprProfileNav.main.model.isMobileDevice);
                return isMobileDevice;
            },
            getQueryParamValueByName: function(paramName) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'GET_QUERY_PARAM_';
                let queryParamValue = null;
                const urlSearchParams = new URLSearchParams(window.location.search);
                if (urlSearchParams && paramName) {
                    queryParamValue = urlSearchParams.get(paramName);
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Retrieved query param value for paramName \"' + paramName +
                        '\" with the following value -> \"' + queryParamValue + '\"');
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to retrieve query param value as ' +
                        'either urlSearchParams or paramName is null. ' +
                        'urlSearchParams -> ' + urlSearchParams +
                        '\rparamName -> ' + paramName);
                }
                return queryParamValue;
            },
            decodeJWT: function(token) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'DECODE_JWT_';
                let decodedJWT = null;
                if (typeof token !== "string") {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Invalid token: must be a string.');
                } else {
                    const parts = token.split(".");
                    if (parts.length !== 3) {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Invalid JWT format: must have 3 parts.');
                    } else {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> JWT token split into parts successfully with the following parts -> ' +
                            'Header: \"' + parts[0] + '\"' +
                            '\rPayload: \"' + parts[1] + '\"' +
                            '\rSignature: \"' + parts[2] + '\"');
                        decodedJWT = {
                            header: wdprProfileNav.main.utils.base64UrlDecode(parts[0]),
                            payload: wdprProfileNav.main.utils.base64UrlDecode(parts[1]),
                            signature: parts[2] // Signature is not decoded (binary data)
                        };
                        if (decodedJWT.header && decodedJWT.payload && decodedJWT.signature) {
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> JWT header and payload decoded successfully with the following values -> ' +
                                'Header: ' + JSON.stringify(decodedJWT.header) +
                                '\rPayload: ' + JSON.stringify(decodedJWT.payload));
                        } else {
                            decodedJWT = null; // Set decodedJWT to null if either header or payload failed to decode
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to decode JWT header or payload. ' +
                                'Decoded JWT object has the following value -> ' + JSON.stringify(decodedJWT));
                        }
                    }
                    return decodedJWT;
                }
            },
            base64UrlDecode: function (base64UrlEncodedString) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'BASE64URL_DECODE_';
                let decodedValue = null;
                try {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Decoding Base64URL string: \"' + base64UrlEncodedString + '\"');
                    // Replace URL-safe chars and pad with '='
                    const base64 = base64UrlEncodedString.replace(/-/g, "+").replace(/_/g, "/");
                    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=");
                    const decoded = atob(padded);
                    decodedValue = JSON.parse(decoded);
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully decoded Base64URL string. Decoded value: ' +
                        JSON.stringify(decodedValue));
                } catch (error) {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to decode Base64URL: ' + error.message);
                }
                return decodedValue;
            },
            decodeUrlEncodedString: function(urlEncodedString) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'DECODE_URL_ENCODED_STRING_';
                let decodedValue = null;
                try {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Decoding URL encoded string: \"' + urlEncodedString + '\"');
                    decodedValue = decodeURIComponent(urlEncodedString);
                } catch (error) {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to decode URL encoded string: ' + error.message);
                }
                return decodedValue;
            },
            isValidString: function(testObject) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'IS_VALID_STRING_';
                let isValidString = false;
                if (typeof testObject === 'string') {
                    isValidString = true;
                }
                return isValidString;
            },
            isStringAndNotEmpty: function(testObject) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'IS_STRING_AND_NOT_EMPTY_';
                let isStringAndNotEmpty = false;
                if (wdprProfileNav.main.utils.isValidString(testObject)) {
                    if (testObject.length > 0) {
                        testObject = testObject.trim();
                        if (testObject.length > 0) {
                            isStringAndNotEmpty = true;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> testObject is a valid string with the following value -> ' +
                                testObject);
                        } else {
                            console.warn(LOG_MESSAGE_PREFIX + 'WARN -> testObject is an empty string');
                        }
                    }
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> testObject is not a string');
                }
                return isStringAndNotEmpty;
            },
            isJSONAndNotEmpty: function(testObject) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'IS_JSON_AND_NOT_EMPTY_';
                let isJSONAndNotEmpty = false;
                if (wdprProfileNav.main.utils.isValidString(testObject)) {
                    try {
                        const parsedObject = JSON.parse(testObject);
                        if (Object.keys(parsedObject).length > 0) {
                            isJSONAndNotEmpty = true;
                            console.log(LOG_MESSAGE_PREFIX + 'INFO -> testObject is a valid JSON with the following value -> ' +
                                JSON.stringify(parsedObject));
                        } else {
                            console.error(LOG_MESSAGE_PREFIX + 'ERROR -> testObject is a valid JSON but is empty');
                        }
                    } catch (error) {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Failed to parse testObject as JSON: ' + error.message);
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> testObject is not a valid string');
                }
                return isJSONAndNotEmpty;
            },
            getDomElementByName: function(targetName) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'GET_DOM_ELEMENT_BY_NAME_';
                let isValidTargetName = false;
                let matchingDomElement = null;
                if (targetName) {
                    if (wdprProfileNav.main.utils.isStringAndNotEmpty(targetName)) {
                        isValidTargetName = true;
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> targetName is not a valid string');
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> targetName is undefined or null');
                }
                if (isValidTargetName) {
                    // Use querySelectorAll to select all elements with a 'name' attribute
                    const DOM_ELEMENTS_WITH_NAME_ARRAY = document.querySelectorAll('[name]');
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Attempting to detect DOM element with the following name -> ' + targetName);
                    for (let i = 0; i < DOM_ELEMENTS_WITH_NAME_ARRAY.length; i++) {
                        if (DOM_ELEMENTS_WITH_NAME_ARRAY[i].name === targetName) {
                            matchingDomElement = DOM_ELEMENTS_WITH_NAME_ARRAY[i];
                        }
                    }
                    if (matchingDomElement) {
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully detected DOM element with the following name -> ' + targetName);
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect DOM element with the following name -> ' + targetName);
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect DOM element as the input targetName is not valid.');
                }
                return matchingDomElement;
            },
            getDomElementChildByHrefValue: function(containerClassName, hrefValue) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'GET_DOM_ELEMENT_CHILD_BY_NAME_';
                let isValidHrefValue = false;
                let isValidContainerClassName = false;
                let matchingDomElement = null;
                if (hrefValue) {
                    if (wdprProfileNav.main.utils.isStringAndNotEmpty(hrefValue)) {
                        isValidHrefValue = true;
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> targetName is not a valid string');
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> targetName is undefined or null');
                }
                if (containerClassName) {
                    if (wdprProfileNav.main.utils.isStringAndNotEmpty(containerClassName)) {
                        isValidContainerClassName = true;
                    } else {
                        console.error(LOG_MESSAGE_PREFIX + 'ERROR -> containerClassName is not a valid string');
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> containerClassName is undefined or null');
                }
                if (isValidContainerClassName && isValidHrefValue) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Attempting to detect DOM element with the following hrefValue -> ' + hrefValue);
                    // Step 1: Find all elements with the specified CSS class name
                    const DOM_ELEMENTS_WITH_A_CLASS_NAME_ARRAY = document.querySelectorAll(`.${containerClassName}`);
                    // Step 2: Iterate through each container to find the matching child
                    for (let i = 0; i < DOM_ELEMENTS_WITH_A_CLASS_NAME_ARRAY.length; i++) {
                        const CONTAINER_DOM_ELEMENT = DOM_ELEMENTS_WITH_A_CLASS_NAME_ARRAY[i];
                        // Find all elements within this container that have a 'name' attribute
                        const CHILD_DOM_ELEMENTS_WITH_NAME_ARRAY = CONTAINER_DOM_ELEMENT.querySelectorAll('[name]');
                        // Check each child to see if its name matches the target exactly
                        for (let j = 0; j < CHILD_DOM_ELEMENTS_WITH_NAME_ARRAY.length; j++) {
                            const CHILD_DOM_ELEMENT_WITH_A_NAME = CHILD_DOM_ELEMENTS_WITH_NAME_ARRAY[j];
                            // Use strict equality to handle special characters (&, =, /) correctly
                            if (CHILD_DOM_ELEMENT_WITH_A_NAME.name === hrefValue) {
                                matchingDomElement = CHILD_DOM_ELEMENT_WITH_A_NAME;
                            }
                        }
                    }
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to to detect DOM element as the input parameters are not valid.');
                }
                if (matchingDomElement) {
                    console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully detected DOM element with the following hrefValue -> ' + hrefValue);
                } else {
                    console.error(LOG_MESSAGE_PREFIX + 'ERROR -> Unable to detect DOM element with the following hrefValue -> ' + hrefValue);
                }
                return matchingDomElement;
            },
            detectDomElementById: async function(id) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'UTILS_DETECT_DOM_ELEMENT_BY_ID_';
                console.log(LOG_MESSAGE_PREFIX + ' -> Attempting to detect if the DOM element with id -> ' + id + 
                    ' is present in the DOM...');
                const UTILS = wdprProfileNav.main.utils;
                const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS =
                    wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalFrequencyMs;
                const PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS =
                    wdprProfileNav.config.features.enterpriseWideConsentSyncConfig.pepProfileAuthDetectorIntervalMaxAttempts;
                let observerDomElementDetectionAttemptCount = 0;
                let matchingDomElement = null;
                while (observerDomElementDetectionAttemptCount 
                    <= PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS) {
                    observerDomElementDetectionAttemptCount =
                        observerDomElementDetectionAttemptCount + 1;
                    const DOM_ELEMENT_WITH_ID = document.getElementById(id);
                    if (DOM_ELEMENT_WITH_ID) {
                        matchingDomElement = DOM_ELEMENT_WITH_ID;
                        console.log(LOG_MESSAGE_PREFIX + 'INFO -> Successfully detected DOM element with id -> ' + id);
                        break;
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> The DOM element with id -> ' + id + ' not detected ' +
                            'in the browser window ' +
                            observerDomElementDetectionAttemptCount + ' of ' +
                            PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                            ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                            'Retrying detection...');
                        await UTILS.delay(PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS);
                    }
                }
                if (!matchingDomElement) {
                    observerDomElementDetectionAttemptCount =
                    observerDomElementDetectionAttemptCount - 1;
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect the DOM element with id -> ' + id + ' ' +
                        'with attempt count ' +
                        observerDomElementDetectionAttemptCount + ' of ' +
                        PEP_PROFILE_AUTH_DETECTOR_INTERVAL_MAX_ATTEMPTS +
                        ' with a frequency of ' + PEP_PROFILE_AUTH_DETECTOR_INTERVAL_FREQUENCY_MS + 'ms. ' +
                        'Stopping further detection attempts.');
                }
                return matchingDomElement;
            },
            dispatchEvent: function(event, eventName) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'DISPATCH_EVENT_';
                window.dispatchEvent(event);
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> ' + eventName + ' successfully dispatched to the window! :-)');
            },
            delay: async function(msTime) {
                return new Promise(resolve => setTimeout(resolve, msTime));
            },
            getCookieData: function(cookieName) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'GET_COOKIE_DATA_';
                let detectedCookieData = null;
                const COOKIE_DATA = document.cookie.split('; ').find(row => row.startsWith(cookieName + '='));
                if (COOKIE_DATA) {
                    detectedCookieData = COOKIE_DATA.split('=')[1];
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to detect cookie data with the following name -> ' +
                        cookieName + ' in the document cookie. Returning null.');
                }
                return detectedCookieData;
            },
            generateCodeVerifier: function(length) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX + 'GENERATE_CODE_VERIFIER_';
                const CODE_VERIFIER_LENGTH = length || 128;
                const CHARSET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';
                const randomValues = new Uint8Array(CODE_VERIFIER_LENGTH);
                crypto.getRandomValues(randomValues);
                let codeVerifier = '';
                for (let i = 0; i < CODE_VERIFIER_LENGTH; i++) {
                    codeVerifier += CHARSET[randomValues[i] % CHARSET.length];
                }
                console.log(LOG_MESSAGE_PREFIX + 'INFO -> Generated code verifier with length -> ' + codeVerifier.length);
                return codeVerifier;
            },
            sha256: async function(value) {
                const encoder = new TextEncoder();
                const data = encoder.encode(value);
                return crypto.subtle.digest('SHA-256', data); // ArrayBuffer
            },
            base64UrlEncodeBytes: function(arrayBuffer) {
                const bytes = new Uint8Array(arrayBuffer);
                let binary = '';
                for (let i = 0; i < bytes.length; i++) {
                    binary += String.fromCharCode(bytes[i]);
                }
                return btoa(binary)
                    .replace(/\+/g, '-')
                    .replace(/\//g, '_')
                    .replace(/=+$/, '');
            },
            getOrdinalDaySuffix: function(dayNumber) {
                let ordinalDaySuffix = null;
                const DAY_NUMBER = Number(dayNumber);
                if (Number.isInteger(DAY_NUMBER) && DAY_NUMBER >= 1 && DAY_NUMBER <= 31) {
                    const LAST_DIGIT = DAY_NUMBER % 10;
                    const LAST_TWO_DIGITS = DAY_NUMBER % 100;
                    if (LAST_TWO_DIGITS >= 11 && LAST_TWO_DIGITS <= 13) {
                        ordinalDaySuffix = 'th';
                    } else if (LAST_DIGIT === 1) {
                        ordinalDaySuffix = 'st';
                    } else if (LAST_DIGIT === 2) {
                        ordinalDaySuffix = 'nd';
                    } else if (LAST_DIGIT === 3) {
                        ordinalDaySuffix = 'rd';
                    } else {
                        ordinalDaySuffix = 'th';
                    }
                }
                return ordinalDaySuffix;
            },
            formatIso8601DateToLongOrdinalDate: function(iso8601DateString) {
                const LOG_MESSAGE_PREFIX = wdprProfileNav.main.constants.WDPR_PROFILE_LOG_MESSAGE_PREFIX +
                    'FORMAT_ISO8601_DATE_TO_LONG_ORDINAL_DATE_';
                const UTILS = wdprProfileNav.main.utils;
                let formattedDate = null;
                if (UTILS.isStringAndNotEmpty(iso8601DateString)) {
                    const PARSED_DATE = new Date(iso8601DateString);
                    if (!Number.isNaN(PARSED_DATE.getTime())) {
                        const DAY = PARSED_DATE.getUTCDate();
                        const YEAR = PARSED_DATE.getUTCFullYear();
                        const MONTH_NAME = PARSED_DATE.toLocaleDateString('en-US', { month: 'long', timeZone: 'UTC' });
                        const ORDINAL_SUFFIX = UTILS.getOrdinalDaySuffix(DAY);
                        if (ORDINAL_SUFFIX) {
                            formattedDate = MONTH_NAME + ' ' + DAY + ORDINAL_SUFFIX + ', ' + YEAR;
                        }
                    } else {
                        console.warn(LOG_MESSAGE_PREFIX + 'WARN -> Unable to parse iso8601DateString as a valid date.');
                    }
                } else {
                    console.warn(LOG_MESSAGE_PREFIX + 'WARN -> iso8601DateString is not a valid non-empty string.');
                }
                return formattedDate;
            },
        },
        logger: {
            model: {
                logLevel: 'INFO',
                logMessagePrefix: 'WDPR_PROFILE_LOG_MESSAGE_PREFIX'
            },
            utils: {
                createLogData: function(messagePrefixParam, messageParam, objectParam, errorParam) {
                    const UTILS = wdprProfileNav.main.utils;
                    const LOGGER_MODEL = wdprProfileNav.main.logger.model;
                    const LOG_DATA = {
                        messagePrefix: LOGGER_MODEL.logMessagePrefix,
                        message: null,
                        object: null,
                        error: logError = null
                    };
                    if (UTILS.isStringAndNotEmpty(messagePrefixParam)) {
                        LOG_DATA.messagePrefix = messagePrefixParam;
                    }
                    if (UTILS.isStringAndNotEmpty(messageParam)) {
                        LOG_DATA.message = messageParam;
                    }
                    if (objectParam) {
                        LOG_DATA.object = objectParam;
                    }
                    if (errorParam) {
                        if (errorParam instanceof Error) {
                            LOG_DATA.error = errorParam;
                        }
                    }
                }
            },
            debug: function(logMessagePrefixParam, logMessageParam, logObjectParam, logErrorParam) {
                const LOGGER = wdprProfileNav.main.utils.logger;
                const LOG_DATA = LOGGER.createLogData(logMessagePrefixParam, logMessageParam, logObjectParam, logErrorParam);
                const LOG_DATA_JSON_STRING = JSON.stringify(LOG_DATA);
                console.debug(LOG_DATA_JSON_STRING);
            },
            info: function(logMessagePrefix, logMessage, object, error) {
                const LOG_DATA = LOGGER.createLogData(logMessagePrefixParam, logMessageParam, logObjectParam, logErrorParam);
                const LOG_DATA_JSON_STRING = JSON.stringify(LOG_DATA);
                console.log(LOG_DATA_JSON_STRING);
            },
            warn: function(logMessagePrefix, logMessage, object, error) {
                const LOG_DATA = LOGGER.createLogData(logMessagePrefixParam, logMessageParam, logObjectParam, logErrorParam);
                const LOG_DATA_JSON_STRING = JSON.stringify(LOG_DATA);
                console.warn(LOG_DATA_JSON_STRING);
            },
            error: function(logMessagePrefix, logMessage, object, error) {
                const LOG_DATA = LOGGER.createLogData(logMessagePrefixParam, logMessageParam, logObjectParam, logErrorParam);
                const LOG_DATA_JSON_STRING = JSON.stringify(LOG_DATA);
                console.error(LOG_DATA_JSON_STRING);
            },
            remote: {
                debug: function(logMessagePrefixParam, logMessageParam, logObjectParam, logErrorParam) {
                },
                info: function(logMessagePrefix, logMessage, object, error) {
                },
                warn: function(logMessagePrefix, logMessage, object, error) {
                },
                error: function(logMessagePrefix, logMessage, object, error) {
                },
            }
        }
    },
